          have hb : LOWb.card ≤ 3 := by
            refine no_four_in_window n A' D LOWb 54 (4*d + 6) hfree hodd
              (by omega) (by omega) ?_
            intro x hx
            obtain ⟨hxLOW, hxgt⟩ := Finset.mem_filter.mp hx
            obtain ⟨hxA, hxe, hx2, hxub⟩ := hLOWfacts x hxLOW
            refine ⟨hxA, hxe, ?_, hxub⟩
            rcases hgap1 x hxLOW with h | h
            · omega
            · omega
          have : LOW.card ≤ 5 := by omega
          exact_mod_cast this
        -- Next, `T ≥ d - 1` gives `t ≥ 2n - 2d - 10 ≥ 208 - 2d`.
        have hT2 : d - 1 ≤ (TOP.card : ℤ) := by omega
        have ht2 : 208 - 2*d ≤ t := by omega
        rcases le_or_gt d 19 with hd19 | hd20
        · -- If `d ≤ 19`, every element of `LOW` is at most `4`.
          have hgap2 : ∀ x ∈ LOW, x ≤ 4 := by
            intro x hx
            obtain ⟨hxA, hxe, hx2, hxub⟩ := hLOWfacts x hx
            by_contra hcon
            push_neg at hcon
            have hb := odd_pair_bound n A' D hfree hodd x t (by omega) (by omega) htub
              hxe hte hxA htA
            rw [← hdz] at hb
            exact excl_arith_narrow x t d (by omega) (by omega) hd19 ht2 hb
          have hL2 : (LOW.card : ℤ) ≤ 2 := by
            have hsub : LOW ⊆ ({2, 4} : Finset ℤ) := by
              intro x hx
              obtain ⟨-, hxe, hx2, -⟩ := hLOWfacts x hx
              have hx4 := hgap2 x hx
              have : x = 2 ∨ x = 4 := by omega
              simpa using this
            have : LOW.card ≤ 2 :=
