/-! ### At most three even elements in a short interval -/

/-- Under the stated bounds, at most three even elements of `A` lie in
`[lo, hi]` when `hi < 3lo + 4`. -/
theorem no_four_in_window (n : ℕ) (A D S : Finset ℤ) (lo hi : ℤ)
    (hfree : ¬ HasPosPairwiseSums A 4)
    (hodd : ∀ x : ℤ, 1 ≤ x → x ≤ 2*(n:ℤ) → x % 2 = 1 → x ∉ D → x ∈ A)
    (hwin : hi < 3*lo + 4)
    (hcap : 2*hi - lo + 12*(D.card:ℤ) + 4 ≤ 4*(n:ℤ))
    (hS : ∀ x ∈ S, x ∈ A ∧ x % 2 = 0 ∧ lo ≤ x ∧ x ≤ hi) :
    S.card ≤ 3 := by
  classical
  by_contra hbig
  push_neg at hbig
  have htf : ∀ u ∈ S, ∀ v ∈ S, ∀ w ∈ S, u < v → v < w → u + v ≤ w := by
    intro u hu v hv w hw huv hvw
    by_contra hgt
    push_neg at hgt
    obtain ⟨huA, hue, hulb, huub⟩ := hS u hu
    obtain ⟨hvA, hve, hvlb, hvub⟩ := hS v hv
    obtain ⟨hwA, hwe, hwlb, hwub⟩ := hS w hw
    set g1 : ℤ := u / 2 with hg1
    set g2 : ℤ := v / 2 with hg2
    set g3 : ℤ := w / 2 with hg3
    have hu2 : 2 * g1 = u := by omega
    have hv2 : 2 * g2 = v := by omega
    have hw2 : 2 * g3 = w := by omega
    refine T_star n A D hfree hodd (g1+g2-g3) (g1+g3-g2) (g2+g3-g1)
      (by omega) (by omega) (by omega) (by omega) (by omega) ?_ ?_ ?_ (by omega)
    · have h : (g1+g2-g3) + (g1+g3-g2) = 2*g1 := by ring
      rw [h, hu2]; exact huA
    · have h : (g1+g2-g3) + (g2+g3-g1) = 2*g2 := by ring
      rw [h, hv2]; exact hvA
    · have h : (g1+g3-g2) + (g2+g3-g1) = 2*g3 := by ring
      rw [h, hw2]; exact hwA
  have hne1 : S.Nonempty := Finset.card_pos.mp (by omega)
  set M1 : ℤ := S.max' hne1 with hM1def
  have hM1S : M1 ∈ S := S.max'_mem hne1
  set S1 : Finset ℤ := S.erase M1 with hS1def
  have hc1 : S1.card = S.card - 1 := Finset.card_erase_of_mem hM1S
  have hne2 : S1.Nonempty := Finset.card_pos.mp (by omega)
  set M2 : ℤ := S1.max' hne2 with hM2def
  have hM2S1 : M2 ∈ S1 := S1.max'_mem hne2
  have hM2S : M2 ∈ S := Finset.mem_of_mem_erase hM2S1
  have hM21 : M2 < M1 :=
    lt_of_le_of_ne (S.le_max' M2 hM2S) (Finset.ne_of_mem_erase hM2S1)
  set S2 : Finset ℤ := S1.erase M2 with hS2def
  have hc2 : S2.card = S1.card - 1 := Finset.card_erase_of_mem hM2S1
  have hne3 : S2.Nonempty := Finset.card_pos.mp (by omega)
  set M3 : ℤ := S2.max' hne3 with hM3def
  have hM3S2 : M3 ∈ S2 := S2.max'_mem hne3
  have hM3S1 : M3 ∈ S1 := Finset.mem_of_mem_erase hM3S2
  have hM3S : M3 ∈ S := Finset.mem_of_mem_erase hM3S1
  have hM32 : M3 < M2 :=
    lt_of_le_of_ne (S1.le_max' M3 hM3S1) (Finset.ne_of_mem_erase hM3S2)
  set S3 : Finset ℤ := S2.erase M3 with hS3def
  have hc3 : S3.card = S2.card - 1 := Finset.card_erase_of_mem hM3S2
  have hne4 : S3.Nonempty := Finset.card_pos.mp (by omega)
  set M4 : ℤ := S3.max' hne4 with hM4def
  have hM4S3 : M4 ∈ S3 := S3.max'_mem hne4
  have hM4S2 : M4 ∈ S2 := Finset.mem_of_mem_erase hM4S3
  have hM4S1 : M4 ∈ S1 := Finset.mem_of_mem_erase hM4S2
  have hM4S : M4 ∈ S := Finset.mem_of_mem_erase hM4S1
  have hM43 : M4 < M3 :=
    lt_of_le_of_ne (S2.le_max' M4 hM4S2) (Finset.ne_of_mem_erase hM4S3)
  have hchain1 : M4 + M3 ≤ M2 := htf M4 hM4S M3 hM3S M2 hM2S hM43 hM32
  have hchain2 : M3 + M2 ≤ M1 := htf M3 hM3S M2 hM2S M1 hM1S hM32 hM21
  obtain ⟨-, h4e, h4lo, -⟩ := hS M4 hM4S
  obtain ⟨-, h3e, -, -⟩ := hS M3 hM3S
  obtain ⟨-, -, -, h1hi⟩ := hS M1 hM1S
  omega

/-! ### Bounding the largest even element -/

/-- A nonempty set `S` of even integers, all at least `lo`, has largest
element at least `lo + 2 * (|S| - 1)`. -/
theorem even_max_spread (S : Finset ℤ) (hne : S.Nonempty) (lo : ℤ)
    (hev : ∀ x ∈ S, x % 2 = 0) (hlo : ∀ x ∈ S, lo ≤ x) :
    lo + 2 * ((S.card : ℤ) - 1) ≤ S.max' hne := by
  classical
  obtain ⟨k, hk⟩ : ∃ k : ℕ, S.card = k + 1 :=
    ⟨S.card - 1, by have := Finset.card_pos.mpr hne; omega⟩
  have hsep := separated_card_le 2 k S hk
    (fun x hx y hy hxy => by
      have h1 := hev x hx
      have h2 := hev y hy
      omega)
    lo (S.max' hne) (fun x hx => ⟨hlo x hx, S.le_max' x hx⟩)
  have hkz : (k : ℤ) = (S.card : ℤ) - 1 := by rw [hk]; push_cast; ring
  rw [hkz] at hsep
  linarith

/-! ### Inequalities used in the proof for `n ≥ 109` -/

/-- If `t ≥ 154` and `d ≤ 23`, the pair bound excludes `6 ≤ x ≤ 52`. -/
theorem excl_arith_wide (x t d : ℤ) (hx6 : 6 ≤ x) (hx52 : x ≤ 52) (ht : 154 ≤ t)
    (hd : d ≤ 23) (hb : (x - 2) * (t - x) ≤ 4 * x * d + 6 * x) : False := by
  have step1 : (x - 2) * (154 - x) ≤ (x - 2) * (t - x) :=
    mul_le_mul_of_nonneg_left (by omega) (by omega)
  have step2 : (0:ℤ) ≤ (x - 6) * (52 - x) := mul_nonneg (by omega) (by omega)
  nlinarith [hb, step1, step2]

/-- If `t ≥ 208 - 2d` and `d ≤ 19`, the pair bound excludes
`6 ≤ x ≤ 4d + 6`. -/
theorem excl_arith_narrow (x t d : ℤ) (hx6 : 6 ≤ x) (hxub : x ≤ 4 * d + 6) (hd19 : d ≤ 19)
    (ht : 208 - 2 * d ≤ t) (hb : (x - 2) * (t - x) ≤ 4 * x * d + 6 * x) : False := by
  have step1 : (x - 2) * (208 - 2*d - x) ≤ (x - 2) * (t - x) :=
    mul_le_mul_of_nonneg_left (by omega) (by omega)
  have step2 : (0:ℤ) ≤ (x - 6) * (4*d + 6 - x) := mul_nonneg (by omega) (by omega)
  nlinarith [hb, step1, step2]

/-- For `d ≥ 20`, the cardinality bound contradicts `T ≥ d - 1`. -/
theorem endgame_arith_wide (d T : ℤ) (hd : 20 ≤ d) (hT : d - 1 ≤ T)
    (hcl : T * T ≤ T + 4 * (4*d + 5)) : False := by
  nlinarith [mul_nonneg (show (0:ℤ) ≤ T - (d-1) by omega) (show (0:ℤ) ≤ T + (d-1) - 1 by omega)]

/-- For `d ≥ 18`, the cardinality bound contradicts `T ≥ d + 2`. -/
theorem endgame_arith_narrow (d T : ℤ) (hd : 18 ≤ d) (hT : d + 2 ≤ T)
    (hcl : T * T ≤ T + 4 * (4*d + 5)) : False := by
  nlinarith [mul_nonneg (show (0:ℤ) ≤ T - (d+2) by omega) (show (0:ℤ) ≤ T + (d+2) - 1 by omega)]

/-! ### The upper bound for `n ≥ 109` -/

/-- `h₄(n) ≤ 4` for every `n ≥ 109`. -/
theorem h4_le_4_of_ge_109 (n : ℕ) (hn : 109 ≤ n) : hFun 4 n ≤ 4 := by
  unfold hFun
