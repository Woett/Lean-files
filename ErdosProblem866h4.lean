            (fun x hx => (hTOPfacts x hx).2.1) (fun x hx => (hTOPfacts x hx).2.2.1)
        -- First, `T ≥ d - 5` gives `t ≥ 2n - 2d - 18 ≥ 154`.
        have hT1 : d - 5 ≤ (TOP.card : ℤ) := by omega
        have ht1 : 154 ≤ t := by omega
        have hgap1 : ∀ x ∈ LOW, x ≤ 4 ∨ 54 ≤ x := by
          intro x hx
          obtain ⟨hxA, hxe, hx2, hxub⟩ := hLOWfacts x hx
          by_contra hcon
          push_neg at hcon
          have hb := odd_pair_bound n A' D hfree hodd x t (by omega) (by omega) htub
            hxe hte hxA htA
          rw [← hdz] at hb
          exact excl_arith_wide x t d (by omega) (by omega) ht1 hd23Z hb
        have hL5 : (LOW.card : ℤ) ≤ 5 := by
          set LOWa : Finset ℤ := LOW.filter (fun x => x ≤ 4) with hLOWa
          set LOWb : Finset ℤ := LOW.filter (fun x => ¬ (x ≤ 4)) with hLOWb
          have hLOWsplit : LOWa.card + LOWb.card = LOW.card := by
            rw [hLOWa, hLOWb, Finset.card_filter_add_card_filter_not]
          have ha : LOWa.card ≤ 2 := by
            have hsub : LOWa ⊆ ({2, 4} : Finset ℤ) := by
              intro x hx
              obtain ⟨hxLOW, hxle⟩ := Finset.mem_filter.mp hx
              obtain ⟨-, hxe, hx2, -⟩ := hLOWfacts x hxLOW
              have : x = 2 ∨ x = 4 := by omega
              simpa using this
            calc LOWa.card ≤ ({2, 4} : Finset ℤ).card := Finset.card_le_card hsub
