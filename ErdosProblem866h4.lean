      have hEcardZ : d + 4 ≤ (E.card : ℤ) := by rw [hdz]; exact_mod_cast hEcard
      have hEfacts : ∀ x ∈ E, x ∈ A' ∧ x % 2 = 0 ∧ 2 ≤ x ∧ x ≤ 2*(n:ℤ) := by
        intro x hxE
