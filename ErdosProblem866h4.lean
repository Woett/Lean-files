/-! ## Checking a table of surplus bounds

Each table stores one five-bit entry for each of the `16384` windows.
The entry for `w` at time `t` is at position `pos t w`, obtained by rotating
the fourteen bits of `w`. The next two windows correspond to clearing or
setting bit `t % 14` of this position.

This ordering lets shifts, masks, and comparisons check all entries at once.
If an inclusion inequality fails, one of the listed patterns must reject
that window.
-/

/-- Entry `j` of a table stored in five-bit entries. -/
def lane (x j : Nat) : Nat := (x >>> (5*j)) &&& 31

def patE1 (k : Nat) : Nat := (patNat >>> (32*k)) &&& 31
def patE2 (k : Nat) : Nat := (patNat >>> (32*k + 5)) &&& 31
def patE3 (k : Nat) : Nat := (patNat >>> (32*k + 10)) &&& 31
def patMask (k : Nat) : Nat := (patNat >>> (32*k + 15)) &&& 16383

/-- Read the increments and mask of pattern `k` from the stored table. -/
def pats : Nat → Pat := fun k => ⟨patE1 k, patE2 k, patE3 k, patMask k⟩

/-- Store `c` in each of `2 ^ n` five-bit entries whose index contains all
bits of `m` below `n`; store zero in the other entries. -/
def blk (c m : Nat) : Nat → Nat
  | 0 => c
  | n+1 => bif Nat.testBit m n then blk c m n <<< (5 * 2^n)
           else blk c m n ||| (blk c m n <<< (5 * 2^n))

/-- Tables with every entry equal to `31`, `1`, or `16`. -/
def ALLV : Nat := blk 31 0 14
def ONEV : Nat := blk 1 0 14
def HMV : Nat := blk 16 0 14

/-- Compare corresponding entries of `A` and `B` simultaneously. -/
def leC (A B : Nat) : Bool :=
  Nat.beq (A &&& HMV) 0 && Nat.beq (B &&& HMV) 0 && Nat.beq (((B + HMV) - A) &&& HMV) HMV

def rotl1 (x : Nat) : Nat := ((x <<< 1) &&& 16383) ||| (x >>> 13)

/-- The position of window `w` in the table for time `t`. -/
def pos : Nat → Nat → Nat
  | 0, w => w
  | t+1, y => pos t (rotl1 y)

/-- Rotate fourteen bits by `r` positions using two shifts. -/
def posF (r w : Nat) : Nat := ((w <<< r) ||| (w >>> (14 - r))) &&& 16383

/-! ## The table check -/

/-- Select the entries whose index has bit `r` unset, where `p = 2 ^ r`. -/
def nsMask (p : Nat) : Nat := ALLV ^^^ blk 31 p 14

/-- Copy entry `j ||| p` of `Y` into entry `j`. -/
def bcast (Y p : Nat) : Nat := (Y &&& (ALLV ^^^ nsMask p)) ||| ((Y >>> (5*p)) &&& nsMask p)

/-- The table marking all windows rejected by pattern `s`. -/
def cubeOf (t tnw s : Nat) : Nat :=
  bif Nat.blt s nPats && Nat.ble (patE2 s + patE3 s + 2) tnw &&
      Nat.beq ((tnw + patE2 s + patE3 s) &&& 1) 0
  then blk 15 (pos t (patMask s)) 14 else 0

/-- Combine the windows rejected by the first `k` patterns listed in `lst`. -/
def unionU (t tnw lst : Nat) : Nat → Nat
  | 0 => 0
  | k+1 => unionU t tnw lst k ||| cubeOf t tnw ((lst >>> (7*k)) &&& 127)

/-- Check the step inequalities for all `16384` windows in one table. -/
def rowChk (nd t tnw lst n X Y : Nat) : Bool :=
  let p := pos t 1
  let NS := nsMask p
  let XO := X + ONEV
  Nat.beq (X &&& HMV) 0 && Nat.beq (Y &&& HMV) 0 &&
  leC (Y &&& NS) (XO &&& NS) &&
  leC (Y &&& NS) ((XO >>> (5*p)) &&& NS) &&
  leC (bcast Y p + ONEV) (X ||| unionU t tnw lst n) &&
  (Nat.beq nd 0 || leC ONEV X)

/-- Use the table for time `t` through time `24`; thereafter use the
table indexed by `t % 14`. -/
def rowP (t : Nat) : Nat := bif Nat.ble t 24 then tabr t else stabr (t % 14)

/-- Return `15` plus the stored entry for time `t` and window `w`.
This value minus `16` bounds the additional surplus at a later even time. -/
def vAt (t w : Nat) : Nat := 15 + lane (rowP t) (posF (t % 14) w)


