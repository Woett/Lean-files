/-! ## Proving that the table checks give the stated bounds -/

/-- A Boolean test for `PatOK`. -/
def patOKb (p : Pat) : Bool :=
  decide (0 < p.e1) && decide (p.e1 < p.e2) && decide (p.e2 < p.e3) &&
  decide (p.e2 + p.e3 - p.e1 ≤ 14) &&
  p.mask.testBit (14 - (p.e2 - p.e1)) &&
  p.mask.testBit (14 - (p.e3 - p.e1)) &&
  p.mask.testBit (14 - p.e2) &&
  p.mask.testBit (14 - p.e3) &&
  p.mask.testBit (14 - (p.e2 + p.e3 - p.e1))

theorem patOKb_sound (p : Pat) (h : patOKb p = true) : PatOK p := by
  simp only [patOKb, Bool.and_eq_true, decide_eq_true_eq] at h
  obtain ⟨⟨⟨⟨⟨⟨⟨⟨h1, h2⟩, h3⟩, h4⟩, h5⟩, h6⟩, h7⟩, h8⟩, h9⟩ := h
  exact ⟨h1, h2, h3, h4, h5, h6, h7, h8, h9⟩

/-- All `126` stored patterns satisfy `PatOK`. -/
theorem pats_ok (k : Nat) (hk : k < nPats) : PatOK (pats k) := by
  have hall : ((List.range 126).all fun k => patOKb (pats k)) = true := by decide
  rw [List.all_eq_true] at hall
  have hk' : k < 126 := hk
  exact patOKb_sound _ (hall k (List.mem_range.mpr hk'))

theorem lane_eq (x j : Nat) : lane x j = x / 32^j % 32 := by
  unfold lane
  rw [Nat.shiftRight_eq_div_pow, show (31:Nat) = 2^5 - 1 from rfl,
    Nat.and_two_pow_sub_one_eq_mod, Nat.pow_mul]

theorem lane_lt (x j : Nat) : lane x j < 32 := by
  rw [lane_eq]; omega

theorem lane_and (x y j : Nat) : lane (x &&& y) j = lane x j &&& lane y j := by
  unfold lane
  rw [Nat.shiftRight_and_distrib]
  apply Nat.eq_of_testBit_eq
  intro i
  simp only [Nat.testBit_and]
  cases Nat.testBit 31 i <;> simp

theorem lane_or (x y j : Nat) : lane (x ||| y) j = lane x j ||| lane y j := by
  unfold lane
  rw [Nat.shiftRight_or_distrib]
  apply Nat.eq_of_testBit_eq
  intro i
  simp only [Nat.testBit_and, Nat.testBit_or]
  cases Nat.testBit 31 i <;> simp

theorem lane_xor (x y j : Nat) : lane (x ^^^ y) j = lane x j ^^^ lane y j := by
  unfold lane
  rw [Nat.shiftRight_xor_distrib]
  apply Nat.eq_of_testBit_eq
  intro i
  simp only [Nat.testBit_and, Nat.testBit_xor]
  cases Nat.testBit 31 i <;> simp

theorem lane_shiftRight (x m j : Nat) : lane (x >>> (5*m)) j = lane x (m + j) := by
  unfold lane
  rw [← Nat.shiftRight_add, ← Nat.mul_add]

theorem lane_zero (j : Nat) : lane 0 j = 0 := by simp [lane]

theorem lane_of_lt {x n j : Nat} (h : x < 32^n) (hj : n ≤ j) : lane x j = 0 := by
  rw [lane_eq, Nat.div_eq_of_lt (lt_of_lt_of_le h (Nat.pow_le_pow_right (by norm_num) hj))]

/-! ## Addition without carries between entries -/

theorem add_lane {x y : Nat} (h : ∀ j, lane x j + lane y j < 32) (j : Nat) :
    lane (x + y) j = lane x j + lane y j := by
  have key : ∀ j, (x + y) / 32^j = x / 32^j + y / 32^j := by
    intro j
    induction j with
    | zero => simp
    | succ n ih =>
      have hn := h n
      rw [lane_eq, lane_eq] at hn
      have e : (32:Nat)^(n+1) = 32^n * 32 := by ring
      rw [e, ← Nat.div_div_eq_div_mul, ← Nat.div_div_eq_div_mul, ← Nat.div_div_eq_div_mul, ih]
      omega
  rw [lane_eq, lane_eq, lane_eq, key]
  have h1 := h j
  rw [lane_eq, lane_eq] at h1
  omega

theorem lane_shiftLeft_ge (x m j : Nat) (h : m ≤ j) :
    lane (x <<< (5*m)) j = lane x (j - m) := by
  unfold lane
  apply Nat.eq_of_testBit_eq
  intro i
  simp only [Nat.testBit_and, Nat.testBit_shiftRight, Nat.testBit_shiftLeft]
  have : 5 * m ≤ 5 * j + i := by omega
  simp only [this, decide_true, Bool.true_and]
  congr 2
  omega

theorem lane_shiftLeft_lt (x m j : Nat) (h : j < m) : lane (x <<< (5*m)) j = 0 := by
  unfold lane
  apply Nat.eq_of_testBit_eq
  intro i
  rw [Nat.zero_testBit]
  simp only [Nat.testBit_and, Nat.testBit_shiftRight]
  by_cases hi : i < 5
  · have hA : Nat.testBit (x <<< (5*m)) (5*j + i) = false := by
      simp only [Nat.testBit_shiftLeft]
      have : ¬ (5 * m ≤ 5 * j + i) := by omega
      simp [this]
    simp [hA]
  · have hB : Nat.testBit 31 i = false := by
      refine Nat.testBit_lt_two_pow ?_
      calc (31:Nat) < 2^5 := by norm_num
        _ ≤ 2^i := Nat.pow_le_pow_right (by norm_num) (by omega)
    simp [hB]

/-! ## Tables of constants and sets of windows -/

/-- If `c < 32`, the table `blk c m n` fits in `5 * 2 ^ n` bits. -/
theorem blk_lt {c : Nat} (m : Nat) (hc : c < 32) : ∀ n, blk c m n < 2^(5*2^n) := by
  intro n
  induction n with
  | zero => simpa [blk] using hc
  | succ n ih =>
    have hpow : 5 * 2^(n+1) = 5 * 2^n + 5 * 2^n := by ring
    have hsh : blk c m n <<< (5 * 2^n) < 2^(5*2^(n+1)) := by
      rw [Nat.shiftLeft_eq, hpow, Nat.pow_add]
      exact (Nat.mul_lt_mul_right (Nat.two_pow_pos _)).mpr ih
    have hle : blk c m n < 2^(5*2^(n+1)) := by
      refine lt_of_lt_of_le ih (Nat.pow_le_pow_right (by norm_num) ?_)
      omega
    show (bif Nat.testBit m n then _ else _) < _
    cases Nat.testBit m n with
    | true => simpa using hsh
    | false =>
      simp only [cond_false]
      exact Nat.or_lt_two_pow hle hsh

/-- Every set bit of `m` below `n` is also set in `P`. -/
def Cov (m P n : Nat) : Prop := ∀ i, i < n → m.testBit i = true → P.testBit i = true

instance (m P n : Nat) : Decidable (Cov m P n) := by
  unfold Cov; infer_instance

theorem testBit_sub_two_pow {n P i : Nat} (h1 : 2^n ≤ P) (h2 : P < 2^(n+1)) (hi : i < n) :
    (P - 2^n).testBit i = P.testBit i := by
  have hpow : (2:Nat)^(n+1) = 2^n + 2^n := by ring
  have hlt : P - 2^n < 2^n := by omega
  have hor := Nat.two_pow_add_eq_or_of_lt hlt 1
  rw [Nat.mul_one] at hor
  have hP : P = 2^n ||| (P - 2^n) := by rw [← hor]; omega
  conv_rhs => rw [hP]
  simp only [Nat.testBit_or, Nat.testBit_two_pow]
  have : ¬ (n = i) := by omega
  simp [this]

theorem testBit_high {n P : Nat} (h1 : 2^n ≤ P) (h2 : P < 2^(n+1)) : P.testBit n = true := by
  have hpow : (2:Nat)^(n+1) = 2^n + 2^n := by ring
  have hlt : P - 2^n < 2^n := by omega
  have hor := Nat.two_pow_add_eq_or_of_lt hlt 1
  rw [Nat.mul_one] at hor
  have hP : P = 2^n ||| (P - 2^n) := by rw [← hor]; omega
  conv_lhs => rw [hP]
  simp [Nat.testBit_or, Nat.testBit_lt_two_pow hlt]

theorem lane_blk {c : Nat} (hc : c < 32) (m : Nat) : ∀ n P, P < 2^n →
    lane (blk c m n) P = if Cov m P n then c else 0 := by
  intro n
  induction n with
  | zero =>
    intro P hP
    have hP0 : P = 0 := by simpa using hP
    subst hP0
    have hcov : Cov m 0 0 := fun i hi _ => absurd hi (by omega)
    have hl : lane c 0 = c := by
      rw [lane_eq]; simpa using Nat.mod_eq_of_lt hc
    simp [blk, hl, hcov]
  | succ n ih =>
    intro P hP
    have hpow : (2:Nat)^(n+1) = 2^n + 2^n := by ring
    have hzero : ¬ (P < 2^n) → lane (blk c m n) P = 0 := by
      intro h
      refine lane_of_lt (n := 2^n) ?_ (by omega)
      calc blk c m n < 2^(5*2^n) := blk_lt (c := c) m hc n
        _ = 32^(2^n) := by rw [show (32:Nat) = 2^5 from rfl, ← Nat.pow_mul]
    have hhigh : ∀ hlo : 2^n ≤ P, (Cov m (P - 2^n) n ↔ Cov m P n) := by
      intro hlo
      constructor
      · intro hcov i hi hmi
        rw [← testBit_sub_two_pow hlo hP hi]; exact hcov i hi hmi
      · intro hcov i hi hmi
        rw [testBit_sub_two_pow hlo hP hi]; exact hcov i hi hmi
    show lane (bif Nat.testBit m n then _ else _) P = _
    by_cases hb : Nat.testBit m n = true
    · simp only [hb, cond_true]
      by_cases hlo : P < 2^n
      · rw [lane_shiftLeft_lt _ _ _ hlo]
        have hnot : ¬ Cov m P (n+1) := by
          intro hcov
          have := hcov n (by omega) hb
          rw [Nat.testBit_lt_two_pow hlo] at this
          exact Bool.noConfusion this
        simp [hnot]
      · push_neg at hlo
        rw [lane_shiftLeft_ge _ _ _ (by omega), ih _ (by omega)]
        have hPn : P.testBit n = true := testBit_high hlo hP
        have hiff : Cov m (P - 2^n) n ↔ Cov m P (n+1) := by
          rw [hhigh hlo]
          constructor
          · intro hcov i hi hmi
            rcases Nat.lt_or_ge i n with h | h
            · exact hcov i h hmi
            · have : i = n := by omega
              subst this; exact hPn
          · intro hcov i hi hmi; exact hcov i (by omega) hmi
        by_cases hcv : Cov m (P - 2^n) n
        · simp [hcv, hiff.mp hcv]
        · have hnot : ¬ Cov m P (n+1) := fun h => hcv (hiff.mpr h)
          simp [hcv, hnot]
    · simp only [Bool.not_eq_true] at hb
      simp only [hb, cond_false, lane_or]
      have hnb : ∀ Q, (Cov m Q n ↔ Cov m Q (n+1)) := by
        intro Q
        constructor
        · intro hcov i hi hmi
          rcases Nat.lt_or_ge i n with h | h
          · exact hcov i h hmi
          · have : i = n := by omega
            subst this
            rw [hb] at hmi; exact absurd hmi (by simp)
        · intro hcov i hi hmi; exact hcov i (by omega) hmi
      by_cases hlo : P < 2^n
      · rw [lane_shiftLeft_lt _ _ _ hlo, ih _ hlo]
        by_cases hcv : Cov m P n
        · simp [hcv, (hnb P).mp hcv]
        · have hnot : ¬ Cov m P (n+1) := fun h => hcv ((hnb P).mpr h)
          simp [hcv, hnot]
      · push_neg at hlo
        rw [hzero (by omega), lane_shiftLeft_ge _ _ _ (by omega), ih _ (by omega)]
        have hiff : Cov m (P - 2^n) n ↔ Cov m P (n+1) := (hhigh hlo).trans (hnb P)
        by_cases hcv : Cov m (P - 2^n) n
        · simp [hcv, hiff.mp hcv]
        · have hnot : ¬ Cov m P (n+1) := fun h => hcv (hiff.mpr h)
          simp [hcv, hnot]

/-! ## The constant tables -/

theorem cov_zero (P n : Nat) : Cov 0 P n := by
  intro i _ h; simp at h

theorem lane_const {c : Nat} (hc : c < 32) {P : Nat} (hP : P < 16384) :
    lane (blk c 0 14) P = c := by
  rw [lane_blk hc 0 14 P (by norm_num; omega), if_pos (cov_zero P 14)]

theorem lane_const_high {c : Nat} (hc : c < 32) {P : Nat} (hP : 16384 ≤ P) :
    lane (blk c 0 14) P = 0 := by
  refine lane_of_lt (n := 16384) ?_ hP
  calc blk c 0 14 < 2^(5*2^14) := blk_lt (c := c) 0 hc 14
    _ = 32^16384 := by rw [show (32:Nat) = 2^5 from rfl, ← Nat.pow_mul]; norm_num

theorem lane_ALLV {P : Nat} (hP : P < 16384) : lane ALLV P = 31 := lane_const (by norm_num) hP
theorem lane_ONEV {P : Nat} (hP : P < 16384) : lane ONEV P = 1 := lane_const (by norm_num) hP
theorem lane_ONEV_high {P : Nat} (hP : 16384 ≤ P) : lane ONEV P = 0 :=
  lane_const_high (by norm_num) hP
theorem lane_HMV {P : Nat} (hP : P < 16384) : lane HMV P = 16 := lane_const (by norm_num) hP
theorem lane_HMV_high {P : Nat} (hP : 16384 ≤ P) : lane HMV P = 0 :=
  lane_const_high (by norm_num) hP

/-! ## Comparing corresponding entries -/

theorem and16_zero : ∀ x, x < 32 → x &&& 16 = 0 → x ≤ 15 := by decide
theorem and16_full : ∀ x, x < 32 → x &&& 16 = 16 → 16 ≤ x := by decide

theorem lane_le15 {A : Nat} (h : A &&& HMV = 0) {j : Nat} (hj : j < 16384) : lane A j ≤ 15 := by
  have hl : lane A j &&& 16 = 0 := by
    have := congrArg (fun z => lane z j) h
    simpa [lane_and, lane_HMV hj, lane_zero] using this
  exact and16_zero _ (lane_lt A j) hl

theorem leC_sound {A B : Nat} (h : leC A B = true) {j : Nat} (hj : j < 16384) :
    lane A j ≤ lane B j := by
  simp only [leC, Bool.and_eq_true, Nat.beq_eq] at h
  obtain ⟨⟨hA, hB⟩, hD⟩ := h
  set D := (B + HMV) - A with hDdef
  have hAle : ∀ i, i < 16384 → lane A i ≤ 15 := fun i hi => lane_le15 hA hi
  have hBle : ∀ i, i < 16384 → lane B i ≤ 15 := fun i hi => lane_le15 hB hi
  have hDge : ∀ i, i < 16384 → 16 ≤ lane D i := by
    intro i hi
    have hl : lane D i &&& 16 = 16 := by
      have := congrArg (fun z => lane z i) hD
      simpa [lane_and, lane_HMV hi] using this
    exact and16_full _ (lane_lt D i) hl
  have hAB : A ≤ B + HMV := by
    by_contra hcon
    push_neg at hcon
    have hD0 : D = 0 := by omega
    have := hDge 0 (by norm_num)
    rw [hD0, lane_zero] at this
    omega
  have hsum : A + D = B + HMV := by omega
  have hBH : ∀ i, lane (B + HMV) i = lane B i + lane HMV i := by
    refine add_lane ?_
    intro i
    rcases Nat.lt_or_ge i 16384 with hi | hi
    · rw [lane_HMV hi]; have := hBle i hi; omega
    · rw [lane_HMV_high hi]; have := lane_lt B i; omega
  have laneEq : ∀ n, n < 16384 → (A + D)/32^n = A/32^n + D/32^n →
      lane A n + lane D n = lane B n + 16 := by
    intro n hn hdiv
    have h1 : lane (A + D) n = lane B n + 16 := by
      rw [hsum, hBH n, lane_HMV hn]
    rw [lane_eq, hdiv] at h1
    have ha := lane_eq A n
    have hd := lane_eq D n
    have h2 := hAle n hn
    have h3 := hBle n hn
    have h4 := lane_lt D n
    omega
  have key : ∀ n, n ≤ 16384 → (A + D)/32^n = A/32^n + D/32^n := by
    intro n
    induction n with
    | zero => intro _; simp
    | succ m ih =>
      intro hm
      have ihm := ih (by omega)
      have hln := laneEq m (by omega) ihm
      have ha := lane_eq A m
      have hd := lane_eq D m
      have hb := hBle m (by omega)
      have e : (32:Nat)^(m+1) = 32^m * 32 := by ring
      rw [e, ← Nat.div_div_eq_div_mul, ← Nat.div_div_eq_div_mul, ← Nat.div_div_eq_div_mul, ihm]
      omega
  have := laneEq j hj (key j (by omega))
  have := hDge j hj
  omega

/-! ## Reordering entries by rotating window bits -/

theorem testBit_of_lt {y : Nat} (hy : y < 16384) {i : Nat} (hi : 14 ≤ i) : y.testBit i = false := by
  refine Nat.testBit_lt_two_pow (lt_of_lt_of_le hy ?_)
  calc (16384:Nat) = 2^14 := by norm_num
    _ ≤ 2^i := Nat.pow_le_pow_right (by norm_num) hi

theorem rotl1_eq {x : Nat} (hx : x < 16384) : rotl1 x = 2*(x % 8192) + x / 8192 := by
  unfold rotl1
  rw [Nat.shiftLeft_eq, Nat.shiftRight_eq_div_pow,
    show (16383:Nat) = 2^14 - 1 from rfl, Nat.and_two_pow_sub_one_eq_mod]
  have h1 : x * 2^1 % 2^14 = 2^1 * (x % 8192) := by
    have : (2:Nat)^14 = 2^1 * 8192 := by norm_num
    rw [this, Nat.mul_comm x (2^1), Nat.mul_mod_mul_left]
  have h2 : x / 2^13 < 2^1 := by
    have : x / 2^13 < 16384 / 8192 + 1 := by omega
    omega
  rw [h1, ← Nat.two_pow_add_eq_or_of_lt h2 (x % 8192)]
  norm_num

theorem rotl1_lt {x : Nat} (hx : x < 16384) : rotl1 x < 16384 := by
  rw [rotl1_eq hx]; omega

theorem rotl1_testBit {x : Nat} (hx : x < 16384) (i : Nat) :
    (rotl1 x).testBit i =
      (if i = 0 then x.testBit 13 else if i < 14 then x.testBit (i-1) else false) := by
  unfold rotl1
  simp only [Nat.testBit_or, Nat.testBit_and, Nat.testBit_shiftLeft, Nat.testBit_shiftRight,
    show (16383:Nat) = 2^14 - 1 from rfl, Nat.testBit_two_pow_sub_one]
  rcases Nat.eq_zero_or_pos i with rfl | hi
  · simp
  · have hi1 : 1 ≤ i := hi
    rw [if_neg (by omega), testBit_of_lt hx (i := 13+i) (by omega)]
    by_cases h14 : i < 14
    · simp [h14, hi1]
    · simp [h14]

theorem rotl1_or {x y : Nat} (hx : x < 16384) (hy : y < 16384) :
    rotl1 (x ||| y) = rotl1 x ||| rotl1 y := by
  have hxy : x ||| y < 16384 := Nat.or_lt_two_pow (n := 14) hx hy
  apply Nat.eq_of_testBit_eq
  intro i
  rw [Nat.testBit_or, rotl1_testBit hxy, rotl1_testBit hx, rotl1_testBit hy]
  by_cases h0 : i = 0
  · simp [h0, Nat.testBit_or]
  · by_cases h14 : i < 14 <;> simp [h0, h14, Nat.testBit_or]

theorem rotl1_and {x y : Nat} (hx : x < 16384) (hy : y < 16384) :
    rotl1 (x &&& y) = rotl1 x &&& rotl1 y := by
  have hxy : x &&& y < 16384 := lt_of_le_of_lt (Nat.and_le_left) hx
  apply Nat.eq_of_testBit_eq
  intro i
  rw [Nat.testBit_and, rotl1_testBit hxy, rotl1_testBit hx, rotl1_testBit hy]
  by_cases h0 : i = 0
  · simp [h0, Nat.testBit_and]
  · by_cases h14 : i < 14 <;> simp [h0, h14, Nat.testBit_and]

theorem pos_lt : ∀ (t : Nat) {x : Nat}, x < 16384 → pos t x < 16384 := by
  intro t
  induction t with
  | zero => intro x hx; exact hx
  | succ n ih => intro x hx; exact ih (rotl1_lt hx)

theorem pos_zero : ∀ t : Nat, pos t 0 = 0 := by
  intro t
  induction t with
  | zero => rfl
  | succ n ih => show pos n (rotl1 0) = 0; simpa [rotl1] using ih

theorem pos_or : ∀ (t : Nat) {x y : Nat}, x < 16384 → y < 16384 →
    pos t (x ||| y) = pos t x ||| pos t y := by
  intro t
  induction t with
  | zero => intro x y _ _; rfl
  | succ n ih =>
    intro x y hx hy
    show pos n (rotl1 (x ||| y)) = _
    rw [rotl1_or hx hy, ih (rotl1_lt hx) (rotl1_lt hy)]
    rfl

theorem pos_and : ∀ (t : Nat) {x y : Nat}, x < 16384 → y < 16384 →
    pos t (x &&& y) = pos t x &&& pos t y := by
  intro t
  induction t with
  | zero => intro x y _ _; rfl
  | succ n ih =>
    intro x y hx hy
    show pos n (rotl1 (x &&& y)) = _
    rw [rotl1_and hx hy, ih (rotl1_lt hx) (rotl1_lt hy)]
    rfl

theorem rotl1_two_pow : ∀ i, i < 14 → rotl1 (2^i) = 2^((i+1) % 14) := by decide

theorem pos_two_pow : ∀ (t i : Nat), i < 14 → pos t (2^i) = 2^((i+t) % 14) := by
  intro t
  induction t with
  | zero => intro i hi; simp [pos, Nat.mod_eq_of_lt hi]
  | succ n ih =>
    intro i hi
    show pos n (rotl1 (2^i)) = _
    rw [rotl1_two_pow i hi, ih ((i+1) % 14) (Nat.mod_lt _ (by norm_num))]
    congr 1
    omega

theorem pos_testBit : ∀ (k : Nat) {x : Nat}, x < 16384 → ∀ i, i < 14 →
    (pos k x).testBit ((i + k) % 14) = x.testBit i := by
  intro k
  induction k with
  | zero => intro x _ i hi; simp [pos, Nat.mod_eq_of_lt hi]
  | succ m ih =>
    intro x hx i hi
    show (pos m (rotl1 x)).testBit ((i + (m+1)) % 14) = _
    rw [show (i + (m+1)) % 14 = ((i+1) % 14 + m) % 14 by omega,
      ih (rotl1_lt hx) ((i+1) % 14) (Nat.mod_lt _ (by norm_num)), rotl1_testBit hx]
    rcases Nat.lt_or_ge i 13 with h | h
    · rw [Nat.mod_eq_of_lt (by omega), if_neg (by omega), if_pos (by omega)]
      congr 1
    · have : i = 13 := by omega
      subst this
      norm_num

theorem pos_id {x : Nat} (hx : x < 16384) : pos 14 x = x := by
  apply Nat.eq_of_testBit_eq
  intro i
  rcases Nat.lt_or_ge i 14 with hi | hi
  · have h := pos_testBit 14 hx i hi
    rwa [show (i + 14) % 14 = i by omega] at h
  · rw [testBit_of_lt (pos_lt 14 hx) hi, testBit_of_lt hx hi]

theorem pos_add : ∀ (a b x : Nat), pos (a+b) x = pos a (pos b x) := by
  intro a b
  induction b with
  | zero => intro x; rfl
  | succ m ih =>
    intro x
    show pos (a + m) (rotl1 x) = pos a (pos m (rotl1 x))
    exact ih (rotl1 x)

theorem pos_mod (t : Nat) {x : Nat} (hx : x < 16384) : pos (t % 14) x = pos t x := by
  have hmul : ∀ q y, y < 16384 → pos (14*q) y = y := by
    intro q
    induction q with
    | zero => intro y _; rfl
    | succ r ih =>
      intro y hy
      have : 14 * (r+1) = 14 * r + 14 := by ring
      rw [this, pos_add, pos_id hy]
      exact ih y hy
  conv_rhs => rw [show t = t % 14 + 14 * (t / 14) by omega]
  rw [pos_add, hmul _ x hx]

theorem posF_lt (r w : Nat) : posF r w < 16384 :=
  lt_of_le_of_lt Nat.and_le_right (by norm_num)

theorem posF_eq {r w : Nat} (hr : r < 14) (hw : w < 16384) : posF r w = pos r w := by
  apply Nat.eq_of_testBit_eq
  intro j
  rcases Nat.lt_or_ge j 14 with hj | hj
  · have key := pos_testBit r hw ((j + 14 - r) % 14) (Nat.mod_lt _ (by norm_num))
    rw [show ((j + 14 - r) % 14 + r) % 14 = j by omega] at key
    rw [key, posF, Nat.testBit_and, Nat.testBit_or, Nat.testBit_shiftLeft,
      Nat.testBit_shiftRight, show (16383 : Nat).testBit j = true by interval_cases j <;> rfl,
      Bool.and_true]
    rcases Nat.lt_or_ge j r with h | h
    · rw [decide_eq_false (by omega : ¬ (r ≤ j)), Bool.false_and, Bool.false_or,
        show 14 - r + j = (j + 14 - r) % 14 by omega]
    · rw [decide_eq_true (by omega : r ≤ j), Bool.true_and,
        testBit_of_lt hw (by omega : 14 ≤ 14 - r + j), Bool.or_false,
        show j - r = (j + 14 - r) % 14 by omega]
  · rw [testBit_of_lt (posF_lt r w) hj, testBit_of_lt (pos_lt r hw) hj]

/-- The formula using two shifts agrees with the repeated rotation. -/
theorem vAt_eq {t w : Nat} (hw : w < 16384) : vAt t w = 15 + lane (rowP t) (pos t w) := by
  rw [vAt, posF_eq (Nat.mod_lt _ (by norm_num)) hw, pos_mod t hw]

theorem pos_all : ∀ t, pos t 16383 = 16383 := by
  intro t
  induction t with
  | zero => rfl
  | succ n ih =>
    show pos n (rotl1 16383) = 16383
    rw [show rotl1 16383 = 16383 from rfl]
    exact ih

/-- Rotating both masks preserves containment of their set bits. -/
theorem cov_pos {t m w : Nat} (hm : m < 16384) (hw : w < 16384)
    (h : Cov (pos t m) (pos t w) 14) : w &&& m = m := by
  apply Nat.eq_of_testBit_eq
  intro i
  rw [Nat.testBit_and]
  by_cases hi : i < 14
  · by_cases hm2 : m.testBit i
    · have h1 : (pos t m).testBit ((i+t)%14) = true := by
        rw [pos_testBit t hm i hi]; exact hm2
      have h2 := h ((i+t)%14) (Nat.mod_lt _ (by norm_num)) h1
      rw [pos_testBit t hw i hi] at h2
      simp [h2, hm2]
    · simp only [Bool.not_eq_true] at hm2
      simp [hm2]
  · rw [testBit_of_lt hm (by omega)]
    simp

/-! ## Bit arithmetic -/

theorem two_pow_mod_succ (x r : Nat) : x % 2^(r+1) = 2^r * (x / 2^r % 2) + x % 2^r := by
  have h2 : 2*(x/2^r/2) + x/2^r % 2 = x/2^r := by omega
  have hm : x % 2^r < 2^r := Nat.mod_lt _ (Nat.two_pow_pos r)
  have hs : x / 2^r % 2 < 2 := Nat.mod_lt _ (by norm_num)
  have hx : 2^(r+1) * (x / 2^r / 2) + (2^r * (x / 2^r % 2) + x % 2^r) = x := by
    calc 2^(r+1) * (x / 2^r / 2) + (2^r * (x / 2^r % 2) + x % 2^r)
        = 2^r * (2*(x/2^r/2) + x/2^r % 2) + x % 2^r := by rw [pow_succ]; ring
      _ = 2^r * (x/2^r) + x % 2^r := by rw [h2]
      _ = x := Nat.div_add_mod x (2^r)
  have hlt : 2^r * (x / 2^r % 2) + x % 2^r < 2^(r+1) := by
    have : 2^r * (x / 2^r % 2) ≤ 2^r * 1 := Nat.mul_le_mul_left _ (by omega)
    rw [pow_succ]; omega
  conv_lhs => rw [← hx]
  rw [Nat.add_comm, Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt hlt]

theorem testBit_false_div {x r : Nat} (h : x.testBit r = false) : x / 2^r % 2 = 0 := by
  rw [Nat.testBit_eq_decide_div_mod_eq] at h
  simp only [decide_eq_false_iff_not] at h
  omega

theorem add_two_pow_eq_or {x r : Nat} (h : x.testBit r = false) : x + 2^r = x ||| 2^r := by
  have hs := testBit_false_div h
  have hmod : x % 2^(r+1) = x % 2^r := by rw [two_pow_mod_succ, hs]; simp
  have hlo : x % 2^r < 2^r := Nat.mod_lt _ (Nat.two_pow_pos r)
  have hx : 2^(r+1) * (x / 2^(r+1)) + x % 2^r = x := by
    rw [← hmod]; exact Nat.div_add_mod x (2^(r+1))
  have e1 : x = 2^(r+1) * (x / 2^(r+1)) ||| x % 2^r := by
    rw [← Nat.two_pow_add_eq_or_of_lt (by rw [pow_succ]; omega) _, hx]
  have e2 : 2^r + x % 2^r = 2^r ||| x % 2^r := by
    have := Nat.two_pow_add_eq_or_of_lt (i := r) hlo 1
    simpa using this
  have e3 : x + 2^r = 2^(r+1) * (x / 2^(r+1)) ||| (2^r + x % 2^r) := by
    rw [← Nat.two_pow_add_eq_or_of_lt (i := r+1) (b := 2^r + x % 2^r) (by rw [pow_succ]; omega)]
    omega
  rw [e3, e2]
  conv_rhs => rw [e1]
  rw [Nat.lor_assoc, Nat.lor_comm (x % 2^r) (2^r)]

theorem and_two_pow_eq {x r : Nat} : x &&& 2^r = if x.testBit r then 2^r else 0 := by
  apply Nat.eq_of_testBit_eq
  intro i
  rw [Nat.testBit_and, Nat.testBit_two_pow]
  by_cases hi : r = i
  · subst hi
    by_cases hb : x.testBit r <;> simp [hb]
  · by_cases hb : x.testBit r <;> simp [hi, hb]

theorem or_two_pow_of_testBit {x r : Nat} (h : x.testBit r = true) : x ||| 2^r = x := by
  apply Nat.eq_of_testBit_eq
  intro i
  rw [Nat.testBit_or, Nat.testBit_two_pow]
  by_cases hi : r = i
  · subst hi; simp [h]
  · simp [hi]

theorem testBit_one {i : Nat} (hi : i ≠ 0) : (1:Nat).testBit i = false := by
  rw [show (1:Nat) = 2^0 from rfl, Nat.testBit_two_pow]
  simp only [decide_eq_false_iff_not]
  omega

theorem and31 : ∀ x, x < 32 → x &&& 31 = x := by decide

/-! ## Correctness of the table check -/

theorem patMask_lt (k : Nat) : patMask k < 16384 := by
  have : patMask k = (patNat >>> (32*k + 15)) % 16384 := by
    rw [patMask, show (16383:Nat) = 2^14 - 1 from rfl, Nat.and_two_pow_sub_one_eq_mod]
  omega

theorem cov_two_pow {r j : Nat} (hr : r < 14) : Cov (2^r) j 14 ↔ j.testBit r = true := by
  constructor
  · intro h; exact h r hr (by simp)
  · intro h i _ hi
    rw [Nat.testBit_two_pow] at hi
    simp only [decide_eq_true_eq] at hi
    rwa [← hi]

theorem lane_nsMask {r j : Nat} (hr : r < 14) (hj : j < 16384) :
    lane (nsMask (2^r)) j = if j.testBit r then 0 else 31 := by
  rw [nsMask, lane_xor, lane_ALLV hj, lane_blk (by norm_num) _ 14 j (by simpa using hj)]
  by_cases hb : j.testBit r
  · rw [if_pos ((cov_two_pow hr).2 hb), if_pos hb]; rfl
  · rw [if_neg (fun hc => hb ((cov_two_pow hr).1 hc)), if_neg hb]; rfl

theorem lane_nsMask_co {r j : Nat} (hr : r < 14) (hj : j < 16384) :
    lane (ALLV ^^^ nsMask (2^r)) j = if j.testBit r then 31 else 0 := by
  rw [lane_xor, lane_ALLV hj, lane_nsMask hr hj]
  by_cases hb : j.testBit r <;> simp [hb]

theorem lane_and_ns {A r j : Nat} (hr : r < 14) (hj : j < 16384) (hb : j.testBit r = false) :
    lane (A &&& nsMask (2^r)) j = lane A j := by
  rw [lane_and, lane_nsMask hr hj, if_neg (by simp [hb]), and31 _ (lane_lt A j)]

theorem lane_addONEV {A : Nat} (hA : A &&& HMV = 0) {j : Nat} (hj : j < 16384) :
    lane (A + ONEV) j = lane A j + 1 := by
  have h : ∀ i, lane A i + lane ONEV i < 32 := by
    intro i
    rcases Nat.lt_or_ge i 16384 with hi | hi
    · rw [lane_ONEV hi]; have := lane_le15 hA hi; omega
    · rw [lane_ONEV_high hi]; have := lane_lt A i; omega
  rw [add_lane h j, lane_ONEV hj]

theorem lane_bcast {Y r j : Nat} (hr : r < 14) (hj : j < 16384) :
    lane (bcast Y (2^r)) j = lane Y (j ||| 2^r) := by
  rw [bcast, lane_or, lane_and, lane_and, lane_shiftRight, lane_nsMask hr hj,
    lane_nsMask_co hr hj]
  by_cases hb : j.testBit r
  · rw [if_pos hb, if_pos hb, or_two_pow_of_testBit hb, and31 _ (lane_lt Y j)]
    simp
  · rw [if_neg hb, if_neg hb, and31 _ (lane_lt Y _), ← add_two_pow_eq_or (by simpa using hb)]
    simp [Nat.add_comm]

theorem lane_bcast_le {Y r : Nat} (hY : Y &&& HMV = 0) (hr : r < 14) {j : Nat} :
    lane (bcast Y (2^r)) j + lane ONEV j < 32 := by
  rcases Nat.lt_or_ge j 16384 with hj | hj
  · rw [lane_ONEV hj, lane_bcast hr hj]
    have h1 : j ||| 2^r < 16384 := by
      refine Nat.or_lt_two_pow (n := 14) hj ?_
      have : (2:Nat)^r < 2^14 := Nat.pow_lt_pow_right (by norm_num) hr
      simpa using this
    have := lane_le15 hY h1
    omega
  · rw [lane_ONEV_high hj]
    have := lane_lt (bcast Y (2^r)) j
    omega

theorem unionU_spec (t tnw lst : Nat) : ∀ k P, P < 16384 → lane (unionU t tnw lst k) P ≠ 0 →
    ∃ s, s < nPats ∧ patE2 s + patE3 s + 2 ≤ tnw ∧ (tnw + patE2 s + patE3 s) % 2 = 0 ∧
      Cov (pos t (patMask s)) P 14 := by
  intro k
  induction k with
  | zero => intro P _ h; simp [unionU, lane_zero] at h
  | succ m ih =>
    intro P hP h
    rw [unionU, lane_or] at h
    by_cases h1 : lane (unionU t tnw lst m) P = 0
    · set s := (lst >>> (7*m)) &&& 127 with hs
      have h2 : lane (cubeOf t tnw s) P ≠ 0 := by
        intro hz; rw [h1, hz] at h; exact h rfl
      by_cases hg : (Nat.blt s nPats && Nat.ble (patE2 s + patE3 s + 2) tnw &&
          Nat.beq ((tnw + patE2 s + patE3 s) &&& 1) 0) = true
      · rw [cubeOf, hg, cond_true, lane_blk (by norm_num) _ 14 P (by simpa using hP)] at h2
        refine ⟨s, ?_, ?_, ?_, ?_⟩
        · simp only [Bool.and_eq_true, Nat.blt_eq] at hg; exact hg.1.1
        · simp only [Bool.and_eq_true, Nat.ble_eq] at hg; exact hg.1.2
        · simp only [Bool.and_eq_true, Nat.beq_eq, Nat.and_one_is_mod] at hg
          omega
        · by_contra hc
          rw [if_neg hc] at h2
          exact h2 rfl
      · rw [Bool.not_eq_true] at hg
        rw [cubeOf, hg, cond_false, lane_zero] at h2
        exact absurd rfl h2
    · exact ih P hP h1

/-- An accepted table check gives the required inequalities for every
window. The indices `tp` and `t` give the same rotation; `tnw` gives a time
at which the rejecting patterns apply. -/
theorem bell_of_rowChk {nd tp tnw lst n X Y t : Nat}
    (hmod : tp % 14 = t % 14)
    (hneed : t % 2 = 0 → 12 ≤ t → nd ≠ 0)
    (htn : tnw ≤ t + 1) (hpar : (t+1) % 2 = tnw % 2)
    (hchk : rowChk nd tp tnw lst n X Y = true)
    {w : Nat} (hw : w < 16384) :
    (t % 2 = 0 → 12 ≤ t → 1 ≤ lane X (pos t w)) ∧
    lane Y (pos (t+1) (w >>> 1)) ≤ lane X (pos t w) + 1 ∧
    (lane Y (pos (t+1) ((w >>> 1) ||| 8192)) + 1 ≤ lane X (pos t w) ∨
      ∃ k, k < nPats ∧ RejectsAt (pats k) (t+1) w) := by

  simp only [rowChk, Bool.and_eq_true, Bool.or_eq_true, Nat.beq_eq] at hchk
  obtain ⟨⟨⟨⟨⟨hXH, hYH⟩, hc1⟩, hc2⟩, hc3⟩, hc4⟩ := hchk

  set r := t % 14 with hrdef
  have hr : r < 14 := Nat.mod_lt _ (by norm_num)
  have hp : pos tp 1 = 2^r := by
    have := pos_two_pow tp 0 (by norm_num)
    simpa [hmod] using this
  have hpt : pos t 1 = 2^r := by
    have := pos_two_pow t 0 (by norm_num)
    simpa using this
  rw [hp] at hc1 hc2 hc3

  set P := pos t w with hPdef
  have hP : P < 16384 := pos_lt t hw
  -- Express the two next windows in the rotated ordering.
  have hshift : rotl1 (w >>> 1) = w &&& 16382 := by
    apply Nat.eq_of_testBit_eq
    intro i
    rw [rotl1_testBit (by rw [Nat.shiftRight_eq_div_pow]; omega) i]
    by_cases h0 : i = 0
    · subst h0
      simp [Nat.testBit_shiftRight, testBit_of_lt hw (i := 14) (by omega)]
    · rw [if_neg h0]
      by_cases h14 : i < 14
      · have hb : (16382:Nat).testBit i = true := by
          have h1 : 1 ≤ i := by omega
          interval_cases i <;> decide
        rw [if_pos h14]
        simp [Nat.testBit_and, Nat.testBit_shiftRight, hb, show 1 + (i-1) = i from by omega]
      · rw [if_neg h14]
        simp [Nat.testBit_and, testBit_of_lt hw (i := i) (by omega)]
  have hshift2 : rotl1 ((w >>> 1) ||| 8192) = w ||| 1 := by
    have hx : (w >>> 1) ||| 8192 < 16384 := by
      refine Nat.or_lt_two_pow (n := 14) ?_ (by norm_num)
      rw [Nat.shiftRight_eq_div_pow]; omega
    apply Nat.eq_of_testBit_eq
    intro i
    rw [rotl1_testBit hx i]
    by_cases h0 : i = 0
    · subst h0
      simp [Nat.testBit_or, Nat.testBit_shiftRight,
        show Nat.testBit 8192 13 = true from by decide]
    · rw [if_neg h0]
      by_cases h14 : i < 14
      · have h8 : Nat.testBit 8192 (i-1) = false := by
          rw [show (8192:Nat) = 2^13 from rfl, Nat.testBit_two_pow]
          simp only [decide_eq_false_iff_not]
          omega
        rw [if_pos h14]
        simp [Nat.testBit_or, Nat.testBit_shiftRight, testBit_one h0, h8,
          show 1 + (i-1) = i from by omega]
      · rw [if_neg h14]
        have hw1 : (w ||| 1).testBit i = false :=
          testBit_of_lt (Nat.or_lt_two_pow (n := 14) hw (by norm_num)) (by omega)
        rw [hw1]
  have hQdef : pos (t+1) (w >>> 1) = pos t (w &&& 16382) := by
    show pos t (rotl1 (w >>> 1)) = _
    rw [hshift]
  have hRdef : pos (t+1) ((w >>> 1) ||| 8192) = P ||| 2^r := by
    show pos t (rotl1 ((w >>> 1) ||| 8192)) = _
    rw [hshift2, pos_or t hw (by norm_num), hpt]
  set Q := pos t (w &&& 16382) with hQ
  have hQlt : Q < 16384 := pos_lt t (lt_of_le_of_lt Nat.and_le_left hw)
  have hQP : Q = P &&& pos t 16382 := pos_and t hw (by norm_num)
  have hq0 : pos t 16382 &&& 2^r = 0 := by
    rw [← hpt, ← pos_and t (by norm_num) (by norm_num)]
    exact pos_zero t
  have hq1 : pos t 16382 ||| 2^r = 16383 := by
    rw [← hpt, ← pos_or t (by norm_num) (by norm_num)]
    exact pos_all t
  have hQb : Q.testBit r = false := by
    have h0 : Q &&& 2^r = 0 := by rw [hQP, Nat.and_assoc, hq0, Nat.and_zero]
    rw [and_two_pow_eq] at h0
    by_cases hb : Q.testBit r
    · exact absurd (by rw [if_pos hb] at h0; exact h0) (Nat.two_pow_pos r).ne'
    · simpa using hb
  have hPm : P &&& 16383 = P := by
    simpa using Nat.and_two_pow_sub_one_of_lt_two_pow (n := 14) (x := P) (by simpa using hP)
  have hsplit : P = Q ||| (if P.testBit r then 2^r else 0) :=
    calc P = P &&& 16383 := hPm.symm
      _ = P &&& (pos t 16382 ||| 2^r) := by rw [hq1]
      _ = (P &&& pos t 16382) ||| (P &&& 2^r) := Nat.and_or_distrib_left _ _ _
      _ = Q ||| (if P.testBit r then 2^r else 0) := by rw [← hQP, and_two_pow_eq]
  have hPcase : P = Q ∨ P = Q ||| 2^r := by
    by_cases hb : P.testBit r
    · rw [if_pos hb] at hsplit; exact Or.inr hsplit
    · rw [if_neg hb, Nat.or_zero] at hsplit; exact Or.inl hsplit
  have hposmod : ∀ x, x < 16384 → pos tp x = pos t x := by
    intro x hx
    rw [← pos_mod tp hx, hmod, pos_mod t hx]
  refine ⟨?_, ?_, ?_⟩
  · intro he h12
    rcases hc4 with h | h
    · exact absurd h (hneed he h12)
    · have h2 := leC_sound h hP
      rwa [lane_ONEV hP] at h2
  · rw [hQdef]
    rcases hPcase with hPQ | hPQ
    · have h := leC_sound hc1 hQlt
      rw [lane_and_ns hr hQlt hQb, lane_and_ns hr hQlt hQb, lane_addONEV hXH hQlt] at h
      rw [hPQ]
      exact h
    · have h := leC_sound hc2 hQlt
      rw [lane_and_ns hr hQlt hQb, lane_and_ns hr hQlt hQb, lane_shiftRight,
        show 2^r + Q = P from by rw [hPQ, Nat.add_comm, add_two_pow_eq_or hQb],
        lane_addONEV hXH hP] at h
      exact h
  · rw [hRdef]
    have hb := leC_sound hc3 hP
    rw [add_lane (fun i => lane_bcast_le hYH hr) P, lane_bcast hr hP, lane_ONEV hP,
      lane_or] at hb
    by_cases hU : lane (unionU tp tnw lst n) P = 0
    · left
      rw [hU, Nat.or_zero] at hb
      exact hb
    · right
      obtain ⟨s, hs1, hs2, hs3, hcov⟩ := unionU_spec tp tnw lst n P hP hU
      refine ⟨s, hs1, ?_, ?_, ?_⟩
      · refine cov_pos (t := t) (patMask_lt s) hw ?_
        rwa [hposmod _ (patMask_lt s)] at hcov
      · show patE2 s + patE3 s + 2 ≤ t + 1
        omega
      · show ((t+1) + patE2 s + patE3 s) % 2 = 0
        omega

/-- Convert the inequalities for stored entries into inequalities for `vAt`. -/
theorem bell_of_chk {t tp tnw nd lst n : Nat}
    (hmod : tp % 14 = t % 14)
    (hneed : t % 2 = 0 → 12 ≤ t → nd ≠ 0)
    (htn : tnw ≤ t + 1) (hpar : (t+1) % 2 = tnw % 2)
    (hchk : rowChk nd tp tnw lst n (rowP t) (rowP (t+1)) = true)
    (w : Nat) (hw : w < 16384) :
    (t % 2 = 0 → 12 ≤ t → 16 ≤ vAt t w) ∧
    vAt (t+1) (w >>> 1) ≤ vAt t w + 1 ∧
    (vAt (t+1) ((w >>> 1) ||| 8192) + 1 ≤ vAt t w ∨
      ∃ k, k < nPats ∧ PatOK (pats k) ∧ RejectsAt (pats k) (t+1) w) := by
  obtain ⟨h1, h2, h3⟩ := bell_of_rowChk hmod hneed htn hpar hchk hw
  have hw1 : w >>> 1 < 16384 := by rw [Nat.shiftRight_eq_div_pow]; omega
  have hw2 : (w >>> 1) ||| 8192 < 16384 := Nat.or_lt_two_pow (n := 14) hw1 (by norm_num)
  simp only [vAt_eq hw, vAt_eq hw1, vAt_eq hw2]
  refine ⟨fun he h12 => by have := h1 he h12; omega, by omega, ?_⟩
  rcases h3 with h | h
  · exact Or.inl (by omega)
  · obtain ⟨k, hk, hrej⟩ := h
    exact Or.inr ⟨k, hk, pats_ok k hk, hrej⟩

/-- From time `25`, the tables repeat with period fourteen. -/
theorem rowP_steady {t : Nat} (ht : 25 ≤ t) : rowP t = stabr (t % 14) := by
  have h : Nat.ble t 24 = false := by
    simp only [Bool.eq_false_iff, ne_eq, Nat.ble_eq]; omega
  simp only [rowP, h, cond_false]

theorem hbell : BellHyp vAt pats nPats := by
  intro t w hw
  by_cases ht : t ≤ 24
  · interval_cases t
    · exact bell_of_chk (by decide) (by decide) (by decide) (by decide) chk_0 w hw
    · exact bell_of_chk (by decide) (by decide) (by decide) (by decide) chk_1 w hw
    · exact bell_of_chk (by decide) (by decide) (by decide) (by decide) chk_2 w hw
    · exact bell_of_chk (by decide) (by decide) (by decide) (by decide) chk_3 w hw
    · exact bell_of_chk (by decide) (by decide) (by decide) (by decide) chk_4 w hw
    · exact bell_of_chk (by decide) (by decide) (by decide) (by decide) chk_5 w hw
    · exact bell_of_chk (by decide) (by decide) (by decide) (by decide) chk_6 w hw
    · exact bell_of_chk (by decide) (by decide) (by decide) (by decide) chk_7 w hw
    · exact bell_of_chk (by decide) (by decide) (by decide) (by decide) chk_8 w hw
    · exact bell_of_chk (by decide) (by decide) (by decide) (by decide) chk_9 w hw
    · exact bell_of_chk (by decide) (by decide) (by decide) (by decide) chk_10 w hw
    · exact bell_of_chk (by decide) (by decide) (by decide) (by decide) chk_11 w hw
    · exact bell_of_chk (by decide) (by decide) (by decide) (by decide) chk_12 w hw
    · exact bell_of_chk (by decide) (by decide) (by decide) (by decide) chk_13 w hw
    · exact bell_of_chk (by decide) (by decide) (by decide) (by decide) chk_14 w hw
    · exact bell_of_chk (by decide) (by decide) (by decide) (by decide) chk_15 w hw
    · exact bell_of_chk (by decide) (by decide) (by decide) (by decide) chk_16 w hw
    · exact bell_of_chk (by decide) (by decide) (by decide) (by decide) chk_17 w hw
    · exact bell_of_chk (by decide) (by decide) (by decide) (by decide) chk_18 w hw
    · exact bell_of_chk (by decide) (by decide) (by decide) (by decide) chk_19 w hw
    · exact bell_of_chk (by decide) (by decide) (by decide) (by decide) chk_20 w hw
    · exact bell_of_chk (by decide) (by decide) (by decide) (by decide) chk_21 w hw
    · exact bell_of_chk (by decide) (by decide) (by decide) (by decide) chk_22 w hw
    · exact bell_of_chk (by decide) (by decide) (by decide) (by decide) chk_23 w hw
    · exact bell_of_chk (by decide) (by decide) (by decide) (by decide) chk_24 w hw
  · have h25 : 25 ≤ t := by omega
    have hrow : rowP t = stabr (t % 14) := rowP_steady h25
    have hrow' : rowP (t+1) = stabr ((t % 14 + 1) % 14) := by
      rw [rowP_steady (by omega), show (t+1) % 14 = (t % 14 + 1) % 14 from by omega]
    have hj : t % 14 < 14 := Nat.mod_lt _ (by norm_num)
    interval_cases h : (t % 14)
    · refine bell_of_chk ?_ ?_ ?_ ?_ (by rw [hrow, hrow']; exact chks_0) w hw <;> omega
    · refine bell_of_chk ?_ ?_ ?_ ?_ (by rw [hrow, hrow']; exact chks_1) w hw <;> omega
    · refine bell_of_chk ?_ ?_ ?_ ?_ (by rw [hrow, hrow']; exact chks_2) w hw <;> omega
    · refine bell_of_chk ?_ ?_ ?_ ?_ (by rw [hrow, hrow']; exact chks_3) w hw <;> omega
    · refine bell_of_chk ?_ ?_ ?_ ?_ (by rw [hrow, hrow']; exact chks_4) w hw <;> omega
    · refine bell_of_chk ?_ ?_ ?_ ?_ (by rw [hrow, hrow']; exact chks_5) w hw <;> omega
    · refine bell_of_chk ?_ ?_ ?_ ?_ (by rw [hrow, hrow']; exact chks_6) w hw <;> omega
    · refine bell_of_chk ?_ ?_ ?_ ?_ (by rw [hrow, hrow']; exact chks_7) w hw <;> omega
    · refine bell_of_chk ?_ ?_ ?_ ?_ (by rw [hrow, hrow']; exact chks_8) w hw <;> omega
    · refine bell_of_chk ?_ ?_ ?_ ?_ (by rw [hrow, hrow']; exact chks_9) w hw <;> omega
    · refine bell_of_chk ?_ ?_ ?_ ?_ (by rw [hrow, hrow']; exact chks_10) w hw <;> omega
    · refine bell_of_chk ?_ ?_ ?_ ?_ (by rw [hrow, hrow']; exact chks_11) w hw <;> omega
    · refine bell_of_chk ?_ ?_ ?_ ?_ (by rw [hrow, hrow']; exact chks_12) w hw <;> omega
    · refine bell_of_chk ?_ ?_ ?_ ?_ (by rw [hrow, hrow']; exact chks_13) w hw <;> omega

/-- The checked tables satisfy `PotentialSound`. -/
theorem hpot : PotentialSound vAt :=
  bellman_to_potential vAt pats nPats hbell

/-- Every `SumFree4` sequence agreeing with `σ` has no counterexample at or after its time. -/
def NoBadFrom (σ : St) : Prop :=
  ∀ d : Nat → Bool, SumFree4 d → Consistent d σ → ¬ Bad tMax d σ

/-- An accepted search from `σ` proves `NoBadFrom σ`, provided this is
already proved for every state in `cut`. -/
theorem piece_of_replay (σ : St) (tr : List Nat) (cut : List St) (fuel : Nat)
    (hcut : ∀ τ ∈ cut, NoBadFrom τ)
    (hrun : replay tMax vAt cut fuel 1 tr [σ] = true) : NoBadFrom σ := fun d hd hc =>
  replay_sound tMax vAt cut (by decide) hpot d hd
    (fun τ hτ hcτ => hcut τ hτ d hd hcτ) fuel 1 tr [σ] hrun σ (List.mem_singleton_self σ) hc


/-! ## Checking the recorded search -/

section
set_option maxHeartbeats 0
set_option Elab.async false

theorem piece0 : NoBadFrom (0, 0, 0x0, 4000) :=
  piece_of_replay _ trc [] 3022 nofun (by decide +kernel)

end

/-- No `SumFree4` sequence reaches surplus `8` at an even time
`12 ≤ u ≤ 216`. -/
theorem no_heavy :
    ∀ d : Nat → Bool, d 0 = false → SumFree4 d →
      ∀ u : Nat, u % 2 = 0 → 12 ≤ u → u ≤ 216 → surplus d u < 8 := by
  intro d h0 hd u h2 h12 hu
  have hw : window d 0 = 0 := by
    apply Nat.eq_of_testBit_eq
    intro i
    rw [window_testBit, Nat.zero_testBit]
    rcases Nat.lt_trichotomy i 13 with h | h | h
    · rw [decide_eq_false (show ¬ (14 ≤ 0 + i + 1) by omega)]; simp
    · subst h; simp [h0]
    · rw [decide_eq_false (show ¬ (i < 14) by omega)]; simp
  have ha : ∀ s : Nat, (0 : Nat).testBit s
      = (decide (1 ≤ s) && decide (s ≤ 0) && d s) := by
    intro s
    rw [Nat.zero_testBit]
    rcases Nat.eq_zero_or_pos s with h | h
    · subst h; simp
    · have hh : ¬ (s ≤ 0) := by omega
      simp [hh]
  have hcons : Consistent d (0, 0, 0, 4000) := by
    refine ⟨hw.symm, ha, ?_⟩
    show ((4000 : Nat) : Int) = surplus d 0 + 4000
    show ((4000 : Nat) : Int) = (0 : Int) + 4000
    decide
  have hnbad := piece0 d hd hcons
  have hkey : ¬ ((4008 : Int) ≤ surplus d u + 4000) := fun hle =>
    hnbad ⟨u, Nat.zero_le u, hu, h2, h12, hle⟩
  omega

-- Relate membership sequences to finite sets.

/-- The membership function of `A` on the natural numbers. -/
def ind (A : Finset ℤ) : Nat → Bool := fun s => decide ((s : ℤ) ∈ A)

/- The surplus is twice the number of selected integers in `[1, t]`, minus `t`. -/
private lemma surplus_ind_gen (A : Finset ℤ) (t : ℕ) :
    surplus (ind A) t
      = 2 * (((Icc (1 : ℤ) (t : ℤ)).filter (· ∈ A)).card : Int) - t := by
  classical
  induction t with
  | zero => simp [surplus]
  | succ k ih =>
    have hIcc : Icc (1 : ℤ) ((k+1 : ℕ) : ℤ) = insert ((k:ℤ)+1) (Icc (1:ℤ) (k:ℤ)) := by
      ext x
      simp only [Finset.mem_Icc, Finset.mem_insert]
      push_cast
      omega
    have hnot : ((k:ℤ)+1) ∉ Icc (1:ℤ) (k:ℤ) := by
      simp only [Finset.mem_Icc]
      omega
    have hstep : surplus (ind A) (k+1)
        = surplus (ind A) k + (if ind A (k+1) = true then 1 else -1) := rfl
    have hind : ind A (k+1) = true ↔ ((k:ℤ)+1) ∈ A := by simp [ind]
    rw [hstep, ih, hIcc, Finset.filter_insert]
    by_cases hmem : ((k:ℤ)+1) ∈ A
    · rw [if_pos hmem, if_pos (hind.mpr hmem),
        Finset.card_insert_of_notMem (fun hx => hnot (Finset.mem_of_mem_filter _ hx))]
      push_cast
      ring
    · rw [if_neg hmem, if_neg (fun h => hmem (hind.mp h))]
      push_cast
      ring

theorem surplus_ind (A : Finset ℤ) (n : ℕ) (hA : A ⊆ Icc (1 : ℤ) (2 * ↑n)) :
    surplus (ind A) (2 * n) = 2 * (A.card : Int) - 2 * n := by
  classical
  rw [surplus_ind_gen, Finset.filter_mem_eq_inter, Finset.inter_eq_right.mpr (by
    simpa using hA)]
  push_cast
  ring

/- A failure of `SumFree4` gives the required four positive integers. -/
theorem hasPos_of_not_sumFree (A : Finset ℤ) (h : ¬ SumFree4 (ind A)) :
    HasPosPairwiseSums A 4 := by
  unfold SumFree4 at h
  push_neg at h
  obtain ⟨b1, b2, b3, b4, hb1, h12, h23, h34, s12, s13, s14, s23, s24, s34⟩ := h
  have hmem : ∀ x y : ℕ, ind A (x + y) = true → ((x:ℤ) + (y:ℤ)) ∈ A := by
    intro x y hxy
    have := of_decide_eq_true hxy
    push_cast at this
    exact this
  exact hasPPS_of_quad (by omega) (by omega) (by omega) (by omega)
    (by omega) (by omega) (by omega) (by omega) (by omega) (by omega)
    (hmem _ _ s12) (hmem _ _ s13) (hmem _ _ s14)
    (hmem _ _ s23) (hmem _ _ s24) (hmem _ _ s34)

/- Apply the finite verification to the membership function of `A`
to obtain `hFun 4 n ≤ 4` for `6 ≤ n ≤ 108`. -/
theorem h4_le_4_small
    (H : ∀ d : Nat → Bool, d 0 = false → SumFree4 d →
         ∀ u : Nat, u % 2 = 0 → 12 ≤ u → u ≤ 216 → surplus d u < 8)
    (n : ℕ) (h6 : 6 ≤ n) (h108 : n ≤ 108) :
    hFun 4 n ≤ 4 := by
  refine Nat.sInf_le (fun A hA hcard => ?_)
  by_contra hno
  have h0 : ind A 0 = false := by
    simp only [ind, decide_eq_false_iff_not]
    intro h0
    have := hA h0
    simp only [Finset.mem_Icc] at this
    omega
  have hlt := H (ind A) h0 (fun b1 b2 b3 b4 hb1 h12 h23 h34 hq =>
    hno (hasPos_of_not_sumFree A (fun hsf => hsf b1 b2 b3 b4 hb1 h12 h23 h34 hq)))
    (2 * n) (by omega) (by omega) (by omega)
  rw [surplus_ind A n hA] at hlt
  omega

end FiniteCheck

/-! ### The lower bound -/

/-- The odd integers in `[1, 2n]`, together with `2`, `2n - 2`, and `2n`. -/
def H4Witness (n : ℕ) : Finset ℤ :=
  (Icc (1 : ℤ) (2 * (n : ℤ))).filter
    (fun x => x % 2 = 1 ∨ x = 2 ∨ x = 2 * (n : ℤ) - 2 ∨ x = 2 * (n : ℤ))

lemma H4Witness_subset (n : ℕ) : H4Witness n ⊆ Icc (1 : ℤ) (2 * (n : ℤ)) :=
  Finset.filter_subset _ _

lemma H4Witness_card (n : ℕ) (hn : 3 ≤ n) : (H4Witness n).card = n + 3 := by
  have hset : H4Witness n
      = (Finset.range n).image (fun a : ℕ => (2 * (a : ℤ) + 1))
        ∪ {(2 : ℤ), 2 * (n : ℤ) - 2, 2 * (n : ℤ)} := by
    ext x
    simp only [H4Witness, Finset.mem_filter, Finset.mem_Icc, Finset.mem_union,
      Finset.mem_image, Finset.mem_range, Finset.mem_insert, Finset.mem_singleton]
    constructor
    · rintro ⟨⟨h1, h2⟩, h3 | h3 | h3 | h3⟩
      · exact Or.inl ⟨(x / 2).toNat, by omega, by omega⟩
      · exact Or.inr (Or.inl h3)
      · exact Or.inr (Or.inr (Or.inl h3))
      · exact Or.inr (Or.inr (Or.inr h3))
    · rintro (⟨a, ha, rfl⟩ | rfl | rfl | rfl)
      · exact ⟨⟨by omega, by omega⟩, Or.inl (by omega)⟩
      · exact ⟨⟨by omega, by omega⟩, Or.inr (Or.inl rfl)⟩
      · exact ⟨⟨by omega, by omega⟩, Or.inr (Or.inr (Or.inl rfl))⟩
      · exact ⟨⟨by omega, by omega⟩, Or.inr (Or.inr (Or.inr rfl))⟩
  have hinj : Function.Injective (fun a : ℕ => (2 * (a : ℤ) + 1)) := by
    intro a b hab
    dsimp only at hab
    omega
  have hdisj : Disjoint ((Finset.range n).image (fun a : ℕ => (2 * (a : ℤ) + 1)))
      ({(2 : ℤ), 2 * (n : ℤ) - 2, 2 * (n : ℤ)} : Finset ℤ) := by
    rw [Finset.disjoint_left]
    intro x hx hx'
    simp only [Finset.mem_image, Finset.mem_range] at hx
    simp only [Finset.mem_insert, Finset.mem_singleton] at hx'
    obtain ⟨a, _, rfl⟩ := hx
    rcases hx' with h | h | h <;> omega
  have htriple : ({(2 : ℤ), 2 * (n : ℤ) - 2, 2 * (n : ℤ)} : Finset ℤ).card = 3 :=
    Finset.card_eq_three.mpr
      ⟨2, 2 * (n : ℤ) - 2, 2 * (n : ℤ), by omega, by omega, by omega, rfl⟩
  rw [hset, Finset.card_union_of_disjoint hdisj,
    Finset.card_image_of_injective _ hinj, Finset.card_range, htriple]

/-- This set does not contain all six pairwise sums of four distinct
positive integers. -/
lemma H4Witness_no_pps (n : ℕ) : ¬ HasPosPairwiseSums (H4Witness n) 4 := by
  rintro ⟨b, hinj, hpos, hsum⟩
  have hne : ∀ i j : Fin 4, i ≠ j → b i ≠ b j := fun i j h he => h (hinj he)
  -- Each pairwise sum is odd or equals `2n - 2` or `2n`.
  -- A sum of distinct positive integers cannot equal `2`.
  have mem : ∀ i j : Fin 4, i ≠ j → b i + b j ≤ 2 * (n : ℤ) ∧
      ((b i + b j) % 2 = 1 ∨ b i + b j = 2 * (n : ℤ) - 2 ∨ b i + b j = 2 * (n : ℤ)) := by
    have main : ∀ i j : Fin 4, i < j → b i + b j ≤ 2 * (n : ℤ) ∧
        ((b i + b j) % 2 = 1 ∨ b i + b j = 2 * (n : ℤ) - 2 ∨ b i + b j = 2 * (n : ℤ)) := by
      intro i j hij
      have hm := hsum i j hij
      simp only [H4Witness, Finset.mem_filter, Finset.mem_Icc] at hm
      have h1 := hpos i
      have h2 := hpos j
      have h3 := hne i j (ne_of_lt hij)
      exact ⟨hm.1.2, by rcases hm.2 with h | h | h | h <;> omega⟩
    intro i j hij
    rcases lt_or_gt_of_ne hij with h | h
    · exact main i j h
    · rw [add_comm]; exact main j i h
  -- Each even sum equals `2n - 2` or `2n`.
  have evensum : ∀ i j : Fin 4, i ≠ j → b i % 2 = b j % 2 →
      b i + b j = 2 * (n : ℤ) - 2 ∨ b i + b j = 2 * (n : ℤ) := by
    intro i j hij hp
    have := mem i j hij
    omega
  -- Three integers of the same parity give three distinct even sums,
  -- but only two even sums are available.
  have three : ∀ i j k : Fin 4, i ≠ j → i ≠ k → j ≠ k →
      b i % 2 = b j % 2 → b j % 2 = b k % 2 → False := by
    intro i j k h1 h2 h3 e1 e2
    have a1 := evensum i j h1 e1
    have a2 := evensum i k h2 (e1.trans e2)
    have a3 := evensum j k h3 e2
    have d1 := hne i j h1
    have d2 := hne i k h2
    have d3 := hne j k h3
    omega
  -- If two integers have each parity, each pair has a member at least `n`.
  -- The two larger members have an odd sum greater than `2n`.
  have twotwo : ∀ i j k l : Fin 4, i ≠ j → k ≠ l → i ≠ k → i ≠ l → j ≠ k → j ≠ l →
      b i % 2 = b j % 2 → b k % 2 = b l % 2 → b i % 2 ≠ b k % 2 → False := by
    intro i j k l h1 h2 h3 h4 h5 h6 e1 e2 e3
    have a1 := evensum i j h1 e1
    have a2 := evensum k l h2 e2
    have a3 := (mem i k h3).1
    have a4 := (mem i l h4).1
    have a5 := (mem j k h5).1
    have a6 := (mem j l h6).1
    have d1 := hne i j h1
    have d2 := hne k l h2
    have hij : (n : ℤ) ≤ b i ∨ (n : ℤ) ≤ b j := by omega
    have hkl : (n : ℤ) ≤ b k ∨ (n : ℤ) ≤ b l := by omega
    clear a1 a2 d1 d2
    rcases hij with hI | hI <;> rcases hkl with hK | hK <;> omega
  have p0 : b 0 % 2 = 0 ∨ b 0 % 2 = 1 := by omega
  have p1 : b 1 % 2 = 0 ∨ b 1 % 2 = 1 := by omega
  have p2 : b 2 % 2 = 0 ∨ b 2 % 2 = 1 := by omega
  have p3 : b 3 % 2 = 0 ∨ b 3 % 2 = 1 := by omega
  rcases p0 with h0 | h0 <;> rcases p1 with h1 | h1 <;> rcases p2 with h2 | h2 <;>
    rcases p3 with h3 | h3
  · exact three 0 1 2 (by decide) (by decide) (by decide) (by omega) (by omega)
  · exact three 0 1 2 (by decide) (by decide) (by decide) (by omega) (by omega)
  · exact three 0 1 3 (by decide) (by decide) (by decide) (by omega) (by omega)
  · exact twotwo 0 1 2 3 (by decide) (by decide) (by decide) (by decide)
      (by decide) (by decide) (by omega) (by omega) (by omega)
  · exact three 0 2 3 (by decide) (by decide) (by decide) (by omega) (by omega)
  · exact twotwo 0 2 1 3 (by decide) (by decide) (by decide) (by decide)
      (by decide) (by decide) (by omega) (by omega) (by omega)
  · exact twotwo 0 3 1 2 (by decide) (by decide) (by decide) (by decide)
      (by decide) (by decide) (by omega) (by omega) (by omega)
  · exact three 1 2 3 (by decide) (by decide) (by decide) (by omega) (by omega)
  · exact three 1 2 3 (by decide) (by decide) (by decide) (by omega) (by omega)
  · exact twotwo 0 3 1 2 (by decide) (by decide) (by decide) (by decide)
      (by decide) (by decide) (by omega) (by omega) (by omega)
  · exact twotwo 0 2 1 3 (by decide) (by decide) (by decide) (by decide)
      (by decide) (by decide) (by omega) (by omega) (by omega)
  · exact three 0 2 3 (by decide) (by decide) (by decide) (by omega) (by omega)
  · exact twotwo 0 1 2 3 (by decide) (by decide) (by decide) (by decide)
      (by decide) (by decide) (by omega) (by omega) (by omega)
  · exact three 0 1 3 (by decide) (by decide) (by decide) (by omega) (by omega)
  · exact three 0 1 2 (by decide) (by decide) (by decide) (by omega) (by omega)
  · exact three 0 1 2 (by decide) (by decide) (by decide) (by omega) (by omega)

/-- `h₄(n) ≥ 4` for every `n ≥ 3`. -/
theorem four_le_hFun_four (n : ℕ) (hn : 3 ≤ n) : 4 ≤ hFun 4 n := by
  unfold hFun
  apply le_csInf
  · refine ⟨2 * n + 1, fun A hA hcard => absurd hcard (not_le.mpr ?_)⟩
    have h1 := Finset.card_le_card hA
    have h2 : (Finset.Icc (1 : ℤ) (2 * (n : ℤ))).card = 2 * n := by
      rw [Int.card_Icc]; omega
    omega
  · intro m hm
    by_contra hcon
    push_neg at hcon
    refine H4Witness_no_pps n (hm (H4Witness n) (H4Witness_subset n) ?_)
    rw [H4Witness_card n hn]
    omega

/-! ### The final theorem -/

/-- `h₄(n) ≤ 4` for `6 ≤ n ≤ 108`, by the finite verification. -/
theorem h4_le_4_finiteLeg (n : ℕ) (h6 : 6 ≤ n) (h108 : n ≤ 108) :
    hFun 4 n ≤ 4 :=
  FiniteCheck.h4_le_4_small FiniteCheck.no_heavy n h6 h108

/-- `h₄(n) ≤ 4` for every `n ≥ 6`. -/
theorem h4_le_4_all (n : ℕ) (hn : 6 ≤ n) : hFun 4 n ≤ 4 := by
  by_cases hsmall : n ≤ 108
  · exact h4_le_4_finiteLeg n hn hsmall
  · exact h4_le_4_of_ge_109 n (by omega)

/-- `h₄(n) = 4` for every `n ≥ 6`. -/
theorem main (n : ℕ) (hn : 6 ≤ n) : hFun 4 n = 4 :=
  le_antisymm (h4_le_4_all n hn) (four_le_hFun_four n (by omega))

#print axioms main

/-- A version of `h₄(n) ≤ 4` which does not use any definitions. -/
theorem main_explicit (n : ℕ) (hn : 6 ≤ n) (A : Finset ℤ)
    (hA : A ⊆ Finset.Icc (1 : ℤ) (2 * n))
    (hcard : n + 4 ≤ A.card) :
    ∃ b₁ b₂ b₃ b₄ : ℤ,
      0 < b₁ ∧ 0 < b₂ ∧ 0 < b₃ ∧ 0 < b₄ ∧
      b₁ ≠ b₂ ∧ b₁ ≠ b₃ ∧ b₁ ≠ b₄ ∧
      b₂ ≠ b₃ ∧ b₂ ≠ b₄ ∧ b₃ ≠ b₄ ∧
      b₁ + b₂ ∈ A ∧ b₁ + b₃ ∈ A ∧ b₁ + b₄ ∈ A ∧
      b₂ + b₃ ∈ A ∧ b₂ + b₄ ∈ A ∧ b₃ + b₄ ∈ A := by
  classical
  let S : Set ℕ :=
    {m | ∀ B : Finset ℤ,
      B ⊆ Finset.Icc (1 : ℤ) (2 * n) →
      n + m ≤ B.card → HasPosPairwiseSums B 4}
  have hmain : sInf S = 4 := by
    simpa only [hFun, S] using main n hn
  have hSne : S.Nonempty := by
    by_contra h
    have hS : S = ∅ := Set.not_nonempty_iff_eq_empty.mp h
    rw [hS] at hmain
    simp at hmain
  have hmin : (4 : ℕ) ∈ S := by
    rw [← hmain]
    exact Nat.sInf_mem hSne
  obtain ⟨b, hinj, hpos, hsums⟩ := hmin A hA hcard
  have hne : ∀ i j : Fin 4, i ≠ j → b i ≠ b j :=
    fun i j hij hbij => hij (hinj hbij)
  exact ⟨b 0, b 1, b 2, b 3,
    hpos 0, hpos 1, hpos 2, hpos 3,
    hne 0 1 (by decide), hne 0 2 (by decide),
    hne 0 3 (by decide), hne 1 2 (by decide),
    hne 1 3 (by decide), hne 2 3 (by decide),
    hsums 0 1 (by decide), hsums 0 2 (by decide),
    hsums 0 3 (by decide), hsums 1 2 (by decide),
    hsums 1 3 (by decide), hsums 2 3 (by decide)⟩
