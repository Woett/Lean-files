          · exact h
          · exact absurd ⟨x, h⟩ hTOPne
        have : (E.card : ℤ) ≤ (LOW.card : ℤ) := by
          exact_mod_cast Finset.card_le_card hEsub
        omega
  obtain ⟨b, hinj, hpos, hsums⟩ := h4'
  exact ⟨b, hinj, hpos, fun i j hij => hA'sub (hsums i j hij)⟩

/-! ### Finite verification for `6 ≤ n ≤ 108` -/

namespace FiniteCheck

/-! ## Encoding subsets of the positive integers

The function `d` records membership. The value `surplus d t` is the number
of selected integers minus the number of unselected integers in `[1, t]`.
The value `window d t` records membership of the last fourteen integers;
bit `j` corresponds to `t - 13 + j`, with nonpositive integers omitted.
The predicate `SumFree4 d` excludes the six pairwise sums of four distinct
positive integers.
-/

def surplus (d : Nat → Bool) : Nat → Int
  | 0 => 0
  | t+1 => surplus d t + (if d (t+1) = true then 1 else -1)

def window (d : Nat → Bool) (t : Nat) : Nat :=
  (List.range 14).foldl
    (fun w j => if 14 ≤ t + j + 1 && d (t + j - 13) then w ||| (1 <<< j) else w) 0

def SumFree4 (d : Nat → Bool) : Prop :=
  ∀ b1 b2 b3 b4 : Nat, 1 ≤ b1 → b1 < b2 → b2 < b3 → b3 < b4 →
    ¬ (d (b1+b2) = true ∧ d (b1+b3) = true ∧ d (b1+b4) = true ∧
       d (b2+b3) = true ∧ d (b2+b4) = true ∧ d (b3+b4) = true)

/-- If all six listed positions are selected, set `x = (tn - e2 - e3) / 2`.
The bounds and parity condition give four distinct positive integers
`x`, `x + e1`, `x + e2`, `x + e3` whose pairwise sums are selected. -/
theorem pattern_rejects (d : Nat → Bool) (e1 e2 e3 tn : Nat)
    (h1 : 0 < e1) (h12 : e1 < e2) (h23 : e2 < e3)
    (hpos : e2 + e3 + 2 ≤ tn) (hpar : (tn + e2 + e3) % 2 = 0)
    (g0 : d tn = true)
    (g1 : d (tn - (e2 - e1)) = true)
    (g2 : d (tn - (e3 - e1)) = true)
    (g3 : d (tn - e2) = true)
    (g4 : d (tn - e3) = true)
    (g5 : d (tn - (e2 + e3 - e1)) = true) :
    ¬ SumFree4 d := by
  intro h
  refine h ((tn-e2-e3)/2) ((tn-e2-e3)/2+e1) ((tn-e2-e3)/2+e2) ((tn-e2-e3)/2+e3)
    (by omega) (by omega) (by omega) (by omega) ⟨?_,?_,?_,?_,?_,?_⟩
  · rw [show (tn-e2-e3)/2 + ((tn-e2-e3)/2+e1) = tn - (e2+e3-e1) by omega]; exact g5
  · rw [show (tn-e2-e3)/2 + ((tn-e2-e3)/2+e2) = tn - e3 by omega]; exact g4
  · rw [show (tn-e2-e3)/2 + ((tn-e2-e3)/2+e3) = tn - e2 by omega]; exact g3
  · rw [show ((tn-e2-e3)/2+e1) + ((tn-e2-e3)/2+e2) = tn - (e3-e1) by omega]; exact g2
  · rw [show ((tn-e2-e3)/2+e1) + ((tn-e2-e3)/2+e3) = tn - (e2-e1) by omega]; exact g1
  · rw [show ((tn-e2-e3)/2+e2) + ((tn-e2-e3)/2+e3) = tn by omega]; exact g0

/-- Bit `k` of the accumulated value is set exactly when `k < n` and `g k = true`. -/
theorem foldl_or_testBit (n : Nat) (g : Nat → Bool) (k : Nat) :
    ((List.range n).foldl (fun w j => if g j then w ||| (1 <<< j) else w) 0).testBit k
      = (decide (k < n) && g k) := by
  induction n with
  | zero => simp
  | succ m ih =>
    rw [List.range_succ, List.foldl_append]
    show (if g m then _ ||| (1 <<< m) else _).testBit k = _
    by_cases hg : g m
    · rw [if_pos hg, Nat.testBit_or, ih, Nat.one_shiftLeft, Nat.testBit_two_pow]
      rcases Nat.lt_trichotomy k m with h | h | h
      · have e1 : ¬ m = k := by omega
        have e2 : k < m + 1 := by omega
        simp [h, e1, e2]
      · subst h; simp [hg]
      · have e1 : ¬ k < m := by omega
        have e2 : ¬ k < m + 1 := by omega
        have e3 : ¬ m = k := by omega
        simp [e1, e2, e3]
    · rw [if_neg hg, ih]
      have hg' : g m = false := by simp [hg]
      rcases Nat.lt_trichotomy k m with h | h | h
      · simp [h, Nat.lt_succ_of_lt h]
      · subst h; simp [hg']
      · have e1 : ¬ k < m := by omega
        have e2 : ¬ k < m + 1 := by omega
        simp [e1, e2]

/-- Express bit `k` of the window in terms of membership. -/
theorem window_testBit (d : Nat → Bool) (t k : Nat) :
    (window d t).testBit k
      = (decide (k < 14) && (14 ≤ t + k + 1 && d (t + k - 13))) := by
  unfold window
  exact foldl_or_testBit 14 (fun j => 14 ≤ t + j + 1 && d (t + j - 13)) k

/-- Move the window one step: shift right and set bit `13` if `t + 1`
is selected. -/
theorem window_succ (d : Nat → Bool) (t : Nat) :
    window d (t+1) = ((window d t) >>> 1) ||| (if d (t+1) then 8192 else 0) := by
  apply Nat.eq_of_testBit_eq
  intro i
  rw [Nat.testBit_or, Nat.testBit_shiftRight, window_testBit, window_testBit]
  have key : (8192:Nat) = 2^13 := by decide
  by_cases hb : d (t+1)
  · rw [if_pos hb, key, Nat.testBit_two_pow]
    rcases Nat.lt_trichotomy i 13 with h | h | h
    · have a1 : (t+1)+i-13 = t+(1+i)-13 := by omega
      have a2 : (t+1)+i+1 = t+(1+i)+1 := by omega
      rw [a1, a2]
      have hne13 : ¬ (13 = i) := by omega
      simp [show i < 14 by omega, show 1 + i < 14 by omega, hne13]
    · subst h; simp [hb]
    · have hi14 : ¬ i < 14 := by omega
      have hi114 : ¬ 1 + i < 14 := by omega
      have hne13 : ¬ (13 = i) := by omega
      simp [hi14, hi114, hne13]
  · rw [if_neg hb]
    have hb' : d (t+1) = false := by simp [hb]
    rcases Nat.lt_trichotomy i 13 with h | h | h
    · have a1 : (t+1)+i-13 = t+(1+i)-13 := by omega
      have a2 : (t+1)+i+1 = t+(1+i)+1 := by omega
      rw [a1, a2]
      simp [show i < 14 by omega, show 1 + i < 14 by omega]
    · subst h; simp [hb']
    · have hi14 : ¬ i < 14 := by omega
      have hi114 : ¬ 1 + i < 14 := by omega
      simp [hi14, hi114]

/-- The step inequalities make `surplus d t + V t (window d t)`
nonincreasing. If `V ≥ 16` at every even `u ≥ 12`, then
`surplus d u + 16 ≤ surplus d t + V t (window d t)` for every such `u ≥ t`. -/
theorem potential_telescope
    (V : Nat → Nat → Nat) (d : Nat → Bool)
    (hexc : ∀ t, d (t+1) = false →
        V (t+1) (window d (t+1)) ≤ V t (window d t) + 1)
    (hinc : ∀ t, d (t+1) = true →
        V (t+1) (window d (t+1)) + 1 ≤ V t (window d t))
    (hstop : ∀ t, t % 2 = 0 → 12 ≤ t → 16 ≤ V t (window d t)) :
    ∀ t u, t ≤ u → u % 2 = 0 → 12 ≤ u →
      surplus d u + 16 ≤ surplus d t + (V t (window d t) : Int) := by
  have step : ∀ s, surplus d (s+1) + (V (s+1) (window d (s+1)) : Int)
      ≤ surplus d s + (V s (window d s) : Int) := by
    intro s
    have hs : surplus d (s+1) = surplus d s + (if d (s+1) = true then 1 else -1) := rfl
    cases hd : d (s+1) with
    | false =>
      have hv := hexc s hd
      rw [hs, hd]; simp only [Bool.false_eq_true, if_false]; omega
    | true =>
      have hv := hinc s hd
      rw [hs, hd]; simp only [if_true]; omega
  have mono : ∀ n t, surplus d (t+n) + (V (t+n) (window d (t+n)) : Int)
      ≤ surplus d t + (V t (window d t) : Int) := by
    intro n
    induction n with
    | zero => intro t; simp only [Nat.add_zero]; omega
    | succ k ih =>
      intro t
      show surplus d ((t+k)+1) + (V ((t+k)+1) (window d ((t+k)+1)) : Int)
          ≤ surplus d t + (V t (window d t) : Int)
      have h1 := step (t+k)
      have h2 := ih t
      omega
  intro t u htu hu2 hu12
  have hst := hstop u hu2 hu12
  have hm := mono (u-t) t
  rw [show t+(u-t) = u by omega] at hm
  omega


/-! ## Bounds on future surplus -/

/-- The increments `e1 < e2 < e3` of four integers. The mask records the
five pairwise sums preceding the largest sum; a gap `g` uses bit `14 - g`. -/
structure Pat where
  e1 : Nat
  e2 : Nat
  e3 : Nat
  mask : Nat

/-- The increments are positive and increasing, all five gaps are at most
fourteen, and the corresponding mask bits are set. -/
def PatOK (p : Pat) : Prop :=
  0 < p.e1 ∧ p.e1 < p.e2 ∧ p.e2 < p.e3 ∧ p.e2 + p.e3 - p.e1 ≤ 14 ∧
  p.mask.testBit (14 - (p.e2 - p.e1)) = true ∧
  p.mask.testBit (14 - (p.e3 - p.e1)) = true ∧
  p.mask.testBit (14 - p.e2) = true ∧
  p.mask.testBit (14 - p.e3) = true ∧
  p.mask.testBit (14 - (p.e2 + p.e3 - p.e1)) = true

/-- The five earlier sums are selected, and the bounds and parity allow
`tn` to be the largest sum of four distinct positive integers. -/
def RejectsAt (p : Pat) (tn w : Nat) : Prop :=
  (w &&& p.mask) = p.mask ∧ p.e2 + p.e3 + 2 ≤ tn ∧ (tn + p.e2 + p.e3) % 2 = 0

/-- The step inequalities and even-time lower bound used in `potential_telescope`. -/
def PotentialSound (vAt : Nat → Nat → Nat) : Prop :=
  ∀ d : Nat → Bool, SumFree4 d →
    (∀ t, d (t+1) = false → vAt (t+1) (window d (t+1)) ≤ vAt t (window d t) + 1) ∧
    (∀ t, d (t+1) = true → vAt (t+1) (window d (t+1)) + 1 ≤ vAt t (window d t)) ∧
    (∀ t, t % 2 = 0 → 12 ≤ t → 16 ≤ vAt t (window d t))

/-- Check the bounds at every time and window. An inclusion inequality may
fail only when a pattern proves that selecting the next integer is impossible. -/
def BellHyp (vAt : Nat → Nat → Nat) (pats : Nat → Pat) (nPats : Nat) : Prop :=
  ∀ t w, w < 16384 →
    (t % 2 = 0 → 12 ≤ t → 16 ≤ vAt t w) ∧
    vAt (t+1) (w >>> 1) ≤ vAt t w + 1 ∧
    (vAt (t+1) ((w >>> 1) ||| 8192) + 1 ≤ vAt t w ∨
      ∃ k, k < nPats ∧ PatOK (pats k) ∧ RejectsAt (pats k) (t+1) w)

/-- The window has fourteen bits. -/
theorem window_lt (d : Nat → Bool) (t : Nat) : window d t < 16384 := by
  have h : (16384:Nat) = 2^14 := by decide
  rw [h]
  apply Nat.lt_pow_two_of_testBit
  intro i hi
  rw [window_testBit]
  simp [Nat.not_lt.mpr hi]

/-- If `w &&& m = m`, every set bit of `m` is set in `w`. -/
private theorem and_eq_right_bit (w m b : Nat) (hand : w &&& m = m)
    (hb : m.testBit b = true) : w.testBit b = true := by
  have h := congrArg (·.testBit b) hand
  simp only [Nat.testBit_and, hb, Bool.and_true] at h
  exact h

/-- A set bit at `14 - g` in the window implies `d (t + 1 - g) = true`. -/
private theorem window_mask_bit (d : Nat → Bool) (t g : Nat) (hg : g ≤ 14)
    (hbit : (window d t).testBit (14 - g) = true) : d (t + 1 - g) = true := by
  rw [window_testBit] at hbit
  simp only [Bool.and_eq_true, decide_eq_true_eq] at hbit
  obtain ⟨hlt, hge, hd⟩ := hbit
  have heq : t + (14 - g) - 13 = t + 1 - g := by omega
  rwa [heq] at hd

/-- A mask contained in the window gives the membership recorded by each set bit. -/
private theorem mask_gives_d (d : Nat → Bool) (t g m : Nat) (hg : g ≤ 14)
    (hand : window d t &&& m = m) (hb : m.testBit (14 - g) = true) :
    d (t + 1 - g) = true :=
  window_mask_bit d t g hg (and_eq_right_bit _ m (14 - g) hand hb)

/-- For a `SumFree4` sequence, a rejecting pattern cannot occur when the
next integer is selected. Thus the checked bounds imply `PotentialSound`. -/
theorem bellman_to_potential (vAt : Nat → Nat → Nat) (pats : Nat → Pat)
    (nPats : Nat) (hbell : BellHyp vAt pats nPats) :
    PotentialSound vAt := by
  intro d hd
  refine ⟨?_, ?_, ?_⟩
  · intro t hf
    have hb := hbell t (window d t) (window_lt d t)
    rw [window_succ, if_neg (by simp [hf]), Nat.or_zero]
    exact hb.2.1
  · intro t ht
    have hb := hbell t (window d t) (window_lt d t)
    rw [window_succ, if_pos ht]
    rcases hb.2.2 with hle | ⟨k, hk, hPatOK, hRej⟩
    · exact hle
    · exfalso
      obtain ⟨he1, he12, he23, hspan, hm1, hm2, hm3, hm4, hm5⟩ := hPatOK
      obtain ⟨hand, hpos, hpar⟩ := hRej
      exact pattern_rejects d (pats k).e1 (pats k).e2 (pats k).e3 (t + 1)
        he1 he12 he23 hpos hpar ht
        (mask_gives_d d t ((pats k).e2 - (pats k).e1) (pats k).mask (by omega) hand hm1)
        (mask_gives_d d t ((pats k).e3 - (pats k).e1) (pats k).mask (by omega) hand hm2)
        (mask_gives_d d t (pats k).e2 (pats k).mask (by omega) hand hm3)
        (mask_gives_d d t (pats k).e3 (pats k).mask (by omega) hand hm4)
        (mask_gives_d d t ((pats k).e2 + (pats k).e3 - (pats k).e1) (pats k).mask (by omega) hand hm5)
        hd
  · intro t ht h12
    have hb := hbell t (window d t) (window_lt d t)
    exact hb.1 ht h12


/-! ## Checking the search

Each state `(t, w, a, sEnc)` records `t` membership decisions, the last
fourteen decisions in `w`, all selected integers in the bits of `a`, and
`sEnc = surplus + 4000`. A counterexample has even `t ≥ 12` and `sEnc ≥ 4008`.

The checker follows the recorded search, considering inclusion before
exclusion. Each instruction has three bits; instructions recording four
integers have another forty-eight bits. Instruction `7` refers to a state
in `cut`, whose remaining search must be checked separately.
-/

/-- A search state `(t, w, a, sEnc)`. -/
abbrev St : Type := Nat × Nat × Nat × Nat

/-- The bound on future surplus is too small to reach `8`. -/
def potCut (sEnc venc : Nat) : Bool := Nat.blt (sEnc + venc) 4024

/-- At an even time `t ≥ 12`, the surplus is at least `8`. -/
def cexAt (t sEnc : Nat) : Bool :=
  Nat.ble 4008 sEnc && Nat.beq (t &&& 1) 0 && Nat.ble 12 t

/-- Four distinct positive integers have all six pairwise sums recorded
in the bits of `a`. -/
def quadOK (a b1 b2 b3 b4 : Nat) : Bool :=
  Nat.ble 1 b1 && Nat.blt b1 b2 && Nat.blt b2 b3 && Nat.blt b3 b4 &&
  (let m := (1 <<< (b1+b2)) ||| (1 <<< (b1+b3)) ||| (1 <<< (b1+b4)) |||
            (1 <<< (b2+b3)) ||| (1 <<< (b2+b4)) ||| (1 <<< (b3+b4))
   Nat.beq (a &&& m) m)

/-- Check the next search instruction. The value `c` contains the unread
bits followed by a marker bit; when `c = 1`, read the next list entry. -/
def step (tMax : Nat) (vAt : Nat → Nat → Nat) (cut : List St)
    (ih : Nat → List Nat → List St → Bool) (c : Nat) (tr : List Nat)
    (stack : List St) : Bool :=
  match stack with
  | [] => true
  | (t, w, a, sEnc) :: st =>
    bif Nat.beq c 1 then
      (match tr with
       | [] => false
       | c' :: tr' => ih c' tr' stack)
    else
    !cexAt t sEnc &&
    let tag := c &&& 7
    let c3 := c >>> 3
    let cq := c3 >>> 48
    let tn := t + 1
    let wb := w >>> 1
    let wi := wb ||| 8192
    let ai := a ||| (1 <<< tn)
    let si := sEnc + 1
    let sx := sEnc - 1
    let q := quadOK ai (c3 &&& 4095) ((c3 >>> 12) &&& 4095)
      ((c3 >>> 24) &&& 4095) ((c3 >>> 36) &&& 4095)
    bif Nat.beq tag 2 then potCut sx (vAt tn wb) && ih c3 tr ((tn, wi, ai, si) :: st)
    else bif Nat.beq tag 4 then q && ih cq tr ((tn, wb, a, sx) :: st)
    else bif Nat.beq tag 1 then ih c3 tr ((tn, wi, ai, si) :: (tn, wb, a, sx) :: st)
    else bif Nat.beq tag 3 then potCut si (vAt tn wi) && ih c3 tr ((tn, wb, a, sx) :: st)
    else bif Nat.beq tag 6 then q && potCut sx (vAt tn wb) && ih cq tr st
    else bif Nat.beq tag 0 then Nat.beq t tMax && ih c3 tr st
    else bif Nat.beq tag 7 then List.elem (t, w, a, sEnc) cut && ih c3 tr st
    else false

def replay (tMax : Nat) (vAt : Nat → Nat → Nat) (cut : List St)
    (fuel : Nat) : Nat → List Nat → List St → Bool :=
  Nat.rec (motive := fun _ => Nat → List Nat → List St → Bool) (fun _ _ _ => false)
    (fun _ ih => step tMax vAt cut ih) fuel

theorem replay_zero (tMax : Nat) (vAt : Nat → Nat → Nat) (cut : List St)
    (c : Nat) (tr : List Nat) (stack : List St) :
    replay tMax vAt cut 0 c tr stack = false := rfl

theorem replay_succ (tMax : Nat) (vAt : Nat → Nat → Nat) (cut : List St)
    (fuel c : Nat) (tr : List Nat) (stack : List St) :
    replay tMax vAt cut (fuel+1) c tr stack
      = step tMax vAt cut (replay tMax vAt cut fuel) c tr stack := rfl

/-- The state records the membership, window, and surplus of `d` through time `t`. -/
def Consistent (d : Nat → Bool) : St → Prop
  | (t, w, a, sEnc) =>
      w = window d t ∧
      (∀ s : Nat, a.testBit s = (decide (1 ≤ s) && decide (s ≤ t) && d s)) ∧
      (sEnc : Int) = surplus d t + 4000

/-- The surplus reaches at least `8` at some even `u` with `12 ≤ u` and `t ≤ u ≤ tMax`. -/
def Bad (tMax : Nat) (d : Nat → Bool) (σ : St) : Prop :=
  ∃ u, σ.1 ≤ u ∧ u ≤ tMax ∧ u % 2 = 0 ∧ 12 ≤ u ∧ (4008 : Int) ≤ surplus d u + 4000

/-- `surplus d t ≥ -t`. -/
private theorem surplus_lb (d : Nat → Bool) (t : Nat) : -(t : Int) ≤ surplus d t := by
  induction t with
  | zero => simp [surplus]
  | succ k ih =>
    have e : surplus d (k+1) = surplus d k + (if d (k+1) = true then 1 else -1) := rfl
    rw [e]; cases h : d (k+1) <;> simp only [Bool.false_eq_true, if_false, if_true] <;> omega

/-- Selecting `t + 1` preserves agreement between the state and `d`. -/
private theorem consistent_incl (d : Nat → Bool) (t w a sEnc : Nat)
    (hc : Consistent d (t, w, a, sEnc)) (ht1 : d (t+1) = true) :
    Consistent d (t+1, (w >>> 1) ||| 8192, a ||| (1 <<< (t+1)), sEnc + 1) := by
  obtain ⟨hw, ha, hs⟩ := hc
  refine ⟨?_, ?_, ?_⟩
  · rw [window_succ, if_pos ht1, hw]
  · intro s
    rw [Nat.testBit_or, ha s, Nat.one_shiftLeft, Nat.testBit_two_pow]
    by_cases hst : s ≤ t
    · have hne : ¬ (t+1 = s) := by omega
      have hle1 : s ≤ t+1 := by omega
      simp [hst, hle1, hne]
    · by_cases hst1 : s = t+1
      · subst hst1; simp [ht1]
      · have h1 : ¬ s ≤ t := hst
        have h2 : ¬ s ≤ t+1 := by omega
        have hne : ¬ (t+1 = s) := by omega
        simp [h1, h2, hne]
  · have hstep : surplus d (t+1) = surplus d t + 1 := by
      show surplus d t + (if d (t+1) = true then 1 else -1) = surplus d t + 1
      rw [ht1]; simp
    rw [hstep]; omega

/-- Omitting `t + 1` preserves agreement between the state and `d`. -/
private theorem consistent_excl (d : Nat → Bool) (t w a sEnc : Nat)
    (hc : Consistent d (t, w, a, sEnc)) (ht1 : d (t+1) = false) (hsEnc : 1 ≤ sEnc) :
    Consistent d (t+1, w >>> 1, a, sEnc - 1) := by
  obtain ⟨hw, ha, hs⟩ := hc
  refine ⟨?_, ?_, ?_⟩
  · rw [window_succ, if_neg (by simp [ht1]), Nat.or_zero, hw]
  · intro s
    rw [ha s]
    by_cases hst : s ≤ t
    · have hle1 : s ≤ t+1 := by omega
      simp [hst, hle1]
    · by_cases hst1 : s = t+1
      · subst hst1
        have hnt : ¬ (t+1 ≤ t) := by omega
        simp [ht1, hnt]
      · have h1 : ¬ s ≤ t := hst
        have h2 : ¬ s ≤ t+1 := by omega
        simp [h1, h2]
  · have hstep : surplus d (t+1) = surplus d t - 1 := by
      show surplus d t + (if d (t+1) = true then 1 else -1) = surplus d t - 1
      rw [ht1]; simp only [Bool.false_eq_true, if_false]; omega
    rw [hstep]; omega

/-- If the bits of `ai` record membership in `d`, an accepted `quadOK`
contradicts `SumFree4 d`. -/
private theorem quad_false (d : Nat → Bool) (hd : SumFree4 d) (ai b1 b2 b3 b4 : Nat)
    (hai : ∀ s, ai.testBit s = true → d s = true)
    (hq : quadOK ai b1 b2 b3 b4 = true) : False := by
  simp only [quadOK, Bool.and_eq_true, Nat.ble_eq, Nat.blt_eq, Nat.beq_eq] at hq
  obtain ⟨⟨⟨⟨h1, h12⟩, h23⟩, h34⟩, hm⟩ := hq
  have bit : ∀ p : Nat, p = b1+b2 ∨ p = b1+b3 ∨ p = b1+b4 ∨ p = b2+b3 ∨ p = b2+b4 ∨ p = b3+b4 →
      ai.testBit p = true := by
    intro p hp
    refine and_eq_right_bit _ _ p hm ?_
    rcases hp with rfl | rfl | rfl | rfl | rfl | rfl <;>
      simp [Nat.testBit_or, Nat.shiftLeft_eq, Nat.testBit_two_pow]
  exact hd b1 b2 b3 b4 h1 h12 h23 h34
    ⟨hai _ (bit _ (by tauto)), hai _ (bit _ (by tauto)), hai _ (bit _ (by tauto)),
     hai _ (bit _ (by tauto)), hai _ (bit _ (by tauto)), hai _ (bit _ (by tauto))⟩

/-- A branch discarded using the surplus bound cannot reach a counterexample. -/
private theorem potcut_false (vAt : Nat → Nat → Nat) (d : Nat → Bool)
    (hpot : PotentialSound vAt) (hd : SumFree4 d)
    (t s' : Nat) (hs' : (s' : Int) = surplus d (t+1) + 4000)
    (hcut : potCut s' (vAt (t+1) (window d (t+1))) = true)
    (u : Nat) (htu : t+1 ≤ u) (hu2 : u % 2 = 0) (hu12 : 12 ≤ u)
    (hbad : (4008 : Int) ≤ surplus d u + 4000) : False := by
  obtain ⟨hexc, hinc, hstop⟩ := hpot d hd
  have htel := potential_telescope vAt d hexc hinc hstop (t+1) u htu hu2 hu12
  simp only [potCut, Nat.blt_eq] at hcut
  omega

/-- A counterexample at time `t` would be detected by `cexAt`. -/
private theorem head_ut_cex (t sEnc : Nat) (hcex : ¬ (cexAt t sEnc = true))
    (d : Nat → Bool) (hs : (sEnc : Int) = surplus d t + 4000)
    (u : Nat) (hut : t = u) (hu2 : u % 2 = 0) (hu12 : 12 ≤ u)
    (hsurp : (4008 : Int) ≤ surplus d u + 4000) : False := by
  subst hut
  apply hcex
  have het : t &&& 1 = 0 := by rw [Nat.and_one_is_mod]; omega
  have h48 : 4008 ≤ sEnc := by omega
  simp [cexAt, Nat.ble_eq, het, h48, hu12]

/-- Excluding counterexamples at `t` and at all later times gives `¬ Bad`. -/
private theorem not_bad_head (tMax t w a sEnc : Nat) (d : Nat → Bool)
    (hs : (sEnc : Int) = surplus d t + 4000) (hcex : ¬ (cexAt t sEnc = true))
    (hnext : ∀ u, t + 1 ≤ u → u ≤ tMax → u % 2 = 0 → 12 ≤ u →
      (4008 : Int) ≤ surplus d u + 4000 → False) :
    ¬ Bad tMax d (t, w, a, sEnc) := by
  rintro ⟨u, htu, huT, hu2, hu12, hsurp⟩
  rcases Nat.eq_or_lt_of_le htu with hut | hut
  · exact head_ut_cex t sEnc hcex d hs u hut hu2 hu12 hsurp
  · exact hnext u hut huT hu2 hu12 hsurp

/-- Before the last search time, `sEnc` is positive, so subtraction by one is exact. -/
private theorem sEnc_pos (tMax t w a sEnc : Nat) (d : Nat → Bool) (htM : tMax ≤ 3998)
    (hc : Consistent d (t, w, a, sEnc)) (u : Nat) (h1 : t + 1 ≤ u) (h2 : u ≤ tMax) :
    1 ≤ sEnc ∧ t ≤ 3998 := by
  have ht : t ≤ 3998 := by omega
  have hlb := surplus_lb d t
  have hsq := hc.2.2
  exact ⟨by omega, ht⟩

/-- If the checker accepts, every `SumFree4` sequence agreeing with a state on the
stack has no counterexample between that state's time and `tMax`.
The bound `tMax ≤ 3998` prevents truncation when subtracting from `sEnc`. -/
theorem replay_sound (tMax : Nat) (vAt : Nat → Nat → Nat) (cut : List St)
    (htM : tMax ≤ 3998) (hpot : PotentialSound vAt)
    (d : Nat → Bool) (hd : SumFree4 d)
    (hcut : ∀ σ ∈ cut, Consistent d σ → ¬ Bad tMax d σ) :
    ∀ (fuel c : Nat) (tr : List Nat) (stack : List St),
      replay tMax vAt cut fuel c tr stack = true →
      ∀ σ ∈ stack, Consistent d σ → ¬ Bad tMax d σ := by
  intro fuel
  induction fuel with
  | zero => intro c tr stack hrun; rw [replay_zero] at hrun; simp at hrun
  | succ f ih =>
    intro c tr stack hrun σ hσ hc
    rw [replay_succ] at hrun
    cases stack with
    | nil => cases hσ
    | cons head st =>
      obtain ⟨t, w, a, sEnc⟩ := head
      simp only [step, Bool.cond_eq_ite] at hrun
      by_cases hc1 : (Nat.beq c 1) = true
      · rw [if_pos hc1] at hrun
        cases tr with
        | nil => simp at hrun
        | cons c' tr' => exact ih _ _ _ hrun σ hσ hc
      rw [if_neg hc1, Bool.and_eq_true] at hrun
      obtain ⟨hcexb, hrun⟩ := hrun
      have hcex : ¬ (cexAt t sEnc = true) := by simpa using hcexb
      rw [List.mem_cons] at hσ
      by_cases h2 : (Nat.beq (c &&& 7) 2) = true
      · rw [if_pos h2] at hrun
        rw [Bool.and_eq_true] at hrun
        obtain ⟨hcutE, hrepl⟩ := hrun
        rcases hσ with rfl | hσ'
        · refine not_bad_head tMax t w a sEnc d hc.2.2 hcex ?_
          intro u htu1 huT hu2 hu12 hsurp
          obtain ⟨hsEnc1, htle⟩ := sEnc_pos tMax t w a sEnc d htM hc u htu1 huT
          cases hd1 : d (t + 1) with
          | true =>
            exact ih _ _ _ hrepl _ List.mem_cons_self
              (consistent_incl d t w a sEnc hc hd1) ⟨u, htu1, huT, hu2, hu12, hsurp⟩
          | false =>
            have hwin : window d (t + 1) = w >>> 1 := by
              rw [window_succ, if_neg (by simp [hd1]), Nat.or_zero, hc.1]
            have hs' : ((sEnc - 1 : Nat) : Int) = surplus d (t + 1) + 4000 :=
              (consistent_excl d t w a sEnc hc hd1 hsEnc1).2.2
            rw [← hwin] at hcutE
            exact potcut_false vAt d hpot hd t (sEnc - 1) hs' hcutE u htu1 hu2 hu12 hsurp
        · exact ih _ _ _ hrepl σ (List.mem_cons_of_mem _ hσ') hc
      · rw [if_neg h2] at hrun
        by_cases h4 : (Nat.beq (c &&& 7) 4) = true
        · rw [if_pos h4] at hrun
          rw [Bool.and_eq_true] at hrun
          obtain ⟨hquad, hrepl⟩ := hrun
          rcases hσ with rfl | hσ'
          · refine not_bad_head tMax t w a sEnc d hc.2.2 hcex ?_
            intro u htu1 huT hu2 hu12 hsurp
            obtain ⟨hsEnc1, htle⟩ := sEnc_pos tMax t w a sEnc d htM hc u htu1 huT
            cases hd1 : d (t + 1) with
            | true =>
              have haiC := (consistent_incl d t w a sEnc hc hd1).2.1
              have hai : ∀ s, (a ||| 1 <<< (t + 1)).testBit s = true → d s = true := by
                intro s hts
                have hx := haiC s
                rw [hx] at hts
                simp only [Bool.and_eq_true, decide_eq_true_eq] at hts
                exact hts.2
              exact quad_false d hd _ _ _ _ _ hai hquad
            | false =>
              exact ih _ _ _ hrepl _ List.mem_cons_self
                (consistent_excl d t w a sEnc hc hd1 hsEnc1) ⟨u, htu1, huT, hu2, hu12, hsurp⟩
          · exact ih _ _ _ hrepl σ (List.mem_cons_of_mem _ hσ') hc
        · rw [if_neg h4] at hrun
          by_cases h1 : (Nat.beq (c &&& 7) 1) = true
          · rw [if_pos h1] at hrun
            rcases hσ with rfl | hσ'
            · refine not_bad_head tMax t w a sEnc d hc.2.2 hcex ?_
              intro u htu1 huT hu2 hu12 hsurp
              obtain ⟨hsEnc1, htle⟩ := sEnc_pos tMax t w a sEnc d htM hc u htu1 huT
              cases hd1 : d (t + 1) with
              | true =>
                exact ih _ _ _ hrun _ List.mem_cons_self
                  (consistent_incl d t w a sEnc hc hd1) ⟨u, htu1, huT, hu2, hu12, hsurp⟩
              | false =>
                exact ih _ _ _ hrun _ (List.mem_cons_of_mem _ List.mem_cons_self)
                  (consistent_excl d t w a sEnc hc hd1 hsEnc1) ⟨u, htu1, huT, hu2, hu12, hsurp⟩
            · exact ih _ _ _ hrun σ
                (List.mem_cons_of_mem _ (List.mem_cons_of_mem _ hσ')) hc
          · rw [if_neg h1] at hrun
            by_cases h3 : (Nat.beq (c &&& 7) 3) = true
            · rw [if_pos h3] at hrun
              rw [Bool.and_eq_true] at hrun
              obtain ⟨hcutI, hrepl⟩ := hrun
              rcases hσ with rfl | hσ'
              · refine not_bad_head tMax t w a sEnc d hc.2.2 hcex ?_
                intro u htu1 huT hu2 hu12 hsurp
                obtain ⟨hsEnc1, htle⟩ := sEnc_pos tMax t w a sEnc d htM hc u htu1 huT
                cases hd1 : d (t + 1) with
                | true =>
                  have hwin : window d (t + 1) = w >>> 1 ||| 8192 := by
                    rw [window_succ, if_pos hd1, hc.1]
                  have hs' : ((sEnc + 1 : Nat) : Int) = surplus d (t + 1) + 4000 :=
                    (consistent_incl d t w a sEnc hc hd1).2.2
                  rw [← hwin] at hcutI
                  exact potcut_false vAt d hpot hd t (sEnc + 1) hs' hcutI u htu1 hu2 hu12 hsurp
                | false =>
                  exact ih _ _ _ hrepl _ List.mem_cons_self
                    (consistent_excl d t w a sEnc hc hd1 hsEnc1) ⟨u, htu1, huT, hu2, hu12, hsurp⟩
              · exact ih _ _ _ hrepl σ (List.mem_cons_of_mem _ hσ') hc
            · rw [if_neg h3] at hrun
              by_cases h6 : (Nat.beq (c &&& 7) 6) = true
              · rw [if_pos h6] at hrun
                rw [Bool.and_eq_true, Bool.and_eq_true] at hrun
                obtain ⟨⟨hquad, hcutE⟩, hrepl⟩ := hrun
                rcases hσ with rfl | hσ'
                · refine not_bad_head tMax t w a sEnc d hc.2.2 hcex ?_
                  intro u htu1 huT hu2 hu12 hsurp
                  obtain ⟨hsEnc1, htle⟩ := sEnc_pos tMax t w a sEnc d htM hc u htu1 huT
                  cases hd1 : d (t + 1) with
                  | true =>
                    have haiC := (consistent_incl d t w a sEnc hc hd1).2.1
                    have hai : ∀ s, (a ||| 1 <<< (t + 1)).testBit s = true → d s = true := by
                      intro s hts
                      have hx := haiC s
                      rw [hx] at hts
                      simp only [Bool.and_eq_true, decide_eq_true_eq] at hts
                      exact hts.2
                    exact quad_false d hd _ _ _ _ _ hai hquad
                  | false =>
                    have hwin : window d (t + 1) = w >>> 1 := by
                      rw [window_succ, if_neg (by simp [hd1]), Nat.or_zero, hc.1]
                    have hs' : ((sEnc - 1 : Nat) : Int) = surplus d (t + 1) + 4000 :=
                      (consistent_excl d t w a sEnc hc hd1 hsEnc1).2.2
                    rw [← hwin] at hcutE
                    exact potcut_false vAt d hpot hd t (sEnc - 1) hs' hcutE u htu1 hu2 hu12 hsurp
                · exact ih _ _ _ hrepl σ hσ' hc
              · rw [if_neg h6] at hrun
                by_cases h0 : (Nat.beq (c &&& 7) 0) = true
                · rw [if_pos h0] at hrun
                  rw [Bool.and_eq_true] at hrun
                  obtain ⟨htmax, hrepl⟩ := hrun
                  rw [Nat.beq_eq] at htmax
                  rcases hσ with rfl | hσ'
                  · refine not_bad_head tMax t w a sEnc d hc.2.2 hcex ?_
                    intro u htu1 huT hu2 hu12 hsurp
                    omega
                  · exact ih _ _ _ hrepl σ hσ' hc
                · rw [if_neg h0] at hrun
                  by_cases h7 : (Nat.beq (c &&& 7) 7) = true
                  · rw [if_pos h7] at hrun
                    rw [Bool.and_eq_true] at hrun
                    obtain ⟨hmem, hrepl⟩ := hrun
                    rcases hσ with rfl | hσ'
                    · exact hcut _ (List.mem_of_elem_eq_true hmem) hc
                    · exact ih _ _ _ hrepl σ hσ' hc
                  · rw [if_neg h7] at hrun
                    simp at hrun


