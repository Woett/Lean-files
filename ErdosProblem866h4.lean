      have hLOWfacts : ∀ x ∈ LOW, x ∈ A' ∧ x % 2 = 0 ∧ 2 ≤ x ∧ x ≤ 4*d + 6 := by
        intro x hx
        obtain ⟨hxE, hxle⟩ := Finset.mem_filter.mp hx
        obtain ⟨hxA, hxe, hx2, -⟩ := hEfacts x hxE
        exact ⟨hxA, hxe, hx2, hxle⟩
      have hcards : E.card ≤ LOW.card + TOP.card :=
        le_trans (Finset.card_le_card hsplit) (Finset.card_union_le _ _)
      have hcardsZ : (E.card : ℤ) ≤ (LOW.card : ℤ) + (TOP.card : ℤ) := by exact_mod_cast hcards
      -- At most six elements of `LOW` lie below `40`, and at most three lie above.
      have hLOWcrude : (LOW.card : ℤ) ≤ 9 := by
        set LOWa : Finset ℤ := LOW.filter (fun x => x ≤ 38) with hLOWa
        set LOWb : Finset ℤ := LOW.filter (fun x => ¬ (x ≤ 38)) with hLOWb
        have hLOWsplit : LOWa.card + LOWb.card = LOW.card := by
          rw [hLOWa, hLOWb, Finset.card_filter_add_card_filter_not]
        have ha : LOWa.card < 7 := by
          refine small_evens_fib n A' D LOWa 7 19 hfree hodd (by norm_num)
            (by norm_num [Nat.fib]) (by omega) ?_
          intro x hx
          obtain ⟨hxLOW, hxle⟩ := Finset.mem_filter.mp hx
          obtain ⟨hxA, hxe, hx2, -⟩ := hLOWfacts x hxLOW
          exact ⟨hxA, hxe, hx2, by omega⟩
        have hb : LOWb.card ≤ 3 := by
          refine no_four_in_window n A' D LOWb 40 (4*d + 6) hfree hodd
            (by omega) (by omega) ?_
          intro x hx
          obtain ⟨hxLOW, hxgt⟩ := Finset.mem_filter.mp hx
          obtain ⟨hxA, hxe, hx2, hxub⟩ := hLOWfacts x hxLOW
          exact ⟨hxA, hxe, by omega, hxub⟩
        have : LOW.card ≤ 9 := by omega
        exact_mod_cast this
      by_cases hTOPne : TOP.Nonempty
      · -- Use the largest element of `TOP` in the pair bound.
        have hTOPfacts : ∀ x ∈ TOP, x ∈ A' ∧ x % 2 = 0 ∧ 2*(n:ℤ) - 4*d - 6 ≤ x ∧ x ≤ 2*(n:ℤ) := by
          intro x hx
          obtain ⟨hxE, hxge⟩ := Finset.mem_filter.mp hx
          obtain ⟨hxA, hxe, -, hxub⟩ := hEfacts x hxE
          exact ⟨hxA, hxe, hxge, hxub⟩
        have hTOPcard := top_cluster_card n A' D TOP hfree (by omega) hTOPfacts
        set t : ℤ := TOP.max' hTOPne with htdef
        have htTOP : t ∈ TOP := TOP.max'_mem hTOPne
        obtain ⟨htA, hte, htlb, htub⟩ := hTOPfacts t htTOP
        have hspread : 2*(n:ℤ) - 4*d - 6 + 2 * ((TOP.card : ℤ) - 1) ≤ t :=
