        · -- If `20 ≤ d ≤ 23`, the bound `|LOW| ≤ 5` suffices.
          exact endgame_arith_wide d (TOP.card : ℤ) hd20 hT2 hTOPcard
      · -- If `TOP` is empty, all even elements lie in `LOW`, which has at most nine elements.
        have hEsub : E ⊆ LOW := by
          intro x hxE
