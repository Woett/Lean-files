/-
This Lean file contains a formalization of the proof that `h₄(n) = 4` for every
`n ≥ 6`, where `h_k(n)` is the least `m` such that every `A ⊆ {1, …, 2n}` with
`|A| ≥ n + m` contains the pairwise sums of `k` distinct positive integers.

The determination of `h_k(n)` was initiated by Choi, Erdős and Szemerédi and is
nowadays recorded as Erdős problem #866 on Bloom's website, see
https://www.erdosproblems.com/866.

Choi, S. L. G. and Erdős, P. and Szemerédi, E., Some additive and multiplicative
problems in number theory. Acta Arith., 37--50 (1975).

The proof of `h₄(n) = 4` was found by Claude from Anthropic and Aristotle from
Harmonic (aristotle-harmonic@harmonic.fun). For a human-readable proof and more
information on the provenance of the ideas, one can check the paper of John
Erlbacher and me on arXiv.

One can also check out my earlier paper and corresponding formalization.

Wouter van Doorn, The cardinality of a set containing the pairwise sums of a
fixed number of integers. arXiv:2605.00040 (2026).

https://github.com/Woett/Lean-files/blob/main/ErdosProblem866.lean

Lean version: leanprover/lean4:v4.28.0
-/

import Mathlib

open Finset
open scoped Classical

set_option maxHeartbeats 1000000
set_option maxRecDepth 4000000

/-! ### Definitions -/

/-- There are `k` distinct positive integers whose pairwise sums lie in `A`. -/
def HasPosPairwiseSums (A : Finset ℤ) (k : ℕ) : Prop :=
  ∃ b : Fin k → ℤ, Function.Injective b ∧ (∀ i : Fin k, 0 < b i) ∧
    ∀ i j : Fin k, i < j → b i + b j ∈ A

/-- The least `m` such that every `A ⊆ {1, …, 2n}` with `|A| ≥ n + m`
contains the pairwise sums of `k` distinct positive integers. -/
noncomputable def hFun (k n : ℕ) : ℕ :=
  sInf {m : ℕ | ∀ (A : Finset ℤ), A ⊆ Icc (1 : ℤ) (2 * ↑n) →
    n + m ≤ A.card → HasPosPairwiseSums A k}

/-- The odd integers in `[1, 2n]` that do not belong to `A`. -/
def missingOdds (n : ℕ) (A : Finset ℤ) : Finset ℤ :=
  (Finset.Icc (1:ℤ) (2*(n:ℤ))).filter (fun x => x % 2 = 1 ∧ x ∉ A)

lemma card_odds_Icc (n : ℕ) :
    ((Finset.Icc (1:ℤ) (2*(n:ℤ))).filter (fun x => x % 2 = 1)).card = n := by
  induction n with
  | zero => simp
  | succ m ih =>
      have hins : Finset.Icc (1:ℤ) (2*((m:ℤ)+1)) =
          insert (2*(m:ℤ)+1) (insert (2*(m:ℤ)+2) (Finset.Icc (1:ℤ) (2*(m:ℤ)))) := by
        ext z
        simp only [Finset.mem_Icc, Finset.mem_insert]
        omega
      have hcast : (((m+1 : ℕ)):ℤ) = (m:ℤ) + 1 := by push_cast; ring
      rw [hcast, hins, Finset.filter_insert, Finset.filter_insert,
        if_pos (by omega : (2*(m:ℤ)+1) % 2 = 1), if_neg (by omega : ¬(2*(m:ℤ)+2) % 2 = 1),
        Finset.card_insert_of_notMem (by
          simp only [Finset.mem_filter, Finset.mem_Icc]
          omega), ih]

/-- If `|A| ≥ n + 4`, the number of even elements of `A` is at least
the number of missing odd integers plus `4`. -/
lemma evens_card_lower (n : ℕ) (A : Finset ℤ)
    (hA : A ⊆ Finset.Icc (1:ℤ) (2*(n:ℤ))) (hcard : n + 4 ≤ A.card) :
    (missingOdds n A).card + 4 ≤ (A.filter (fun x => x % 2 = 0)).card := by
  classical
  have hsplit : (A.filter (fun x => x % 2 = 1)).card
      + (A.filter (fun x => x % 2 = 0)).card = A.card := by
    have hneg : A.filter (fun x => ¬ x % 2 = 1) = A.filter (fun x => x % 2 = 0) := by
      apply Finset.filter_congr
      intro x _
      constructor
      · intro h; omega
      · intro h; omega
    rw [← hneg, Finset.card_filter_add_card_filter_not]
  have hsub : (A.filter (fun x => x % 2 = 1)) ∪ missingOdds n A
      ⊆ (Finset.Icc (1:ℤ) (2*(n:ℤ))).filter (fun x => x % 2 = 1) := by
    intro x hx
    rcases Finset.mem_union.mp hx with h | h
    · obtain ⟨hxA, hxo⟩ := Finset.mem_filter.mp h
      exact Finset.mem_filter.mpr ⟨hA hxA, hxo⟩
    · obtain ⟨hxI, hxo, _⟩ := Finset.mem_filter.mp h
      exact Finset.mem_filter.mpr ⟨hxI, hxo⟩
  have hdisj : Disjoint (A.filter (fun x => x % 2 = 1)) (missingOdds n A) := by
    rw [Finset.disjoint_left]
    intro x hx hx'
    exact ((Finset.mem_filter.mp hx').2).2 ((Finset.mem_filter.mp hx).1)
  have hunion := Finset.card_union_of_disjoint hdisj
  have hle := Finset.card_le_card hsub
  rw [hunion, card_odds_Icc] at hle
  omega

/-- Two odd and two even distinct positive integers give the required four
integers when all six pairwise sums belong to `A`. -/
lemma hasPPS_of_combo {A : Finset ℤ} {o₁ o₂ e₁ e₂ : ℤ}
    (ho1 : 0 < o₁) (ho12 : o₁ < o₂) (he1 : 0 < e₁) (he12 : e₁ < e₂)
    (hop1 : o₁ % 2 = 1) (hop2 : o₂ % 2 = 1) (hep1 : e₁ % 2 = 0) (hep2 : e₂ % 2 = 0)
    (hs : o₁ + o₂ ∈ A) (ht : e₁ + e₂ ∈ A)
    (h11 : o₁ + e₁ ∈ A) (h12 : o₁ + e₂ ∈ A) (h21 : o₂ + e₁ ∈ A) (h22 : o₂ + e₂ ∈ A) :
    HasPosPairwiseSums A 4 := by
  refine ⟨fun i : Fin 4 =>
    if i = 0 then o₁ else if i = 1 then o₂ else if i = 2 then e₁ else e₂, ?_, ?_, ?_⟩
  · intro i j hij
    fin_cases i <;> fin_cases j <;> first
      | rfl
      | (exfalso; simp at hij; omega)
  · intro i
    fin_cases i <;> simp <;> omega
  · intro i j hij
    fin_cases i <;> fin_cases j <;> first
      | exact absurd hij (by decide)
      | (simp only []; norm_num; assumption)

/-! ### The upper bound when `n ≥ 6d + 6`, where `d` counts missing odd integers -/

/-- For a fixed odd pair with sum `s ∈ A`, there are at most `2|D|` even
pairs with sum `t ∈ A` satisfying the stated bounds. -/
theorem K_epairs_le2 (n : ℕ) (A D : Finset ℤ)
    (hfree : ¬ HasPosPairwiseSums A 4)
    (hodd : ∀ x : ℤ, 1 ≤ x → x ≤ 2*(n:ℤ) → x % 2 = 1 → x ∉ D → x ∈ A)
    (s t o₁ o₂ : ℤ) (hs : s ∈ A) (ht : t ∈ A) (hos : o₁ + o₂ = s)
    (ho1 : 0 < o₁) (ho12 : o₁ < o₂) (hop1 : o₁ % 2 = 1) (hop2 : o₂ % 2 = 1)
    (EP : Finset (ℤ × ℤ))
    (hEP : ∀ p ∈ EP, 0 < p.1 ∧ p.1 < p.2 ∧ p.1 % 2 = 0 ∧ p.2 % 2 = 0 ∧
      p.1 + p.2 = t ∧ o₂ + p.2 ≤ 2*(n:ℤ) - 1) :
    EP.card ≤ 2 * D.card := by
  classical
  have hkill : ∀ p ∈ EP, o₁ + p.1 ∈ D ∨ o₁ + p.2 ∈ D ∨ o₂ + p.1 ∈ D ∨ o₂ + p.2 ∈ D := by
    intro p hp
    by_contra hno
    push_neg at hno
    obtain ⟨hn1, hn2, hn3, hn4⟩ := hno
    obtain ⟨he1, he12, hep1, hep2, hsum, hcap⟩ := hEP p hp
    refine hfree (hasPPS_of_combo ho1 ho12 he1 he12 hop1 hop2 hep1 hep2 ?_ ?_ ?_ ?_ ?_ ?_)
    · rw [hos]; exact hs
    · rw [hsum]; exact ht
    · exact hodd _ (by omega) (by omega) (by omega) hn1
    · exact hodd _ (by omega) (by omega) (by omega) hn2
    · exact hodd _ (by omega) (by omega) (by omega) hn3
    · exact hodd _ (by omega) (by omega) (by omega) hn4
  set f : ℤ × ℤ → ℤ × ℕ := fun p =>
    if o₁ + p.1 ∈ D then (o₁ + p.1, 0)
    else if o₁ + p.2 ∈ D then (o₁ + p.2, 0)
    else if o₂ + p.1 ∈ D then (o₂ + p.1, 1)
    else (o₂ + p.2, 1) with hfdef
  have hmaps : ∀ p ∈ EP, f p ∈ D ×ˢ Finset.range 2 := by
    intro p hp
    simp only [hfdef, Finset.mem_product, Finset.mem_range]
    split_ifs with h1 h2 h3
    · exact ⟨h1, by norm_num⟩
    · exact ⟨h2, by norm_num⟩
    · exact ⟨h3, by norm_num⟩
    · rcases hkill p hp with h | h | h | h
      · exact absurd h h1
      · exact absurd h h2
      · exact absurd h h3
      · exact ⟨h, by norm_num⟩
  have hinj : Set.InjOn f EP := by
    intro p hp q hq hfq
    have hps : p.1 + p.2 = t := (hEP p hp).2.2.2.2.1
    have hqs : q.1 + q.2 = t := (hEP q hq).2.2.2.2.1
    have hpo : p.1 < p.2 := (hEP p hp).2.1
    have hqo : q.1 < q.2 := (hEP q hq).2.1
    simp only [hfdef] at hfq
    split_ifs at hfq <;> injection hfq with hval hidx <;>
      first
        | omega
        | (have h1 : p.1 = q.1 := by omega
           have h2 : p.2 = q.2 := by omega
           exact Prod.ext h1 h2)
  have hcard := Finset.card_le_card_of_injOn f hmaps hinj
  rw [Finset.card_product, Finset.card_range] at hcard
  omega

/-- If the odd pair and the even pairs all sum to `t`, and `o₁ < p.1` for
each even pair `p`, the bound improves to `|D|`. The sums involving `o₁`
are below `t`, and those involving `o₂` are above `t`. -/
theorem K_epairs_le1 (n : ℕ) (A D : Finset ℤ)
    (hfree : ¬ HasPosPairwiseSums A 4)
    (hodd : ∀ x : ℤ, 1 ≤ x → x ≤ 2*(n:ℤ) → x % 2 = 1 → x ∉ D → x ∈ A)
    (t o₁ o₂ : ℤ) (ht : t ∈ A) (hos : o₁ + o₂ = t)
    (ho1 : 0 < o₁) (ho12 : o₁ < o₂) (hop1 : o₁ % 2 = 1) (hop2 : o₂ % 2 = 1)
    (EP : Finset (ℤ × ℤ))
    (hEP : ∀ p ∈ EP, 0 < p.1 ∧ p.1 < p.2 ∧ p.1 % 2 = 0 ∧ p.2 % 2 = 0 ∧
      p.1 + p.2 = t ∧ o₂ + p.2 ≤ 2*(n:ℤ) - 1)
    (hdisj : ∀ p ∈ EP, o₁ < p.1) :
    EP.card ≤ D.card := by
  convert Finset.card_le_card_of_injOn ?_ ?_ ?_
  use fun p => if o₁ + p.1 ∈ D then o₁ + p.1 else if o₁ + p.2 ∈ D then o₁ + p.2 else if o₂ + p.1 ∈ D then o₂ + p.1 else o₂ + p.2
  · intro p hp
    contrapose! hfree; simp_all +decide
    convert hasPPS_of_combo ho1 ho12 (hEP _ _ hp |>.1) (hEP _ _ hp |>.2.1) hop1 hop2 (Int.emod_eq_zero_of_dvd (hEP _ _ hp |>.2.2.1)) (Int.emod_eq_zero_of_dvd (hEP _ _ hp |>.2.2.2.1)) _ _ _ _ _ _ using 1
    all_goals simp_all +decide [← even_iff_two_dvd, parity_simps]
    · grind +qlia
    · grind
    · grind
    · grind +qlia
  · intro p hp q hq h_eq
    grind

/-- Exclude an even `t ∈ A` with `4d + 8 ≤ t ≤ n + 1`, where `d = |D|`.
The odd pair `(1, t - 1)` and `d + 1` even pairs contradict `K_epairs_le1`. -/
lemma mid_kill_lo (n : ℕ) (A D : Finset ℤ)
    (hfree : ¬ HasPosPairwiseSums A 4)
    (hodd : ∀ x : ℤ, 1 ≤ x → x ≤ 2*(n:ℤ) → x % 2 = 1 → x ∉ D → x ∈ A)
    (t : ℤ) (ht : t ∈ A) (hte : t % 2 = 0)
    (hlb : 4*(D.card:ℤ) + 8 ≤ t) (hub : t ≤ (n:ℤ) + 1) :
    False := by

  set d := D.card with hd
  -- Use the `d + 1` even pairs `(2j, t - 2j)`.
  set EP : Finset (ℤ × ℤ) := Finset.image (fun j => (2 * j, t - 2 * j)) (Finset.Icc 1 (d + 1)) with hEP_def

  have hEP_hyp : ∀ p ∈ EP, 0 < p.1 ∧ p.1 < p.2 ∧ p.1 % 2 = 0 ∧ p.2 % 2 = 0 ∧ p.1 + p.2 = t ∧ t - 1 + p.2 ≤ 2 * n - 1 := by
    grind

  have hEP_disj : ∀ p ∈ EP, 1 < p.1 := by
    grind
  have hEP_card : EP.card = d + 1 := by
    rw [Finset.card_image_of_injective] <;> norm_num [Function.Injective]
  have := K_epairs_le1 n A D hfree hodd t 1 (t - 1) ht (by ring) (by linarith) (by linarith) (by norm_num) (by omega) EP hEP_hyp hEP_disj; linarith

/-- Exclude an even `t ∈ A` with `n + 2 ≤ t ≤ 2n - 4d - 8`, where `d = |D|`.
Choose an odd pair summing to `t` and apply `K_epairs_le1`. -/
lemma mid_kill_hi (n : ℕ) (A D : Finset ℤ)
    (hfree : ¬ HasPosPairwiseSums A 4)
    (hodd : ∀ x : ℤ, 1 ≤ x → x ≤ 2*(n:ℤ) → x % 2 = 1 → x ∉ D → x ∈ A)
    (t : ℤ) (ht : t ∈ A) (hte : t % 2 = 0)
    (hlb : (n:ℤ) + 2 ≤ t) (hub : t ≤ 2*(n:ℤ) - 4*(D.card:ℤ) - 8) :
    False := by
  -- Choose an odd `o₂` with `n ≤ o₂ ≤ n + 1`.
  set o₂ := 2 * ((n : ℤ) / 2) + 1
  set o₁ := t - o₂
  set d := D.card
  -- Use `d + 1` even pairs summing to `t`.
  set EP := Finset.image (fun j : ℤ => (o₁ + 2 * j - 1, o₂ - 2 * j + 1)) (Finset.Icc 2 (d + 2))

  have := K_epairs_le1 n A D hfree hodd t o₁ o₂ ht (by ring) (by
  omega) (by
  omega) (by
  grind) (by
  grind) EP (by
  grind +splitImp) (by
  grind)
  rw [Finset.card_image_of_injective] at this <;> norm_num [Function.Injective] at *
  linarith

/-- Four distinct positive integers whose six pairwise sums lie in `A`
satisfy `HasPosPairwiseSums A 4`. -/
lemma hasPPS_of_quad {A : Finset ℤ} {w₁ w₂ w₃ w₄ : ℤ}
    (h1 : 0 < w₁) (h2 : 0 < w₂) (h3 : 0 < w₃) (h4 : 0 < w₄)
    (h12 : w₁ ≠ w₂) (h13 : w₁ ≠ w₃) (h14 : w₁ ≠ w₄)
    (h23 : w₂ ≠ w₃) (h24 : w₂ ≠ w₄) (h34 : w₃ ≠ w₄)
    (s12 : w₁ + w₂ ∈ A) (s13 : w₁ + w₃ ∈ A) (s14 : w₁ + w₄ ∈ A)
    (s23 : w₂ + w₃ ∈ A) (s24 : w₂ + w₄ ∈ A) (s34 : w₃ + w₄ ∈ A) :
    HasPosPairwiseSums A 4 := by
  refine ⟨fun i : Fin 4 =>
    if i = 0 then w₁ else if i = 1 then w₂ else if i = 2 then w₃ else w₄, ?_, ?_, ?_⟩
  · intro i j hij
    fin_cases i <;> fin_cases j <;> first
      | rfl
      | (exfalso; simp at hij; omega)
  · intro i
    fin_cases i <;> simp <;> omega
  · intro i j hij
    fin_cases i <;> fin_cases j <;> first
      | exact absurd hij (by decide)
      | (simp only []; norm_num; assumption)

/-- Exclude three positive integers `x < y < z` of the same parity whose
pairwise sums lie in `A`, when `z + 6|D| + 3 ≤ 2n`. -/
theorem T_star (n : ℕ) (A D : Finset ℤ)
    (hfree : ¬ HasPosPairwiseSums A 4)
    (hodd : ∀ x : ℤ, 1 ≤ x → x ≤ 2*(n:ℤ) → x % 2 = 1 → x ∉ D → x ∈ A)
    (x y z : ℤ) (h0x : 0 < x) (hxy : x < y) (hyz : y < z)
    (hpxy : x % 2 = y % 2) (hpyz : y % 2 = z % 2)
    (hxyA : x + y ∈ A) (hxzA : x + z ∈ A) (hyzA : y + z ∈ A)
    (hcap : z + 6*(D.card:ℤ) + 3 ≤ 2*(n:ℤ)) :
    False := by
  classical
  set dZ : ℤ := (D.card : ℤ) with hdZ
  have hd0 : (0:ℤ) ≤ dZ := by rw [hdZ]; exact_mod_cast Nat.zero_le D.card
  set WS : Finset ℤ := (Finset.Icc (1:ℤ) (3*dZ+1)).image (fun j => 2*j - (1 - x % 2))
    with hWS
  have hWcard : WS.card = 3 * D.card + 1 := by
    rw [hWS, Finset.card_image_of_injOn (fun a _ b _ h => by omega), Int.card_Icc]
    omega
  have hkill : ∀ w ∈ WS, x + w ∈ D ∨ y + w ∈ D ∨ z + w ∈ D := by
    intro w hw
    rw [hWS, Finset.mem_image] at hw
    obtain ⟨j, hj, hwj⟩ := hw
    rw [Finset.mem_Icc] at hj
    by_contra hno
    push_neg at hno
    obtain ⟨k1, k2, k3⟩ := hno
    have hw1 : 1 ≤ w := by omega
    have hwub : w ≤ 2*(n:ℤ) - 1 - z := by omega
    have hwpar : w % 2 = 1 - x % 2 := by omega
    refine hfree (hasPPS_of_quad (w₁ := x) (w₂ := y) (w₃ := z) (w₄ := w)
      h0x (by omega) (by omega) (by omega)
      (by omega) (by omega) (by omega) (by omega) (by omega) (by omega)
      hxyA hxzA ?_ hyzA ?_ ?_)
    · exact hodd _ (by omega) (by omega) (by omega) k1
    · exact hodd _ (by omega) (by omega) (by omega) k2
    · exact hodd _ (by omega) (by omega) (by omega) k3
  set f : ℤ → ℤ × ℕ := fun w =>
    if x + w ∈ D then (x + w, 0)
    else if y + w ∈ D then (y + w, 1)
    else (z + w, 2) with hfdef
  have hmaps : ∀ w ∈ WS, f w ∈ D ×ˢ Finset.range 3 := by
    intro w hw
    simp only [hfdef, Finset.mem_product, Finset.mem_range]
    split_ifs with hh1 hh2
    · exact ⟨hh1, by norm_num⟩
    · exact ⟨hh2, by norm_num⟩
    · rcases hkill w hw with h | h | h
      · exact absurd h hh1
      · exact absurd h hh2
      · exact ⟨h, by norm_num⟩
  have hinj : Set.InjOn f WS := by
    intro p hp q hq hfq
    simp only [hfdef] at hfq
    split_ifs at hfq <;> injection hfq with hval hidx <;> omega
  have hcard := Finset.card_le_card_of_injOn (s := WS) (t := D ×ˢ Finset.range 3)
    f hmaps hinj
  rw [Finset.card_product, Finset.card_range] at hcard
  omega

/-- If every ordered triple `a < b < c` satisfies `a + b ≤ c`, a set of
`p` positive integers has its two largest elements at least `fib p`
and `fib (p + 1)`. -/
lemma triangle_free_fib : ∀ (p : ℕ), 2 ≤ p → ∀ (Λ : Finset ℤ), Λ.card = p →
    (∀ a ∈ Λ, 1 ≤ a) →
    (∀ a ∈ Λ, ∀ b ∈ Λ, ∀ c ∈ Λ, a < b → b < c → a + b ≤ c) →
    ∃ M ∈ Λ, ∃ M' ∈ Λ, M' < M ∧ (Nat.fib (p+1) : ℤ) ≤ M ∧ (Nat.fib p : ℤ) ≤ M' := by
  intro p hp
  induction p, hp using Nat.le_induction with
  | base =>
      intro Λ hcard hpos _
      obtain ⟨a, b, hab, rfl⟩ := Finset.card_eq_two.mp hcard
      have ha := hpos a (by simp)
      have hb := hpos b (by simp)
      rcases lt_or_gt_of_ne hab with h | h
      · exact ⟨b, by simp, a, by simp, h, by simp [Nat.fib]; omega, by simp [Nat.fib]; omega⟩
      · exact ⟨a, by simp, b, by simp, h, by simp [Nat.fib]; omega, by simp [Nat.fib]; omega⟩
  | succ p hp ih =>
      intro Λ hcard hpos htf
      have hne : Λ.Nonempty := Finset.card_pos.mp (by omega)
      set M : ℤ := Λ.max' hne with hM
      have hMmem : M ∈ Λ := Λ.max'_mem hne
      set Λ' : Finset ℤ := Λ.erase M with hΛ'
      have hΛ'card : Λ'.card = p := by
        rw [hΛ', Finset.card_erase_of_mem hMmem, hcard]
        omega
      have hΛ'sub : Λ' ⊆ Λ := Finset.erase_subset _ _
      obtain ⟨M₁, hM₁, M₂, hM₂, h21, hf1, hf2⟩ := ih Λ' hΛ'card
        (fun a ha => hpos a (hΛ'sub ha))
        (fun a ha b hb c hc => htf a (hΛ'sub ha) b (hΛ'sub hb) c (hΛ'sub hc))
      have hM₁M : M₁ < M := by
        have hle := Λ.le_max' M₁ (hΛ'sub hM₁)
        have hne' := Finset.ne_of_mem_erase hM₁
        omega
      have hsum : M₂ + M₁ ≤ M := htf M₂ (hΛ'sub hM₂) M₁ (hΛ'sub hM₁) M hMmem h21 hM₁M
      refine ⟨M, hMmem, M₁, hΛ'sub hM₁, hM₁M, ?_, hf1⟩
      have hadd : Nat.fib (p+1+1) = Nat.fib p + Nat.fib (p+1) := Nat.fib_add_two
      have hcast : (Nat.fib (p+1+1) : ℤ) = (Nat.fib p : ℤ) + (Nat.fib (p+1) : ℤ) := by
        exact_mod_cast hadd
      omega

/-- `fib (d + 5) > 4d + 3`. -/
lemma cap_fib : ∀ d : ℕ, 4*d + 3 < Nat.fib (d+5) := by
  intro d
  induction d with
  | zero => decide
  | succ k ih =>
      rcases Nat.eq_zero_or_pos k with rfl | hk
      · decide
      · have h5 : 5 ≤ Nat.fib (k+4) := by
          calc 5 = Nat.fib 5 := by decide
          _ ≤ Nat.fib (k+4) := Nat.fib_mono (by omega)
        have hadd : Nat.fib (k+1+5) = Nat.fib (k+4) + Nat.fib (k+5) := by
          have h := Nat.fib_add_two (n := k+4)
          rw [show k+4+2 = k+1+5 from by omega, show k+4+1 = k+5 from by omega] at h
          exact h
        omega

/-- Exclude even `s, t ∈ A` with `s ≥ 4`, `t ≥ 8d + 6`, and
`s / 2 + t / 2 + 4d + 4 ≤ 2n - 1`, where `d = |D|`. -/
lemma balanced_kill (n : ℕ) (A D : Finset ℤ)
    (hfree : ¬ HasPosPairwiseSums A 4)
    (hodd : ∀ x : ℤ, 1 ≤ x → x ≤ 2*(n:ℤ) → x % 2 = 1 → x ∉ D → x ∈ A)
    (s t : ℤ) (hs : s ∈ A) (ht : t ∈ A)
    (hse : s % 2 = 0) (hte : t % 2 = 0)
    (hs4 : 4 ≤ s)
    (htlb : 8*(D.card:ℤ) + 6 ≤ t)
    (hcap : s/2 + t/2 + 4*(D.card:ℤ) + 4 ≤ 2*(n:ℤ) - 1) :
    False := by
  classical
  set dZ : ℤ := (D.card : ℤ) with hdZ
  have hd0 : (0:ℤ) ≤ dZ := by rw [hdZ]; exact_mod_cast Nat.zero_le D.card
  set τs : ℤ := s / 2 with hτs
  set τt : ℤ := t / 2 with hτt
  have hτs2 : 2 * τs = s := by omega
  have hτt2 : 2 * τt = t := by omega
  set μ : ℤ := τt / 2 with hμ
  have hμlb : 2*μ ≤ τt := by omega
  have hμub : τt ≤ 2*μ + 1 := by omega
  set o₂ : ℤ := τs + 1 + τs % 2 with ho2def
  set o₁ : ℤ := s - o₂ with ho1def
  set EP : Finset (ℤ × ℤ) := (Finset.Icc (1:ℤ) (2*dZ+1)).image
    (fun j => (t - 2*(μ + j), 2*(μ + j))) with hEPdef
  have hEPcard : EP.card = 2 * D.card + 1 := by
    rw [hEPdef, Finset.card_image_of_injOn (fun a _ b _ h => by
      simp only [Prod.mk.injEq] at h; omega), Int.card_Icc]
    omega
  have hEPmem : ∀ p ∈ EP, 0 < p.1 ∧ p.1 < p.2 ∧ p.1 % 2 = 0 ∧ p.2 % 2 = 0 ∧
      p.1 + p.2 = t ∧ o₂ + p.2 ≤ 2*(n:ℤ) - 1 := by
    intro p hp
    rw [hEPdef, Finset.mem_image] at hp
    obtain ⟨j, hj, rfl⟩ := hp
    rw [Finset.mem_Icc] at hj
    refine ⟨by omega, by omega, by omega, by omega, by omega, by omega⟩
  have hK := K_epairs_le2 n A D hfree hodd s t o₁ o₂ hs ht (by omega)
    (by omega) (by omega) (by omega) (by omega) EP hEPmem
  omega

/-- When `n ≥ 6d + 6`, exclude three even elements `a < b < c` of `A`
in `[2n - 4d - 6, 2n - 2d]`, where `d = |D|`. -/
lemma tt_aux_lo (n : ℕ) (A D : Finset ℤ)
    (hfree : ¬ HasPosPairwiseSums A 4)
    (hodd : ∀ x : ℤ, 1 ≤ x → x ≤ 2*(n:ℤ) → x % 2 = 1 → x ∉ D → x ∈ A)
    (hnd : 6*(D.card:ℤ) + 6 ≤ (n:ℤ))
    (a b c : ℤ) (haA : a ∈ A) (hbA : b ∈ A) (hcA : c ∈ A)
    (hae : a % 2 = 0) (hbe : b % 2 = 0) (hce : c % 2 = 0)
    (hab : a < b) (hbc : b < c)
    (halb : 2*(n:ℤ) - 4*(D.card:ℤ) - 6 ≤ a) (hcub : c ≤ 2*(n:ℤ) - 2*(D.card:ℤ)) :
    False := by
  set dZ : ℤ := (D.card : ℤ) with hdZ
  have hd0 : (0:ℤ) ≤ dZ := by rw [hdZ]; exact_mod_cast Nat.zero_le D.card
  obtain ⟨x, hx⟩ : ∃ x, a + b - c = 2*x := ⟨(a+b-c)/2, by omega⟩
  obtain ⟨y, hy⟩ : ∃ y, a + c - b = 2*y := ⟨(a+c-b)/2, by omega⟩
  obtain ⟨z, hz⟩ : ∃ z, b + c - a = 2*z := ⟨(b+c-a)/2, by omega⟩
  refine T_star n A D hfree hodd x y z (by omega) (by omega) (by omega)
    (by omega) (by omega) ?_ ?_ ?_ (by omega)
  · have h : x + y = a := by omega
    rwa [h]
  · have h : x + z = b := by omega
    rwa [h]
  · have h : y + z = c := by omega
    rwa [h]

/-- When `n ≥ 6d + 6`, at most `d + 2` even elements of `A` lie in
`[2n - 4d - 6, 2n]`, where `d = |D|`. -/
lemma top_card_le (n : ℕ) (A D : Finset ℤ)
    (hfree : ¬ HasPosPairwiseSums A 4)
    (hodd : ∀ x : ℤ, 1 ≤ x → x ≤ 2*(n:ℤ) → x % 2 = 1 → x ∉ D → x ∈ A)
    (hnd : 6*(D.card:ℤ) + 6 ≤ (n:ℤ))
    (TOP : Finset ℤ)
    (hTOP : ∀ s ∈ TOP, s ∈ A ∧ s % 2 = 0 ∧ 2*(n:ℤ) - 4*(D.card:ℤ) - 6 ≤ s ∧ s ≤ 2*(n:ℤ)) :
    TOP.card ≤ D.card + 2 := by
  by_contra h
  obtain ⟨a, b, c, ha, hb, hc, hab, hbc, halb, hcub⟩ : ∃ a b c : ℤ, a ∈ TOP ∧ b ∈ TOP ∧ c ∈ TOP ∧ a < b ∧ b < c ∧ 2*(n:ℤ) - 4*(D.card:ℤ) - 6 ≤ a ∧ c ≤ 2*(n:ℤ) - 2*(D.card:ℤ) := by
    obtain ⟨S, hSsub, hS3⟩ : ∃ S : Finset ℤ, S ⊆ TOP ∧ S.card = 3 ∧ ∀ s ∈ S, s ≤ 2*(n:ℤ) - 2*(D.card:ℤ) := by
      have hLO_card : (TOP.filter (fun s => s ≤ 2 * (n : ℤ) - 2 * (D.card : ℤ))).card ≥ 3 := by
        have hLO_card : (TOP.filter (fun s => s > 2 * (n : ℤ) - 2 * (D.card : ℤ))).card ≤ D.card := by
          have hLO_card : (TOP.filter (fun s => s > 2 * (n : ℤ) - 2 * (D.card : ℤ))).card ≤ Finset.card (Finset.image (fun s => (s - (2 * (n : ℤ) - 2 * (D.card : ℤ))) / 2) (TOP.filter (fun s => s > 2 * (n : ℤ) - 2 * (D.card : ℤ)))) := by
            rw [Finset.card_image_of_injOn]
            exact fun x hx y hy hxy => by linarith [Int.ediv_mul_cancel (show 2 ∣ x - (2 * n - 2 * D.card) from Int.dvd_of_emod_eq_zero (by norm_num [Int.sub_emod, hTOP x (Finset.filter_subset _ _ hx)])), Int.ediv_mul_cancel (show 2 ∣ y - (2 * n - 2 * D.card) from Int.dvd_of_emod_eq_zero (by norm_num [Int.sub_emod, hTOP y (Finset.filter_subset _ _ hy)]))]
          refine le_trans hLO_card <| le_trans (Finset.card_le_card <| show _ ⊆ Finset.Icc 1 (D.card : ℤ) from ?_) ?_
          · grind
          · norm_num
        rw [show (Finset.filter (fun s => s ≤ 2 * (n : ℤ) - 2 * (D.card : ℤ)) TOP) = TOP \ (Finset.filter (fun s => s > 2 * (n : ℤ) - 2 * (D.card : ℤ)) TOP) by ext; aesop]; rw [Finset.card_sdiff]; norm_num
        exact le_tsub_of_add_le_left (by linarith! [show Finset.card (Finset.filter (fun s => 2 * (n : ℤ) - 2 * (D.card : ℤ) < s) TOP ∩ TOP) ≤ Finset.card (Finset.filter (fun s => 2 * (n : ℤ) - 2 * (D.card : ℤ) < s) TOP) from Finset.card_mono <| Finset.inter_subset_left])
      exact Exists.elim (Finset.exists_subset_card_eq hLO_card) fun S hS => ⟨S, Finset.Subset.trans hS.1 (Finset.filter_subset _ _), hS.2, fun s hs => Finset.mem_filter.mp (hS.1 hs) |>.2⟩

    obtain ⟨a, b, c, ha, hb, hc, habc⟩ : ∃ a b c : ℤ, a ∈ S ∧ b ∈ S ∧ c ∈ S ∧ a < b ∧ b < c := by
      rcases Finset.card_eq_three.mp hS3.1 with ⟨a, b, c, ha, hb, hc, hab, hbc, hac⟩; cases lt_trichotomy a b <;> cases lt_trichotomy b c <;> cases lt_trichotomy a c <;> aesop
    exact ⟨a, b, c, hSsub ha, hSsub hb, hSsub hc, habc.1, habc.2, hTOP a (hSsub ha) |>.2.2.1, hS3.2 c hc⟩
  exact tt_aux_lo n A D hfree hodd hnd a b c (hTOP a ha |>.1) (hTOP b hb |>.1) (hTOP c hc |>.1) (hTOP a ha |>.2.1) (hTOP b hb |>.2.1) (hTOP c hc |>.2.1) hab hbc halb hcub

/-- Every `A ⊆ [1, 2n]` of size `n + 4` has the required pairwise sums if `n ≥ 6d + 6`. -/
theorem structural_case (n : ℕ) (A : Finset ℤ)
    (hA : A ⊆ Finset.Icc (1:ℤ) (2*(n:ℤ))) (hcard : A.card = n + 4)
    (hd : 6 * (missingOdds n A).card + 6 ≤ n) (hnlb : 13 ≤ n) :
    HasPosPairwiseSums A 4 := by
  classical
  by_contra hfree
  set D : Finset ℤ := missingOdds n A with hD
  set dZ : ℤ := (D.card : ℤ) with hdZ
  have hd0 : (0:ℤ) ≤ dZ := by rw [hdZ]; exact_mod_cast Nat.zero_le D.card
  have hnd6 : 6 * dZ + 6 ≤ (n:ℤ) := by rw [hdZ]; exact_mod_cast hd
  have hodd : ∀ x : ℤ, 1 ≤ x → x ≤ 2*(n:ℤ) → x % 2 = 1 → x ∉ D → x ∈ A := by
    intro x h1 h2 h3 h4
    by_contra hxA
    exact h4 (Finset.mem_filter.mpr ⟨Finset.mem_Icc.mpr ⟨h1, h2⟩, h3, hxA⟩)
  set E : Finset ℤ := A.filter (fun x => x % 2 = 0) with hE
  have hEcard : D.card + 4 ≤ E.card := evens_card_lower n A hA (le_of_eq hcard.symm)
  have hEfacts : ∀ s ∈ E, s ∈ A ∧ s % 2 = 0 ∧ 2 ≤ s ∧ s ≤ 2*(n:ℤ) := by
    intro s hsE
    obtain ⟨hsA, hse⟩ := Finset.mem_filter.mp hsE
    have hbounds := Finset.mem_Icc.mp (hA hsA)
    exact ⟨hsA, hse, by omega, by omega⟩
  -- No even element of `A` lies in `[4d + 8, 2n - 4d - 8]`.
  have hmid : ∀ s ∈ E, ¬(4*dZ + 8 ≤ s ∧ s ≤ 2*(n:ℤ) - 4*dZ - 8) := by
    rintro s hsE ⟨hlb, hub⟩
    obtain ⟨hsA, hse, -, -⟩ := hEfacts s hsE
    rcases le_or_gt s ((n:ℤ) + 1) with hsn | hsn
    · exact mid_kill_lo n A D hfree hodd s hsA hse (by omega) (by omega)
    · exact mid_kill_hi n A D hfree hodd s hsA hse (by omega) (by omega)
  by_cases htop : ∃ t ∈ E, 2*(n:ℤ) - 4*dZ - 6 ≤ t
  · -- There is an even element near `2n`.
    obtain ⟨t, htE, htlb⟩ := htop
    obtain ⟨htA, hte, -, htub⟩ := hEfacts t htE
    -- Use `t` to exclude even elements in `[4, 4d + 2]`.

    have hkill_small : ∀ s ∈ E, 4 ≤ s → s ≤ 4*dZ + 2 → False := by
      intro s hsE hs4 hsub
      obtain ⟨hsA, hse, -, -⟩ := hEfacts s hsE
      exact balanced_kill n A D hfree hodd s t hsA htA hse hte hs4 (by omega) (by omega)
    by_cases hmt : ∃ t' ∈ E, 2*(n:ℤ) - 4*dZ - 6 ≤ t' ∧ t' ≤ 2*(n:ℤ) - 2*dZ
    · -- A top element at most `2n - 2d` excludes every small even element except `2`.
      obtain ⟨t', ht'E, ht'lb, ht'ub⟩ := hmt
      obtain ⟨ht'A, ht'e, -, -⟩ := hEfacts t' ht'E
      have hlow : ∀ s ∈ E, s ≤ 4*dZ + 6 → s = 2 := by
        intro s hsE hsub
        by_contra hs2
        obtain ⟨hsA, hse, hs2', -⟩ := hEfacts s hsE
        exact balanced_kill n A D hfree hodd s t' hsA ht'A hse ht'e
          (by omega) (by omega) (by omega)
      set TOP : Finset ℤ := E.filter (fun x => 2*(n:ℤ) - 4*dZ - 6 ≤ x) with hTOPdef
      have hTOPcard : TOP.card ≤ D.card + 2 := by
        apply top_card_le n A D hfree hodd hnd6 TOP
        intro s hs
        obtain ⟨hsE, hslb⟩ := Finset.mem_filter.mp hs
        obtain ⟨hsA, hse, -, hsub⟩ := hEfacts s hsE
        exact ⟨hsA, hse, by omega, by omega⟩
      have hsub2 : E ⊆ insert 2 TOP := by
        intro s hsE
        obtain ⟨hsA, hse, hs2, hsub⟩ := hEfacts s hsE
        rcases le_or_gt s (4*dZ + 6) with hsmall | hbig
        · rw [hlow s hsE hsmall]
          exact Finset.mem_insert_self _ _
        · rcases le_or_gt s (2*(n:ℤ) - 4*dZ - 8) with hmidr | htopr
          · exact absurd ⟨by omega, hmidr⟩ (hmid s hsE)
          · exact Finset.mem_insert_of_mem (Finset.mem_filter.mpr ⟨hsE, by omega⟩)
      have hle : E.card ≤ D.card + 3 := by
        calc E.card ≤ (insert 2 TOP).card := Finset.card_le_card hsub2
          _ ≤ TOP.card + 1 := Finset.card_insert_le _ _
          _ ≤ D.card + 3 := by omega
      omega
    · -- Otherwise, there are at most `d` top elements.
      -- The only possible small even elements are `2`, `4d + 4`, and `4d + 6`.
      set TOPH : Finset ℤ := E.filter (fun x => 2*(n:ℤ) - 2*dZ < x) with hTOPHdef
      have hTOPHcard : TOPH.card ≤ D.card := by
        have himg : TOPH.card =
            (TOPH.image (fun s => (s - (2*(n:ℤ) - 2*dZ)) / 2)).card := by
          symm
          apply Finset.card_image_of_injOn
          intro x hx y hy hxy
          obtain ⟨hxE, -⟩ := Finset.mem_filter.mp hx
          obtain ⟨hyE, -⟩ := Finset.mem_filter.mp hy
          have hxe := (hEfacts x hxE).2.1
          have hye := (hEfacts y hyE).2.1
          simp only [] at hxy
          omega
        rw [himg]
        have hsub' : TOPH.image (fun s => (s - (2*(n:ℤ) - 2*dZ)) / 2) ⊆ Finset.Icc 1 dZ := by
          intro z hz
          rw [Finset.mem_image] at hz
          obtain ⟨s, hsT, rfl⟩ := hz
          obtain ⟨hsE, hslb⟩ := Finset.mem_filter.mp hsT
          have hse := (hEfacts s hsE).2.1
          have hsub := (hEfacts s hsE).2.2.2
          exact Finset.mem_Icc.mpr ⟨by omega, by omega⟩
        refine le_trans (Finset.card_le_card hsub') ?_
        rw [Int.card_Icc]
        omega
      set LOW : Finset ℤ := E.filter (fun x => x ≤ 4*dZ + 6) with hLOWdef
      have hLOWsub : LOW ⊆ ({2, 4*dZ+4, 4*dZ+6} : Finset ℤ) := by
        intro s hs
        obtain ⟨hsE, hsle⟩ := Finset.mem_filter.mp hs
        obtain ⟨hsA, hse, hs2, -⟩ := hEfacts s hsE
        by_cases h4 : 4 ≤ s ∧ s ≤ 4*dZ + 2
        · exact (hkill_small s hsE h4.1 h4.2).elim
        · simp only [Finset.mem_insert, Finset.mem_singleton]
          omega
      have hLOWcard : LOW.card ≤ 3 := by
        refine le_trans (Finset.card_le_card hLOWsub) ?_
        refine le_trans (Finset.card_insert_le _ _) ?_
        refine Nat.succ_le_succ ?_
        refine le_trans (Finset.card_insert_le _ _) ?_
        simp
      have hsub2 : E ⊆ LOW ∪ TOPH := by
        intro s hsE
        obtain ⟨hsA, hse, hs2, hsub⟩ := hEfacts s hsE
        rw [Finset.mem_union]
        rcases le_or_gt s (4*dZ + 6) with hsmall | hbig
        · left; exact Finset.mem_filter.mpr ⟨hsE, hsmall⟩
        · right
          rcases le_or_gt s (2*(n:ℤ) - 2*dZ) with hle2 | hgt2
          · rcases le_or_gt s (2*(n:ℤ) - 4*dZ - 8) with hmidr | htopr
            · exact absurd ⟨by omega, hmidr⟩ (hmid s hsE)
            · exact absurd ⟨s, hsE, by omega, hle2⟩ hmt
          · exact Finset.mem_filter.mpr ⟨hsE, hgt2⟩
      have hle : E.card ≤ D.card + 3 := by
        calc E.card ≤ (LOW ∪ TOPH).card := Finset.card_le_card hsub2
          _ ≤ LOW.card + TOPH.card := Finset.card_union_le _ _
          _ ≤ 3 + D.card := by omega
          _ = D.card + 3 := by omega
      omega
  · -- There is no even element near `2n`.
    push_neg at htop
    have hEsmall : ∀ s ∈ E, s ≤ 4*dZ + 6 := by
      intro s hsE
      by_contra hbig
      push_neg at hbig
      have hub := htop s hsE
      obtain ⟨-, hse, -, -⟩ := hEfacts s hsE
      exact hmid s hsE ⟨by omega, by omega⟩
    set Λ : Finset ℤ := E.image (fun s => s / 2) with hΛdef
    have hΛcard : Λ.card = E.card := Finset.card_image_of_injOn (by
      intro u hu v hv huv
      have hue : u % 2 = 0 := (Finset.mem_filter.mp hu).2
      have hve : v % 2 = 0 := (Finset.mem_filter.mp hv).2
      have huv' : u / 2 = v / 2 := huv
      omega)
    have hΛmem : ∀ g ∈ Λ, 2*g ∈ A ∧ 1 ≤ g ∧ g ≤ 2*dZ + 3 := by
      intro g hg
      rw [hΛdef, Finset.mem_image] at hg
      obtain ⟨s, hsE, rfl⟩ := hg
      obtain ⟨hsA, hse, hs2, -⟩ := hEfacts s hsE
      have hsmall := hEsmall s hsE
      have h2g : 2 * (s/2) = s := by omega
      exact ⟨by rwa [h2g], by omega, by omega⟩
    have hΛtf : ∀ g₁ ∈ Λ, ∀ g₂ ∈ Λ, ∀ g₃ ∈ Λ, g₁ < g₂ → g₂ < g₃ → g₁ + g₂ ≤ g₃ := by
      intro g1 hg1 g2 hg2 g3 hg3 h12 h23
      by_contra hgt
      push_neg at hgt
      obtain ⟨hA1, hp1, hu1⟩ := hΛmem g1 hg1
      obtain ⟨hA2, hp2, hu2⟩ := hΛmem g2 hg2
      obtain ⟨hA3, hp3, hu3⟩ := hΛmem g3 hg3
      refine T_star n A D hfree hodd (g1+g2-g3) (g1+g3-g2) (g2+g3-g1)
        (by omega) (by omega) (by omega) (by omega) (by omega) ?_ ?_ ?_ (by omega)
      · have h : (g1+g2-g3) + (g1+g3-g2) = 2*g1 := by ring
        rw [h]; exact hA1
      · have h : (g1+g2-g3) + (g2+g3-g1) = 2*g2 := by ring
        rw [h]; exact hA2
      · have h : (g1+g3-g2) + (g2+g3-g1) = 2*g3 := by ring
        rw [h]; exact hA3
    have hp2 : 2 ≤ Λ.card := by omega
    obtain ⟨M, hM, M', hM', hMM', hfib1, hfib2⟩ :=
      triangle_free_fib Λ.card hp2 Λ rfl (fun a ha => (hΛmem a ha).2.1) hΛtf
    have hcapM : M ≤ 2*dZ + 3 := (hΛmem M hM).2.2
    have hfibmono : (Nat.fib (D.card + 5) : ℤ) ≤ (Nat.fib (Λ.card + 1) : ℤ) := by
      exact_mod_cast Nat.fib_mono (by omega)
    have hcapfib : (4*(D.card:ℤ) + 3 : ℤ) < (Nat.fib (D.card + 5) : ℤ) := by
      exact_mod_cast cap_fib D.card
    omega

/-! ### Pairwise sums in sets of even integers -/

/-- Construct the required four integers without assuming an ordering. -/
lemma hasPPS_of_four_unordered {A : Finset ℤ} {a b c d : ℤ}
    (ha : 0 < a) (hb : 0 < b) (hc : 0 < c) (hd : 0 < d)
    (hab : a ≠ b) (hac : a ≠ c) (had : a ≠ d)
    (hbc : b ≠ c) (hbd : b ≠ d) (hcd : c ≠ d)
    (h1 : a + b ∈ A) (h2 : a + c ∈ A) (h3 : a + d ∈ A)
    (h4 : b + c ∈ A) (h5 : b + d ∈ A) (h6 : c + d ∈ A) :
    HasPosPairwiseSums A 4 := by
  refine ⟨fun i : Fin 4 =>
    if i = 0 then a else if i = 1 then b else if i = 2 then c else d, ?_, ?_, ?_⟩
  · intro i j hij
    fin_cases i <;> fin_cases j <;> first
      | rfl
      | (exfalso; simp only [] at hij; simp at hij; tauto)
  · intro i
    fin_cases i <;> simpa using ‹_›
  · intro i j hij
    fin_cases i <;> fin_cases j <;> first
      | exact absurd hij (by decide)
      | (simp only []; norm_num; assumption)

/-- Three pairs summing to `sig` give the required four integers if their
smaller members satisfy the triangle and parity conditions below. -/
theorem three_pairs_config (S : Finset ℤ) (sig x₁ x₂ x₃ : ℤ)
    (h12 : x₁ < x₂) (h23 : x₂ < x₃)
    (hhalf : 2 * x₃ < sig) (htri : x₃ < x₁ + x₂)
    (hpar : (2 : ℤ) ∣ (x₁ + x₂ + x₃))
    (m1 : x₁ ∈ S) (m2 : x₂ ∈ S) (m3 : x₃ ∈ S)
    (n1 : sig - x₁ ∈ S) (n2 : sig - x₂ ∈ S) (n3 : sig - x₃ ∈ S) :
    HasPosPairwiseSums S 4 := by
  obtain ⟨t, ht⟩ := hpar
  -- Choose `t` with `2t = x₁ + x₂ + x₃`.
  refine hasPPS_of_four_unordered (a := sig - t) (b := sig - x₃ - (sig - t))
    (c := sig - x₂ - (sig - t)) (d := sig - x₁ - (sig - t))
    (by omega) (by omega) (by omega) (by omega)
    (by omega) (by omega) (by omega) (by omega) (by omega) (by omega)
    ?_ ?_ ?_ ?_ ?_ ?_
  · have : (sig - t) + (sig - x₃ - (sig - t)) = sig - x₃ := by ring
    rw [this]; exact n3
  · have : (sig - t) + (sig - x₂ - (sig - t)) = sig - x₂ := by ring
    rw [this]; exact n2
  · have : (sig - t) + (sig - x₁ - (sig - t)) = sig - x₁ := by ring
    rw [this]; exact n1
  · have : (sig - x₃ - (sig - t)) + (sig - x₂ - (sig - t)) = x₁ := by omega
    rw [this]; exact m1
  · have : (sig - x₃ - (sig - t)) + (sig - x₁ - (sig - t)) = x₂ := by omega
    rw [this]; exact m2
  · have : (sig - x₂ - (sig - t)) + (sig - x₁ - (sig - t)) = x₃ := by omega
    rw [this]; exact m3

/-! ### Fibonacci bounds with an arbitrary lower bound -/

/-- If every ordered triple satisfies `a + b ≤ c` and all elements are at
least `lo`, the two largest elements of a set of size `p + 2` are at least
`fib (p + 1) * lo` and `fib (p + 2) * lo`. -/
lemma tri_free_growth (lo : ℤ) :
    ∀ p : ℕ, ∀ X : Finset ℤ, X.card = p + 2 → (∀ a ∈ X, lo ≤ a) →
      (∀ a ∈ X, ∀ b ∈ X, ∀ c ∈ X, a < b → b < c → a + b ≤ c) →
      ∃ M ∈ X, ∃ M' ∈ X, M' < M ∧ (Nat.fib (p + 2) : ℤ) * lo ≤ M ∧
        (Nat.fib (p + 1) : ℤ) * lo ≤ M' := by
  intro p
  induction p with
  | zero =>
      intro X hcard hlow _
      obtain ⟨a, b, hab, rfl⟩ := Finset.card_eq_two.mp hcard
      have ha := hlow a (by simp)
      have hb := hlow b (by simp)
      rcases lt_or_gt_of_ne hab with h | h
      · exact ⟨b, by simp, a, by simp, h, by simpa using hb, by simpa using ha⟩
      · exact ⟨a, by simp, b, by simp, h, by simpa using ha, by simpa using hb⟩
  | succ p ih =>
      intro X hcard hlow htf
      have hne : X.Nonempty := Finset.card_pos.mp (by omega)
      set M₀ := X.max' hne with hM₀
      have hM₀mem : M₀ ∈ X := X.max'_mem hne
      have hcard' : (X.erase M₀).card = p + 2 := by
        rw [Finset.card_erase_of_mem hM₀mem, hcard]
        omega
      obtain ⟨M, hM, M', hM', hMM', hfM, hfM'⟩ :=
        ih (X.erase M₀) hcard'
          (fun a ha => hlow a (Finset.mem_of_mem_erase ha))
          (fun a ha b hb c hc => htf a (Finset.mem_of_mem_erase ha) b
            (Finset.mem_of_mem_erase hb) c (Finset.mem_of_mem_erase hc))
      have hMX : M ∈ X := Finset.mem_of_mem_erase hM
      have hM'X : M' ∈ X := Finset.mem_of_mem_erase hM'
      have hMlt : M < M₀ := by
        have hle : M ≤ M₀ := X.le_max' M hMX
        have hne' : M ≠ M₀ := Finset.ne_of_mem_erase hM
        omega
      have hsum := htf M' hM'X M hMX M₀ hM₀mem hMM' hMlt
      refine ⟨M₀, hM₀mem, M, hMX, hMlt, ?_, hfM⟩
      have hfibeq : Nat.fib (p + 3) = Nat.fib (p + 1) + Nat.fib (p + 2) := Nat.fib_add_two
      have : ((Nat.fib (p + 3) : ℤ)) * lo
          = (Nat.fib (p + 1) : ℤ) * lo + (Nat.fib (p + 2) : ℤ) * lo := by
        rw [hfibeq]; push_cast; ring
      have h3 : p + 1 + 2 = p + 3 := by omega
      rw [h3, this]
      omega

/-! ### Bounds for the distance between two even elements -/

/-- A nonempty set in `[lo, hi]` whose successive elements differ by at
least `p` satisfies `p * (|S| - 1) ≤ hi - lo`. -/
lemma separated_card_le (p : ℤ) :
    ∀ (k : ℕ) (G : Finset ℤ), G.card = k + 1 →
      (∀ x ∈ G, ∀ y ∈ G, x < y → x + p ≤ y) →
      ∀ lo hi : ℤ, (∀ x ∈ G, lo ≤ x ∧ x ≤ hi) → p * (k : ℤ) ≤ hi - lo := by
  intro k
  induction k with
  | zero =>
      intro G hcard _ lo hi hb
      have hne : G.Nonempty := Finset.card_pos.mp (by omega)
      obtain ⟨x, hx⟩ := hne
      have := hb x hx
      simp only [Nat.cast_zero, mul_zero]
      omega
  | succ k ih =>
      intro G hcard hsep lo hi hb
      have hne : G.Nonempty := Finset.card_pos.mp (by omega)
      set m := G.max' hne with hm
      have hmmem : m ∈ G := G.max'_mem hne
      have hcard' : (G.erase m).card = k + 1 := by
        rw [Finset.card_erase_of_mem hmmem, hcard]
        omega
      have hb' : ∀ x ∈ G.erase m, lo ≤ x ∧ x ≤ m - p := by
        intro x hx
        have hxG := Finset.mem_of_mem_erase hx
        have hne' : x ≠ m := Finset.ne_of_mem_erase hx
        have hlt : x < m := lt_of_le_of_ne (G.le_max' x hxG) hne'
        exact ⟨(hb x hxG).1, by have := hsep x hxG m hmmem hlt; omega⟩
      have hrec := ih (G.erase m) hcard'
        (fun x hx y hy => hsep x (Finset.mem_of_mem_erase hx) y (Finset.mem_of_mem_erase hy))
        lo (m - p) hb'
      have hmhi := (hb m hmmem).2
      push_cast
      push_cast at hrec
      linarith

/-- Even elements `6 ≤ p < q ≤ 2n` of `A` satisfy
`(p - 2) * (q - p) ≤ 4p|D| + 6p` if `A` has no required four integers. -/
theorem odd_pair_bound (n : ℕ) (A D : Finset ℤ)
    (hfree : ¬ HasPosPairwiseSums A 4)
    (hodd : ∀ x : ℤ, 1 ≤ x → x ≤ 2*(n:ℤ) → x % 2 = 1 → x ∉ D → x ∈ A)
    (p q : ℤ) (hp : 6 ≤ p) (hpq : p < q) (hq : q ≤ 2*(n:ℤ))
    (hpe : p % 2 = 0) (hqe : q % 2 = 0)
    (hpA : p ∈ A) (hqA : q ∈ A) :
    (p - 2) * (q - p) ≤ 4 * p * (D.card : ℤ) + 6 * p := by
  classical
  set sig : ℤ := p + q with hsig

  obtain ⟨hh, hhh⟩ : ∃ hh : ℤ, 2 * hh = sig := ⟨(p+q)/2, by omega⟩
  have hhp : p < hh := by omega
  -- Count the odd integers between `p` and `(p + q) / 2`.
  obtain ⟨J, hJ1, hJ2⟩ : ∃ J : ℤ, 2 * J ≤ hh - p ∧ hh - p - 1 ≤ 2 * J :=
    ⟨(hh - p)/2, by omega, by omega⟩
  have hJ0 : 0 ≤ J := by omega
  set S : Finset ℤ := (Finset.Icc (1:ℤ) J).image (fun j => p + 2*j - 1) with hS
  have hSmem : ∀ x ∈ S, p < x ∧ x < hh ∧ x % 2 = 1 := by
    intro x hx
    rw [hS, Finset.mem_image] at hx
    obtain ⟨j, hj, rfl⟩ := hx
    rw [Finset.mem_Icc] at hj
    exact ⟨by omega, by omega, by omega⟩
  have hScard : (S.card : ℤ) = J := by
    rw [hS, Finset.card_image_of_injOn (fun a _ b _ h => by omega), Int.card_Icc]
    omega
  -- Separate those with `sig - x ∈ A` from those with `sig - x ∉ A`.
  set G : Finset ℤ := S.filter (fun x => x ∈ A ∧ sig - x ∈ A) with hG
  set B : Finset ℤ := S.filter (fun x => ¬ (x ∈ A ∧ sig - x ∈ A)) with hB
  have hsplit : G.card + B.card = S.card := by
    rw [hG, hB, Finset.card_filter_add_card_filter_not]
  -- Map each integer of the second kind to a distinct element of `D`.
  have hBD : B.card ≤ D.card := by
    refine Finset.card_le_card_of_injOn (fun x => if x ∈ D then x else sig - x) ?_ ?_
    · intro x hx
      simp only [hB, Finset.mem_coe, Finset.mem_filter] at hx
      obtain ⟨hxS, hbad⟩ := hx
      obtain ⟨hpx, hxh, hxodd⟩ := hSmem x hxS
      by_cases hxD : x ∈ D
      · simp [hxD]
      · have hxA : x ∈ A := hodd x (by omega) (by omega) hxodd hxD
        have hsx : sig - x ∉ A := by tauto
        have hsxodd : (sig - x) % 2 = 1 := by omega
        have : sig - x ∈ D := by
          by_contra hnd
          exact hsx (hodd (sig - x) (by omega) (by omega) hsxodd hnd)
        simpa [hxD] using this
    · intro x hx y hy hxy
      simp only [hB, Finset.mem_coe, Finset.mem_filter] at hx hy
      obtain ⟨hxS, -⟩ := hx
      obtain ⟨hyS, -⟩ := hy
      obtain ⟨hpx, hxh, -⟩ := hSmem x hxS
      obtain ⟨hpy, hyh, -⟩ := hSmem y hyS
      by_cases hxD : x ∈ D <;> by_cases hyD : y ∈ D <;>
        simp only [hxD, hyD, if_true, if_false] at hxy <;> omega
  -- Distinct integers of the first kind differ by at least `p`.
  have hsep : ∀ x ∈ G, ∀ y ∈ G, x < y → x + p ≤ y := by
    intro x hx y hy hxy
    by_contra hlt
    push_neg at hlt
    rw [hG, Finset.mem_filter] at hx hy
    obtain ⟨hxS, hxA, hxsA⟩ := hx
    obtain ⟨hyS, hyA, hysA⟩ := hy
    obtain ⟨hpx, hxh, hxodd⟩ := hSmem x hxS
    obtain ⟨hpy, hyh, hyodd⟩ := hSmem y hyS
    refine hfree (three_pairs_config A sig p x y hpx hxy (by omega) (by omega)
      ⟨(p + x + y)/2, by omega⟩ hpA hxA hyA ?_ hxsA hysA)
    have : sig - p = q := by omega
    rw [this]; exact hqA
  have hGsep : p * ((G.card : ℤ) - 1) ≤ hh - p - 2 := by
    rcases Nat.eq_zero_or_pos G.card with h0 | hpos
    · rw [h0]; push_cast; omega
    · obtain ⟨k, hk⟩ : ∃ k : ℕ, G.card = k + 1 := ⟨G.card - 1, by omega⟩
      have := separated_card_le p k G hk hsep (p + 1) (hh - 1)
        (fun x hx => by
          have hxS := (Finset.mem_filter.mp (hG ▸ hx)).1
          obtain ⟨h1, h2, -⟩ := hSmem x hxS
          exact ⟨by omega, by omega⟩)
      rw [hk]
      push_cast
      linarith
  -- Combine the two cardinality bounds.
  have hJle : J ≤ (G.card : ℤ) + (D.card : ℤ) := by
    have : (G.card : ℤ) + (B.card : ℤ) = (S.card : ℤ) := by exact_mod_cast hsplit
    have hBD' : (B.card : ℤ) ≤ (D.card : ℤ) := by exact_mod_cast hBD
    omega
  have hpJ : p * J ≤ (hh - 2) + p * (D.card : ℤ) := by
    have h1 : p * J ≤ p * ((G.card : ℤ) + (D.card : ℤ)) := by
      apply mul_le_mul_of_nonneg_left hJle (by omega)
    nlinarith [hGsep, h1]
  have h2 : p * (hh - p - 1) ≤ p * (2 * J) := by
    apply mul_le_mul_of_nonneg_left (by omega) (by omega : (0:ℤ) ≤ p)
  nlinarith [hpJ, h2, hhh]

/-! ### Counting pairs with a fixed midpoint -/

/-- Suppose `S` consists of even integers and has no required four integers.
If each smaller member of a pair with midpoint `y` is at least `L` and
`y ≤ fib K * L`, at most `2 * (K - 1)` elements `u ≠ y` have `2y - u ∈ S`. -/
theorem fibre_card_le (S : Finset ℤ) (hfree : ¬ HasPosPairwiseSums S 4)
    (hev : ∀ s ∈ S, (2:ℤ) ∣ s) (y L : ℤ) (K : ℕ) (hK : 2 ≤ K)
    (hL : ∀ u ∈ S, u < y → 2 * y - u ∈ S → L ≤ u)
    (hfib : y ≤ (Nat.fib K : ℤ) * L) :
    (S.filter (fun u => u ≠ y ∧ 2 * y - u ∈ S)).card ≤ 2 * (K - 1) := by
  classical
  have key : (S.filter (fun u => u < y ∧ 2 * y - u ∈ S)).card ≤ K - 1 := by
    by_contra hbig
    push_neg at hbig
    have hcardX : K ≤ (S.filter (fun u => u < y ∧ 2 * y - u ∈ S)).card := by omega
    obtain ⟨X, hXsub, hXcard⟩ := Finset.exists_subset_card_eq hcardX
    have hXmem : ∀ a ∈ X, a ∈ S ∧ a < y ∧ 2 * y - a ∈ S := by
      intro a ha
      have := Finset.mem_filter.mp (hXsub ha)
      exact ⟨this.1, this.2.1, this.2.2⟩
    have htf : ∀ a ∈ X, ∀ b ∈ X, ∀ c ∈ X, a < b → b < c → a + b ≤ c := by
      intro a ha b hb c hc hab hbc
      by_contra hlt
      push_neg at hlt
      obtain ⟨haS, hay, hay'⟩ := hXmem a ha
      obtain ⟨hbS, hby, hby'⟩ := hXmem b hb
      obtain ⟨hcS, hcy, hcy'⟩ := hXmem c hc
      obtain ⟨ka, hka⟩ := hev a haS
      obtain ⟨kb, hkb⟩ := hev b hbS
      obtain ⟨kc, hkc⟩ := hev c hcS
      exact hfree (three_pairs_config S (2 * y) a b c hab hbc (by omega) hlt
        ⟨ka + kb + kc, by omega⟩ haS hbS hcS hay' hby' hcy')
    have hXcard' : X.card = (K - 2) + 2 := by omega
    obtain ⟨M, hM, M', hM', hMM', hfM, hfM'⟩ :=
      tri_free_growth L (K - 2) X hXcard'
        (fun a ha => hL a (hXmem a ha).1 (hXmem a ha).2.1 (hXmem a ha).2.2) htf
    rw [show K - 2 + 2 = K from by omega] at hfM
    have hMy : M < y := (hXmem M hM).2.1
    omega
  have hsplit : S.filter (fun u => u ≠ y ∧ 2 * y - u ∈ S) ⊆
      S.filter (fun u => u < y ∧ 2 * y - u ∈ S) ∪
        S.filter (fun u => y < u ∧ 2 * y - u ∈ S) := by
    intro u hu
    obtain ⟨huS, hune, huS'⟩ := Finset.mem_filter.mp hu
    rcases lt_or_gt_of_ne hune with h | h
    · exact Finset.mem_union_left _ (Finset.mem_filter.mpr ⟨huS, h, huS'⟩)
    · exact Finset.mem_union_right _ (Finset.mem_filter.mpr ⟨huS, h, huS'⟩)
  have hgt : (S.filter (fun u => y < u ∧ 2 * y - u ∈ S)).card ≤
      (S.filter (fun u => u < y ∧ 2 * y - u ∈ S)).card := by
    apply Finset.card_le_card_of_injOn (fun u => 2 * y - u)
    · intro u hu
      obtain ⟨huS, hlt, huS'⟩ := Finset.mem_filter.mp hu
      dsimp only
      refine Finset.mem_filter.mpr ⟨huS', by omega, ?_⟩
      have : 2 * y - (2 * y - u) = u := by ring
      rw [this]; exact huS
    · intro a _ b _ hab
      dsimp only at hab
      omega
  calc (S.filter (fun u => u ≠ y ∧ 2 * y - u ∈ S)).card
      ≤ (S.filter (fun u => u < y ∧ 2 * y - u ∈ S) ∪
          S.filter (fun u => y < u ∧ 2 * y - u ∈ S)).card := Finset.card_le_card hsplit
    _ ≤ (S.filter (fun u => u < y ∧ 2 * y - u ∈ S)).card +
          (S.filter (fun u => y < u ∧ 2 * y - u ∈ S)).card := Finset.card_union_le _ _
    _ ≤ 2 * (K - 1) := by omega

/-! ### Counting all pairs by their midpoints -/

/-- For a set of even integers in `[lo, hi]`, sum the bounds for pairs with
each midpoint to bound the total number of ordered pairs of distinct elements. -/
theorem cluster_sum_le (S : Finset ℤ) (lo hi : ℤ) (bnd : ℤ → ℕ)
    (hmem : ∀ s ∈ S, lo ≤ s ∧ s ≤ hi ∧ (2:ℤ) ∣ s)
    (hbnd : ∀ y ∈ Finset.Icc (lo + 1) (hi - 1),
      (S.filter (fun u => u ≠ y ∧ 2 * y - u ∈ S)).card ≤ bnd y) :
    S.card * S.card ≤ S.card + ∑ y ∈ Finset.Icc (lo + 1) (hi - 1), bnd y := by
  classical
  have hcover : S.offDiag ⊆ (Finset.Icc (lo + 1) (hi - 1)).biUnion
      (fun y => (S.filter (fun u => u ≠ y ∧ 2 * y - u ∈ S)).image
        (fun u => (u, 2 * y - u))) := by
    intro p hp
    obtain ⟨huS, hvS, hne⟩ := Finset.mem_offDiag.mp hp
    obtain ⟨ku, hku⟩ := (hmem p.1 huS).2.2
    obtain ⟨kv, hkv⟩ := (hmem p.2 hvS).2.2
    have hu := hmem p.1 huS
    have hv := hmem p.2 hvS
    refine Finset.mem_biUnion.mpr ⟨(p.1 + p.2) / 2, ?_, ?_⟩
    · rw [Finset.mem_Icc]
      constructor <;> omega
    · refine Finset.mem_image.mpr ⟨p.1, Finset.mem_filter.mpr ⟨huS, by omega, ?_⟩, ?_⟩
      · have : 2 * ((p.1 + p.2) / 2) - p.1 = p.2 := by omega
        rw [this]; exact hvS
      · have : 2 * ((p.1 + p.2) / 2) - p.1 = p.2 := by omega
        rw [this]
  have hchain : S.offDiag.card ≤ ∑ y ∈ Finset.Icc (lo + 1) (hi - 1), bnd y := by
    refine le_trans (Finset.card_le_card hcover) (le_trans Finset.card_biUnion_le ?_)
    exact Finset.sum_le_sum (fun y hy => le_trans Finset.card_image_le (hbnd y hy))
  rw [Finset.offDiag_card] at hchain
  omega

/-! ### A cardinality bound using four Fibonacci estimates -/

/-- Bound `|S|²` by counting pairs according to their midpoint. Use
`fib 3 = 2`, `fib 4 = 3`, `fib 5 = 5`, and `fib 6 = 8` to bound the number
of pairs. The parameters `c2`, `c3`, and `c5` bound the numbers of midpoints
that require the successive larger estimates. -/
theorem even_cluster_levels (S : Finset ℤ) (lo hi N c2 c3 c5 : ℤ)
    (hmem : ∀ s ∈ S, lo ≤ s ∧ s ≤ hi ∧ (2:ℤ) ∣ s)
    (hfree : ¬ HasPosPairwiseSums S 4)
    (hfall : 8 * hi ≤ 120 * lo + 15)
    (hN : hi - lo - 1 ≤ N) (hN0 : 0 ≤ N)
    (hc2 : 0 ≤ c2) (h2 : 2 * hi - 1 - 6 * lo ≤ 3 * c2)
    (hc3 : 0 ≤ c3) (h3 : 3 * hi - 1 - 15 * lo ≤ 5 * c3)
    (hc5 : 0 ≤ c5) (h5 : 5 * hi - 1 - 45 * lo ≤ 9 * c5) :
    (S.card : ℤ) * S.card ≤ S.card + 4 * N + 2 * (c2 + c3 + c5) := by
  classical
  have hev : ∀ s ∈ S, (2:ℤ) ∣ s := fun s hs => (hmem s hs).2.2
  set P2 : ℤ → Prop := fun y => 2 * lo < y ∧ 3 * y < 2 * hi with hP2
  set P3 : ℤ → Prop := fun y => 3 * lo < y ∧ 5 * y < 3 * hi with hP3
  set P5 : ℤ → Prop := fun y => 5 * lo < y ∧ 9 * y < 5 * hi with hP5
  set bnd : ℤ → ℕ := fun y => 4 + 2 * (if P2 y then 1 else 0)
    + 2 * (if P3 y then 1 else 0) + 2 * (if P5 y then 1 else 0) with hbnddef
  have hf3 : (Nat.fib 3 : ℤ) = 2 := by norm_num [Nat.fib]
  have hf4 : (Nat.fib 4 : ℤ) = 3 := by norm_num [Nat.fib]
  have hf5 : (Nat.fib 5 : ℤ) = 5 := by norm_num [Nat.fib]
  have hf6 : (Nat.fib 6 : ℤ) = 8 := by norm_num [Nat.fib]
  have hbnd : ∀ y ∈ Finset.Icc (lo + 1) (hi - 1),
      (S.filter (fun u => u ≠ y ∧ 2 * y - u ∈ S)).card ≤ bnd y := by
    intro y hy
    rw [Finset.mem_Icc] at hy
    have hL : ∀ u ∈ S, u < y → 2 * y - u ∈ S → max lo (2 * y - hi) ≤ u := by
      intro u hu _ hu2
      have h1 := (hmem u hu).1
      have h2' := (hmem _ hu2).2.1
      exact max_le h1 (by omega)
    have hlomax : lo ≤ max lo (2 * y - hi) := le_max_left _ _
    have hupmax : 2 * y - hi ≤ max lo (2 * y - hi) := le_max_right _ _
    by_cases hb2 : P2 y
    · by_cases hb3 : P3 y
      · by_cases hb5 : P5 y
        · -- Use `fib 6 = 8` in the remaining case.
          have hkey := fibre_card_le S hfree hev y (max lo (2 * y - hi)) 6 (by norm_num) hL
            (by rw [hf6]; rcases le_or_gt y (8 * lo) with h | h
                · omega
                · have : 15 * y ≥ 8 * hi := by omega
                  omega)
          simp only [hbnddef, if_pos hb2, if_pos hb3, if_pos hb5]
          omega
        · have hkey := fibre_card_le S hfree hev y (max lo (2 * y - hi)) 5 (by norm_num) hL
            (by rw [hf5]; simp only [hP5, not_and_or, not_lt] at hb5; rcases hb5 with h | h <;> omega)
          simp only [hbnddef, if_pos hb2, if_pos hb3, if_neg hb5]
          omega
      · have hkey := fibre_card_le S hfree hev y (max lo (2 * y - hi)) 4 (by norm_num) hL
          (by rw [hf4]; simp only [hP3, not_and_or, not_lt] at hb3; rcases hb3 with h | h <;> omega)
        simp only [hbnddef, if_pos hb2, if_neg hb3]
        omega
    · have hkey := fibre_card_le S hfree hev y (max lo (2 * y - hi)) 3 (by norm_num) hL
        (by rw [hf3]; simp only [hP2, not_and_or, not_lt] at hb2; rcases hb2 with h | h <;> omega)
      simp only [hbnddef, if_neg hb2]
      omega
  have hmain := cluster_sum_le S lo hi bnd hmem hbnd

  have hsum : ∑ y ∈ Finset.Icc (lo + 1) (hi - 1), bnd y
      = 4 * (Finset.Icc (lo + 1) (hi - 1)).card
        + 2 * ((Finset.Icc (lo + 1) (hi - 1)).filter P2).card
        + 2 * ((Finset.Icc (lo + 1) (hi - 1)).filter P3).card
        + 2 * ((Finset.Icc (lo + 1) (hi - 1)).filter P5).card := by
    simp only [hbnddef, Finset.sum_add_distrib, Finset.sum_const, smul_eq_mul,
      ← Finset.mul_sum, Finset.card_filter]
    ring
  -- Bound the numbers of midpoints satisfying `P2`, `P3`, and `P5`.
  have hcard2 : ((Finset.Icc (lo + 1) (hi - 1)).filter P2).card ≤ c2.toNat := by
    have hsub : (Finset.Icc (lo + 1) (hi - 1)).filter P2 ⊆ Finset.Icc (2 * lo + 1) (2 * lo + c2) := by
      intro y hy
      obtain ⟨-, hy2⟩ := Finset.mem_filter.mp hy
      simp only [hP2] at hy2
      rw [Finset.mem_Icc]
      omega
    refine le_trans (Finset.card_le_card hsub) ?_
    rw [Int.card_Icc]
    omega
  have hcard3 : ((Finset.Icc (lo + 1) (hi - 1)).filter P3).card ≤ c3.toNat := by
    have hsub : (Finset.Icc (lo + 1) (hi - 1)).filter P3 ⊆ Finset.Icc (3 * lo + 1) (3 * lo + c3) := by
      intro y hy
      obtain ⟨-, hy2⟩ := Finset.mem_filter.mp hy
      simp only [hP3] at hy2
      rw [Finset.mem_Icc]
      omega
    refine le_trans (Finset.card_le_card hsub) ?_
    rw [Int.card_Icc]
    omega
  have hcard5 : ((Finset.Icc (lo + 1) (hi - 1)).filter P5).card ≤ c5.toNat := by
    have hsub : (Finset.Icc (lo + 1) (hi - 1)).filter P5 ⊆ Finset.Icc (5 * lo + 1) (5 * lo + c5) := by
      intro y hy
      obtain ⟨-, hy2⟩ := Finset.mem_filter.mp hy
      simp only [hP5] at hy2
      rw [Finset.mem_Icc]
      omega
    refine le_trans (Finset.card_le_card hsub) ?_
    rw [Int.card_Icc]
    omega
  have hIcc : ((Finset.Icc (lo + 1) (hi - 1)).card : ℤ) ≤ N := by
    rw [Int.card_Icc]
    omega
  have hfin : (S.card : ℤ) * S.card ≤ (S.card : ℤ)
      + (4 * (Finset.Icc (lo + 1) (hi - 1)).card
        + 2 * ((Finset.Icc (lo + 1) (hi - 1)).filter P2).card
        + 2 * ((Finset.Icc (lo + 1) (hi - 1)).filter P3).card
        + 2 * ((Finset.Icc (lo + 1) (hi - 1)).filter P5).card : ℕ) := by
    rw [← hsum]
    exact_mod_cast hmain
  push_cast at hfin
  have e2 : (((Finset.Icc (lo + 1) (hi - 1)).filter P2).card : ℤ) ≤ c2 := by
    have := hcard2
    omega
  have e3 : (((Finset.Icc (lo + 1) (hi - 1)).filter P3).card : ℤ) ≤ c3 := by
    have := hcard3
    omega
  have e5 : (((Finset.Icc (lo + 1) (hi - 1)).filter P5).card : ℤ) ≤ c5 := by
    have := hcard5
    omega
  linarith

/-! ### The bound `d ≤ 35` -/

/-- For `d ≥ 36`, the lower bound on `R` contradicts the bound for a set
of diameter `4d + 31`. Split according to the six possible values of `6s - d`. -/
theorem cluster_endgame (d s R c2 c3 c5 : ℤ)
    (hd : 36 ≤ d) (hs1 : d ≤ 6*s) (hs2 : 6*s ≤ d + 5) (hR : d + 4 - s ≤ R)
    (hc2 : 3*c2 ≤ 8*d + 55 - 8*s) (hc3 : 5*c3 ≤ 12*d + 72 - 24*s)
    (hc5 : 9*c5 ≤ 20*d + 82 - 80*s)
    (hcl : R * R ≤ R + 4*(4*d + 30) + 2*(c2 + c3 + c5)) : False := by
  have hmono : (d + 4 - s) * (d + 4 - s) - (d + 4 - s) ≤ R * R - R := by
    nlinarith [mul_nonneg (show (0:ℤ) ≤ R - (d + 4 - s) by omega)
      (show (0:ℤ) ≤ R + (d + 4 - s) - 1 by omega)]
  have hk : 6*s = d ∨ 6*s = d + 1 ∨ 6*s = d + 2 ∨ 6*s = d + 3 ∨ 6*s = d + 4 ∨
      6*s = d + 5 := by omega
  rcases hk with hk | hk | hk | hk | hk | hk
  · have hdm : (36:ℤ) ≤ d := by omega
    have e1 : (6*s) * (6*s) = d * d := by rw [hk]
    have e2 : 6 * (d*s) = d * d := by rw [show d * d = d * (6*s) from by rw [hk]]; ring
    nlinarith [hmono, hcl, hdm, e1, e2, sq_nonneg (d - 36)]
  · have hdm : (41:ℤ) ≤ d := by omega
    have e1 : (6*s) * (6*s) = (d+1) * (d+1) := by rw [hk]
    have e2 : 6 * (d*s) = d * (d+1) := by rw [show d * (d+1) = d * (6*s) from by rw [hk]]; ring
    nlinarith [hmono, hcl, hdm, e1, e2, sq_nonneg (d - 41)]
  · have hdm : (40:ℤ) ≤ d := by omega
    have e1 : (6*s) * (6*s) = (d+2) * (d+2) := by rw [hk]
    have e2 : 6 * (d*s) = d * (d+2) := by rw [show d * (d+2) = d * (6*s) from by rw [hk]]; ring
    nlinarith [hmono, hcl, hdm, e1, e2, sq_nonneg (d - 40)]
  · have hdm : (39:ℤ) ≤ d := by omega
    have e1 : (6*s) * (6*s) = (d+3) * (d+3) := by rw [hk]
    have e2 : 6 * (d*s) = d * (d+3) := by rw [show d * (d+3) = d * (6*s) from by rw [hk]]; ring
    nlinarith [hmono, hcl, hdm, e1, e2, sq_nonneg (d - 39)]
  · have hdm : (38:ℤ) ≤ d := by omega
    have e1 : (6*s) * (6*s) = (d+4) * (d+4) := by rw [hk]
    have e2 : 6 * (d*s) = d * (d+4) := by rw [show d * (d+4) = d * (6*s) from by rw [hk]]; ring
    nlinarith [hmono, hcl, hdm, e1, e2, sq_nonneg (d - 38)]
  · have hdm : (37:ℤ) ≤ d := by omega
    have e1 : (6*s) * (6*s) = (d+5) * (d+5) := by rw [hk]
    have e2 : 6 * (d*s) = d * (d+5) := by rw [show d * (d+5) = d * (6*s) from by rw [hk]]; ring
    nlinarith [hmono, hcl, hdm, e1, e2, sq_nonneg (d - 37)]

/-- If `A ⊆ [1, 2n]` has at least `n + 4` elements and no required four
integers, at most `35` odd integers are missing from `A`. -/
theorem missingOdds_card_le_35 (n : ℕ) (A : Finset ℤ)
    (hA : A ⊆ Finset.Icc (1:ℤ) (2*(n:ℤ))) (hcard : n + 4 ≤ A.card)
    (hfree : ¬ HasPosPairwiseSums A 4) :
    (missingOdds n A).card ≤ 35 := by
  classical
  by_contra hbig
  push_neg at hbig
  set D : Finset ℤ := missingOdds n A with hD
  have hd36 : 36 ≤ D.card := hbig
  set d : ℤ := (D.card : ℤ) with hdz
  have hd36Z : (36:ℤ) ≤ d := by rw [hdz]; exact_mod_cast hd36
  have hodd : ∀ x : ℤ, 1 ≤ x → x ≤ 2*(n:ℤ) → x % 2 = 1 → x ∉ D → x ∈ A := by
    intro x h1 h2 h3 hnotD
    by_contra hxA
    exact hnotD (Finset.mem_filter.mpr ⟨Finset.mem_Icc.mpr ⟨h1, h2⟩, h3, hxA⟩)
  set E : Finset ℤ := A.filter (fun x => x % 2 = 0) with hE
  have hEcard : D.card + 4 ≤ E.card := evens_card_lower n A hA hcard
  have hEcardZ : d + 4 ≤ (E.card : ℤ) := by rw [hdz]; exact_mod_cast hEcard
  have hEfacts : ∀ x ∈ E, x ∈ A ∧ x % 2 = 0 ∧ 2 ≤ x ∧ x ≤ 2*(n:ℤ) := by
    intro x hxE
    obtain ⟨hxA, hxe⟩ := Finset.mem_filter.mp hxE
    have hbounds := Finset.mem_Icc.mp (hA hxA)
    exact ⟨hxA, hxe, by omega, by omega⟩
  -- Split at `2s + 2`, where `d ≤ 6s ≤ d + 5`.
  obtain ⟨s, hs1, hs2⟩ : ∃ s : ℤ, d ≤ 6*s ∧ 6*s ≤ d + 5 := ⟨(d+5)/6, by omega, by omega⟩
  set Esm : Finset ℤ := E.filter (fun x => x < 2*s + 2) with hEsm
  set Et : Finset ℤ := E.filter (fun x => 2*s + 2 ≤ x) with hEt
  have hpart : Esm.card + Et.card = E.card := by
    have hneg : E.filter (fun x => ¬ (x < 2*s + 2)) = Et := by
      rw [hEt]; apply Finset.filter_congr; intro x _; constructor <;> intro h <;> omega
    rw [hEsm, ← hneg, Finset.card_filter_add_card_filter_not]
  -- Halving maps the smaller even elements injectively into `[1, s]`.
  have hEsmcard : (Esm.card : ℤ) ≤ s := by
    have hsub : Esm.card ≤ (Finset.Icc (1:ℤ) s).card := by
      apply Finset.card_le_card_of_injOn (fun x => x / 2)
      · intro x hx
        simp only [hEsm, Finset.mem_coe, Finset.mem_filter] at hx
        obtain ⟨hxE, hxlt⟩ := hx
        obtain ⟨-, hxe, hx2, -⟩ := hEfacts x hxE
        simp only [Finset.mem_coe, Finset.mem_Icc]
        omega
      · intro x hx y hy hxy
        simp only [hEsm, Finset.mem_coe, Finset.mem_filter] at hx hy
        have hxe := (hEfacts x hx.1).2.1
        have hye := (hEfacts y hy.1).2.1
        simp only [] at hxy
        omega
    rw [Int.card_Icc] at hsub
    have hs0 : (0:ℤ) ≤ s := by omega
    omega
  have hRlb : d + 4 - s ≤ (Et.card : ℤ) := by
    have hpartZ : (Esm.card : ℤ) + (Et.card : ℤ) = (E.card : ℤ) := by exact_mod_cast hpart
    omega
  have hEtne : Et.Nonempty := by
    refine Finset.card_pos.mp ?_
    have : (0:ℤ) < (Et.card : ℤ) := by omega
    exact_mod_cast this
  set m : ℤ := Et.min' hEtne with hm
  have hmEt : m ∈ Et := Et.min'_mem hEtne
  have hmE : m ∈ E := (Finset.mem_filter.mp hmEt).1
  have hmT : 2*s + 2 ≤ m := (Finset.mem_filter.mp hmEt).2
  obtain ⟨hmA, hme, hm2, hmub⟩ := hEfacts m hmE
  -- The larger even elements have diameter at most `4d + 31`.
  have hdiam : ∀ x ∈ Et, x ≤ m + (4*d + 31) := by
    intro x hxEt
    rcases eq_or_lt_of_le (Et.min'_le x hxEt) with heq | hlt
    · omega
    · obtain ⟨hxA, hxe, hx2, hxub⟩ := hEfacts x (Finset.mem_filter.mp hxEt).1
      have hb := odd_pair_bound n A D hfree hodd m x (by omega) hlt hxub hme hxe hmA hxA
      by_contra hgt
      push_neg at hgt
      nlinarith [hb, mul_le_mul_of_nonneg_left (show (4*d + 32) ≤ x - m by omega)
        (show (0:ℤ) ≤ m - 2 by omega)]
  have hEtfree : ¬ HasPosPairwiseSums Et 4 := by
    rintro ⟨b, hinj, hpos, hsums⟩
    refine hfree ⟨b, hinj, hpos, fun i j hij => ?_⟩
    exact (hEfacts _ (Finset.mem_filter.mp (hsums i j hij)).1).1
  -- Choose bounds for the three sets of midpoints.
  obtain ⟨c2, hc2a, hc2b⟩ : ∃ c2 : ℤ, 8*d + 53 - 8*s ≤ 3*c2 ∧ 3*c2 ≤ 8*d + 55 - 8*s :=
    ⟨(8*d + 55 - 8*s)/3, by omega, by omega⟩
  obtain ⟨c3, hc3a, hc3b⟩ : ∃ c3 : ℤ, 12*d + 68 - 24*s ≤ 5*c3 ∧ 5*c3 ≤ 12*d + 72 - 24*s :=
    ⟨(12*d + 72 - 24*s)/5, by omega, by omega⟩
  obtain ⟨c5, hc5a, hc5b⟩ : ∃ c5 : ℤ, 20*d + 74 - 80*s ≤ 9*c5 ∧ 9*c5 ≤ 20*d + 82 - 80*s :=
    ⟨(20*d + 82 - 80*s)/9, by omega, by omega⟩
  have hcl := even_cluster_levels Et m (m + (4*d + 31)) (4*d + 30) c2 c3 c5
    (fun x hx => ⟨Et.min'_le x hx, hdiam x hx, by
      have := (hEfacts x (Finset.mem_filter.mp hx).1).2.1
      omega⟩)
    hEtfree (by omega) (by omega) (by omega)
    (by omega) (by omega) (by omega) (by omega) (by omega) (by omega)
  -- The cardinality bound contradicts `R ≥ d + 4 - s`.
  exact cluster_endgame d s (Et.card : ℤ) c2 c3 c5 hd36Z hs1 hs2 hRlb
    (by omega) (by omega) (by omega) hcl

/-! ### Bounding the even elements near `2n` -/

/-- Bound the even elements of `A` in `[2n - 4d - 6, 2n]` by
`|TOP|² ≤ |TOP| + 4 * (4d + 5)` when `n ≥ 3d + 5`, where `d = |D|`. -/
theorem top_cluster_card (n : ℕ) (A D TOP : Finset ℤ)
    (hfree : ¬ HasPosPairwiseSums A 4)
    (hn : 3*(D.card:ℤ) + 5 ≤ (n:ℤ))
    (hTOP : ∀ x ∈ TOP, x ∈ A ∧ x % 2 = 0 ∧ 2*(n:ℤ) - 4*(D.card:ℤ) - 6 ≤ x ∧ x ≤ 2*(n:ℤ)) :
    (TOP.card : ℤ) * TOP.card ≤ (TOP.card : ℤ) + 4 * (4*(D.card:ℤ) + 5) := by
  classical
  have hTfree : ¬ HasPosPairwiseSums TOP 4 := by
    rintro ⟨b, hinj, hpos, hsums⟩
    exact hfree ⟨b, hinj, hpos, fun i j hij => (hTOP _ (hsums i j hij)).1⟩
  have := even_cluster_levels TOP (2*(n:ℤ) - 4*(D.card:ℤ) - 6) (2*(n:ℤ))
    (4*(D.card:ℤ) + 5) 0 0 0
    (fun x hx => ⟨(hTOP x hx).2.2.1, (hTOP x hx).2.2.2, by
      have := (hTOP x hx).2.1; omega⟩)
    hTfree (by omega) (by omega) (by omega)
    (le_refl 0) (by omega) (le_refl 0) (by omega) (le_refl 0) (by omega)
  linarith

/-! ### Bounding the even elements below `2s` -/

/-- Bound the number of even elements of `A` in `[2, 2s]` by `k - 1`
when `fib (k + 1) > s` and `2s + 6|D| ≤ 2n`. -/
theorem small_evens_fib (n : ℕ) (A D S : Finset ℤ) (k : ℕ) (s : ℤ)
    (hfree : ¬ HasPosPairwiseSums A 4)
    (hodd : ∀ x : ℤ, 1 ≤ x → x ≤ 2*(n:ℤ) → x % 2 = 1 → x ∉ D → x ∈ A)
    (hk : 2 ≤ k) (hfib : s < (Nat.fib (k+1) : ℤ))
    (hcap : 2*s + 6*(D.card:ℤ) ≤ 2*(n:ℤ))
    (hS : ∀ x ∈ S, x ∈ A ∧ x % 2 = 0 ∧ 2 ≤ x ∧ x ≤ 2*s) :
    S.card < k := by
  classical
  by_contra hbig
  push_neg at hbig
  set L : Finset ℤ := S.image (fun x => x / 2) with hLdef
  have hLcard : L.card = S.card := by
    refine Finset.card_image_of_injOn ?_
    intro u hu v hv huv
    have hue := (hS u hu).2.1
    have hve := (hS v hv).2.1
    have huv' : u / 2 = v / 2 := huv
    omega
  have hLmem : ∀ g ∈ L, 2*g ∈ A ∧ 1 ≤ g ∧ g ≤ s := by
    intro g hg
    rw [hLdef, Finset.mem_image] at hg
    obtain ⟨x, hxS, rfl⟩ := hg
    obtain ⟨hxA, hxe, hx2, hxub⟩ := hS x hxS
    have h2g : 2 * (x/2) = x := by omega
    exact ⟨by rwa [h2g], by omega, by omega⟩
  have hLtf : ∀ g₁ ∈ L, ∀ g₂ ∈ L, ∀ g₃ ∈ L, g₁ < g₂ → g₂ < g₃ → g₁ + g₂ ≤ g₃ := by
    intro g1 hg1 g2 hg2 g3 hg3 h12 h23
    by_contra hgt
    push_neg at hgt
    obtain ⟨hA1, hp1, hu1⟩ := hLmem g1 hg1
    obtain ⟨hA2, hp2, hu2⟩ := hLmem g2 hg2
    obtain ⟨hA3, hp3, hu3⟩ := hLmem g3 hg3
    refine T_star n A D hfree hodd (g1+g2-g3) (g1+g3-g2) (g2+g3-g1)
      (by omega) (by omega) (by omega) (by omega) (by omega) ?_ ?_ ?_ (by omega)
    · have h : (g1+g2-g3) + (g1+g3-g2) = 2*g1 := by ring
      rw [h]; exact hA1
    · have h : (g1+g2-g3) + (g2+g3-g1) = 2*g2 := by ring
      rw [h]; exact hA2
    · have h : (g1+g3-g2) + (g2+g3-g1) = 2*g3 := by ring
      rw [h]; exact hA3
  obtain ⟨X, hXsub, hXcard⟩ := Finset.exists_subset_card_eq (show k ≤ L.card by omega)
  obtain ⟨M, hM, M', hM', hMM', hf1, hf2⟩ :=
    triangle_free_fib k hk X hXcard
      (fun a ha => (hLmem a (hXsub ha)).2.1)
      (fun a ha b hb c hc => hLtf a (hXsub ha) b (hXsub hb) c (hXsub hc))
  have hMle := (hLmem M (hXsub hM)).2.2
  omega

/-! ### The bound `d ≤ 23` -/

/-- The cardinality bound gives a contradiction for `24 ≤ d ≤ 35`. -/
theorem cluster_endgame23 (d q c2 R : ℤ)
    (hd1 : 24 ≤ d) (hd2 : d ≤ 35)
    (hq2 : 38*q ≤ 8*d + 12)
    (hc2 : 3*c2 ≤ 8*d + 2*q - 147) (hR : d - 2 ≤ R)
    (hcl : R*R ≤ R + 4*(4*d + 5 + q) + 2*c2) : False := by
  have hmono : (d - 2) * (d - 2) - (d - 2) ≤ R * R - R := by
    nlinarith [mul_nonneg (show (0:ℤ) ≤ R - (d - 2) by omega)
      (show (0:ℤ) ≤ R + (d - 2) - 1 by omega)]
  have key : (d - 2) * (d - 2) - (d - 2) ≤ 4*(4*d + 5 + q) + 2*c2 := by linarith
  have key2 : d*d ≤ 21*d + 14 + 4*q + 2*c2 := by nlinarith [key]
  interval_cases d <;> omega

/-- The corresponding contradiction for `31 ≤ d ≤ 35`, using the split at `12`. -/
theorem cluster_endgame23b (d q c2 c3 c5 R : ℤ)
    (hd1 : 31 ≤ d) (hd2 : d ≤ 35)
    (hq2 : 12*q ≤ 8*d + 12)
    (hc2 : 3*c2 ≤ 8*d + 2*q - 43) (hc3 : 5*c3 ≤ 12*d + 3*q - 147)
    (hc5 : 9*c5 ≤ 20*d + 5*q - 523) (hR : d ≤ R)
    (hcl : R*R ≤ R + 4*(4*d + 5 + q) + 2*(c2 + c3 + c5)) : False := by
  have hmono : d * d - d ≤ R * R - R := by
    nlinarith [mul_nonneg (show (0:ℤ) ≤ R - d by omega)
      (show (0:ℤ) ≤ R + d - 1 by omega)]
  have key : d * d - d ≤ 4*(4*d + 5 + q) + 2*(c2 + c3 + c5) := by linarith
  interval_cases d <;> omega

/-- Improve the bound on missing odd integers to `23` for `n ≥ 109`.
Split the even elements at `38` when `d ≤ 30`, and at `12` otherwise.
Bound the smaller elements using Fibonacci numbers and the larger elements
using their diameter. For `d = 35`, use that `4`, `6`, and `8` cannot all lie in `A`. -/
theorem missingOdds_card_le_23 (n : ℕ) (A : Finset ℤ)
    (hA : A ⊆ Finset.Icc (1:ℤ) (2*(n:ℤ))) (hcard : n + 4 ≤ A.card)
    (hfree : ¬ HasPosPairwiseSums A 4) (hn : 109 ≤ n) :
    (missingOdds n A).card ≤ 23 := by
  classical
  by_contra hbig
  push_neg at hbig
  set D : Finset ℤ := missingOdds n A with hD
  have hd35 : D.card ≤ 35 := missingOdds_card_le_35 n A hA hcard hfree
  have hd24 : 24 ≤ D.card := hbig
  set d : ℤ := (D.card : ℤ) with hdz
  have hd24Z : (24:ℤ) ≤ d := by rw [hdz]; exact_mod_cast hd24
  have hd35Z : d ≤ 35 := by rw [hdz]; exact_mod_cast hd35
  have hnZ : (109:ℤ) ≤ (n:ℤ) := by exact_mod_cast hn
  have hodd : ∀ x : ℤ, 1 ≤ x → x ≤ 2*(n:ℤ) → x % 2 = 1 → x ∉ D → x ∈ A := by
    intro x h1 h2 h3 hnotD
    by_contra hxA
    exact hnotD (Finset.mem_filter.mpr ⟨Finset.mem_Icc.mpr ⟨h1, h2⟩, h3, hxA⟩)
  set E : Finset ℤ := A.filter (fun x => x % 2 = 0) with hE
  have hEcard : D.card + 4 ≤ E.card := evens_card_lower n A hA hcard
  have hEcardZ : d + 4 ≤ (E.card : ℤ) := by rw [hdz]; exact_mod_cast hEcard
  have hEfacts : ∀ x ∈ E, x ∈ A ∧ x % 2 = 0 ∧ 2 ≤ x ∧ x ≤ 2*(n:ℤ) := by
    intro x hxE
    obtain ⟨hxA, hxe⟩ := Finset.mem_filter.mp hxE
    have hbounds := Finset.mem_Icc.mp (hA hxA)
    exact ⟨hxA, hxe, by omega, by omega⟩
  have hEfree : ∀ S : Finset ℤ, S ⊆ E → ¬ HasPosPairwiseSums S 4 := by
    intro S hSE ⟨b, hinj, hpos, hsums⟩
    exact hfree ⟨b, hinj, hpos, fun i j hij => (hEfacts _ (hSE (hsums i j hij))).1⟩
  rcases le_or_gt D.card 30 with hcase | hcase
  · -- At most six even elements lie below `40`.
    have hd30Z : d ≤ 30 := by rw [hdz]; exact_mod_cast hcase
    set Esm : Finset ℤ := E.filter (fun x => x ≤ 38) with hEsm
    set Et : Finset ℤ := E.filter (fun x => ¬ (x ≤ 38)) with hEt
    have hpart : Esm.card + Et.card = E.card := by
      rw [hEsm, hEt, Finset.card_filter_add_card_filter_not]
    have hsm : Esm.card < 7 := by
      refine small_evens_fib n A D Esm 7 19 hfree hodd (by norm_num)
        (by norm_num [Nat.fib]) (by omega) ?_
      intro x hx
      obtain ⟨hxE, hxle⟩ := Finset.mem_filter.mp hx
      obtain ⟨hxA, hxe, hx2, -⟩ := hEfacts x hxE
      exact ⟨hxA, hxe, hx2, by omega⟩
    have hRlb : d - 2 ≤ (Et.card : ℤ) := by
      have hpartZ : (Esm.card : ℤ) + (Et.card : ℤ) = (E.card : ℤ) := by exact_mod_cast hpart
      have : (Esm.card : ℤ) ≤ 6 := by exact_mod_cast Nat.lt_succ_iff.mp hsm
      omega
    have hEtne : Et.Nonempty := by
      refine Finset.card_pos.mp ?_
      have : (0:ℤ) < (Et.card : ℤ) := by omega
      exact_mod_cast this
    set m : ℤ := Et.min' hEtne with hm
    have hmEt : m ∈ Et := Et.min'_mem hEtne
    have hmE : m ∈ E := (Finset.mem_filter.mp hmEt).1
    have hmT : 38 < m := by
      have := (Finset.mem_filter.mp hmEt).2
      omega
    obtain ⟨hmA, hme, hm2, hmub⟩ := hEfacts m hmE
    obtain ⟨q, hq1, hq2⟩ : ∃ q : ℤ, 8*d - 25 ≤ 38*q ∧ 38*q ≤ 8*d + 12 :=
