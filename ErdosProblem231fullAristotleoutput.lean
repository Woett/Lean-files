  · obtain ⟨ t, ht, ht' ⟩ := hs;
    contrapose! h;
    exact ⟨ s ++ ht, by aesop, s, by aesop, by simpa [ decideAbelianSquare_iff ] using h ⟩;
  · contrapose! h;
    -- Since $x$ is a prefix of $s$ and $s$ is a suffix of $w$, $x$ is also a subword of $w$.
    obtain ⟨x, hx_prefix, hx_ab_sq⟩ := h;
    have hx_subword : x <:+: w := by
      grind;
    exact ⟨ x, hx_subword, by simpa using decideAbelianSquare_iff x |>.1 ( by simpa using hx_ab_sq ) ⟩

/-
The word g(a) is abelian square-free.
-/
lemma g_a_free : IsFactorFree (g a) := by
  rw [← decideFactorFree_iff]
  native_decide

/-
If h is a factor-free morphism and a is a factor-free letter, then all iterations h^n(a) are factor-free.
-/
lemma iterate_factor_free {α : Type*} (h : Morphism α) (a : α) (n : ℕ)
  (h_asf : IsFactorFreeMorphism h) (ha : IsFactorFree [a]) :
  IsFactorFree (iterateMorphism h n a) := by
    -- We proceed by induction on $n$.
    induction' n with k ih;
    · exact ha;
    · convert h_asf _ ih

/-
Alphabet is a finite type.
-/
instance : Fintype Alphabet where
  elems := {a, b, c, d}
  complete := by
    intro x
    cases x <;> simp

/-
Inspecting the types of the key lemmas.
-/
#print factor_check_factor
#print g_satisfies_finite_check

/-
The bound N provided by the factor check lemma.
-/
noncomputable def keranen_N : ℕ := (factor_check_factor g).choose

/-
Computational verification that g preserves factor-freeness for words up to length 3.
-/
def allWords (n : ℕ) : List (List Alphabet) :=
  match n with
  | 0 => [[]]
  | n + 1 => (allWords n).flatMap fun w => [a, b, c, d].map fun x => x :: w

def decideCheck (n : ℕ) : Bool :=
  (List.range (n + 1)).all fun len =>
    (allWords len).all fun w =>
      if decideFactorFree w then decideFactorFree (applyMorphism g w) else true

lemma check_3 : decideCheck 3 = true := by native_decide

/-
Helper functions for computational verification.
-/
def isSquareFreeSuffix (w : List Alphabet) : Bool :=
  (List.range (w.length / 2)).all fun i =>
    let len := i + 1
    let u := (w.drop (w.length - 2 * len)).take len
    let v := w.drop (w.length - len)
    if u.length == v.length then
      if decide (u.Perm v) then false else true
    else true

def check_prefixes_g (current_g : List Alphabet) (next_g : List Alphabet) : Bool :=
  (List.range next_g.length).all fun i =>
    let p := next_g.take (i + 1)
    isSquareFreeSuffix (current_g ++ p)

/-
Helper functions for efficient permutation checking.
-/
def count (l : List Alphabet) (x : Alphabet) : Nat :=
  l.foldl (fun n y => if x == y then n + 1 else n) 0

def isPerm (u v : List Alphabet) : Bool :=
  count u a == count v a &&
  count u b == count v b &&
  count u c == count v c &&
  count u d == count v d

/-
Optimized computational verification functions.
-/
def count_v2 (l : List Alphabet) (x : Alphabet) : Nat :=
  l.foldl (fun n y => if x == y then n + 1 else n) 0

def isPerm_v2 (u v : List Alphabet) : Bool :=
  count_v2 u a == count_v2 v a &&
  count_v2 u b == count_v2 v b &&
  count_v2 u c == count_v2 v c &&
  count_v2 u d == count_v2 v d

def isSquareFreeSuffixBoundary (w : List Alphabet) (added_len : Nat) : Bool :=
  let min_k := added_len / 2 + 1
  let max_k := w.length / 2
  if min_k > max_k then true
  else
    (List.range (max_k - min_k + 1)).all (fun i =>
      let k := min_k + i
      let u := (w.drop (w.length - 2 * k)).take k
      let v := w.drop (w.length - k)
      not (isPerm_v2 u v))

def check_prefixes_g_optimized (current_g : List Alphabet) (next_g : List Alphabet) : Bool :=
  (List.range next_g.length).all (fun i =>
    let p := next_g.take (i + 1)
    isSquareFreeSuffixBoundary (current_g ++ p) p.length)

def dfs_check_optimized (w : List Alphabet) (g_w : List Alphabet) (depth : Nat) : Bool :=
  match depth with
  | 0 => true
  | depth + 1 =>
    [a, b, c, d].all (fun x =>
      let w_next := w ++ [x]
      if isSquareFreeSuffixBoundary w_next 1 then
        let gx := g x
        if check_prefixes_g_optimized g_w gx then
          dfs_check_optimized w_next (g_w ++ gx) depth
        else false
      else true)
termination_by depth
decreasing_by all_goals (simp_wf; try omega)

/-
Permutation check helpers.
-/
def count_v3 (l : List Alphabet) (x : Alphabet) : Nat :=
  l.foldl (fun n y => if x == y then n + 1 else n) 0

def isPerm_v3 (u v : List Alphabet) : Bool :=
  count_v3 u a == count_v3 v a &&
  count_v3 u b == count_v3 v b &&
  count_v3 u c == count_v3 v c &&
  count_v3 u d == count_v3 v d

/-
Check if suffix of length 2k is an abelian square.
-/
def checkSquareAtK (w : List Alphabet) (k : Nat) : Bool :=
  let u := (w.drop (w.length - 2 * k)).take k
  let v := w.drop (w.length - k)
  not (isPerm_v3 u v)

/-
Computational verification for length 4 (optimized).
-/
lemma check_keranen_4_v2 : dfs_check_optimized [] [] 4 = true := by native_decide

/-
Conditional proof of Keranen's theorem.
-/
theorem keranen_conditional (h : ∀ w, IsFactorFree w → w.length ≤ keranen_N → IsFactorFree (applyMorphism g w)) : IsFactorFreeMorphism g := by
  exact (factor_check_factor g).choose_spec h

/-
Assumption that the computational check holds.
-/
variable (keranen_check_assumption : ∀ w, IsFactorFree w → w.length ≤ keranen_N → IsFactorFree (applyMorphism g w))

/-
The morphism g is 85-uniform.
-/
theorem g_is_uniform : IsUniform g 85 := by
  -- Apply the lemma that states g is 85-uniform.
  apply g_uniform

/-
The limit word of the morphism g starting from a.
-/
noncomputable def g_limit : ℕ → Alphabet :=
  limitWord g a g_prolongable

/-
There exists an infinite abelian square-free word over a four-letter alphabet (constructed as the limit of g).
-/
theorem corollary_keranen (h_check : ∀ w, IsFactorFree w → w.length ≤ keranen_N → IsFactorFree (applyMorphism g w)) :
  IsFactorFreeInfinite g_limit := by
    -- By definition of `g_limit`, we know that every finite prefix of it is a prefix of some iteration of `g` on `a`.
    have h_prefix : ∀ n, (List.range n).map (limitWord g a g_prolongable) = (iterateMorphism g (n + 1) a).take n := by
      convert limit_word_prefix_eq_take_iterate using 1;
      rotate_left;
      exact Alphabet;
      exact?;
      · infer_instance;
      · constructor;
        · exact?;
        · intro h n;
          convert limitWord_prefix_eq_iterate_prefix using 1;
          rotate_left;
          exact Alphabet;
          exact?;
          constructor <;> intro h;
          · exact?;
          · convert h g a g_prolongable _ n;
            intro a; exact (by
            decide +revert);
    -- Since `g` is prolongable on `a` and `a` is factor-free (being a single letter), and `g` is factor-free (by the check and Lemma 2), by Lemma 1 (morphism preserves), the infinite word `g^omega(a)` is factor-free.
    have h_factor_free : ∀ n, IsFactorFree (iterateMorphism g n a) := by
      -- By definition of `g_limit`, we know that every finite prefix of it is a prefix of some iteration of `g` on `a`. Since `g` is abelian square-free, these prefixes are also abelian square-free. We prove this by induction on `n` using the fact that `g` is abelian square-free.
      intros n
      apply iterate_factor_free g a n (keranen_conditional h_check) (by
      exact?);
    intro n
    specialize h_prefix n
    specialize h_factor_free (n + 1);
    -- By definition of `IsFactorFree`, if `s` is a subword of `List.take n (iterateMorphism g (n + 1) a)`, then `s` is also a subword of `iterateMorphism g (n + 1) a`.
    have h_subword : ∀ s, s <:+: List.take n (iterateMorphism g (n + 1) a) → s <:+: iterateMorphism g (n + 1) a := by
      intro s hs
      obtain ⟨i, hi⟩ := hs;
      obtain ⟨ t, ht ⟩ := hi;
      use i, t ++ List.drop n (iterateMorphism g (n + 1) a);
      rw [ ← List.append_assoc, ← List.take_append_drop n ( iterateMorphism g ( n + 1 ) a ), ← ht ];
      simp +decide [ ht ];
    exact fun s hs => h_factor_free s ( h_subword s ( h_prefix ▸ hs ) )

/-
Defining computational checks for abelian square-free words over Fin 3 and evaluating existence for small lengths.
-/
def decideAbelianSquareGeneric {α : Type*} [DecidableEq α] (w : List α) : Bool :=
  w.length % 2 == 0 && w.length > 0 && decide ((w.take (w.length / 2)).Perm (w.drop (w.length / 2)))

def decideFactorFreeGeneric {α : Type*} [DecidableEq α] (w : List α) : Bool :=
  (w.tails.flatMap List.inits).all fun s => !decideAbelianSquareGeneric s

def allWordsFin3 (n : ℕ) : List (List (Fin 3)) :=
  match n with
  | 0 => [[]]
  | n + 1 => (allWordsFin3 n).flatMap fun w => [0, 1, 2].map fun x => x :: w

def existsFactorFreeFin3 (n : ℕ) : Bool :=
  (allWordsFin3 n).any decideFactorFreeGeneric

