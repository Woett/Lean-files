/-
The generic abelian square checker returns true if and only if the word is an abelian square.
-/
theorem decideAbelianSquareGeneric_iff {α : Type*} [DecidableEq α] (w : List α) :
  decideAbelianSquareGeneric w ↔ IsAbelianSquare w := by
    constructor;
    · unfold decideAbelianSquareGeneric
      intro h
      obtain ⟨k, hk⟩ : ∃ k, w.length = 2 * k ∧ k > 0 := by
        exact ⟨ w.length / 2, by linarith [ Nat.mod_add_div w.length 2, show w.length % 2 = 0 from by aesop ], Nat.div_pos ( Nat.le_of_dvd ( Nat.pos_of_ne_zero ( by aesop ) ) ( Nat.dvd_of_mod_eq_zero ( by aesop ) ) ) zero_lt_two ⟩;
      use w.take (w.length / 2), w.drop (w.length / 2);
      aesop;
    · rintro ⟨ u, v, rfl, hu, hv ⟩ ; simp +decide [ *, decideAbelianSquareGeneric ] ;
      have := hv.length_eq; simp_all +decide [ List.take_append_drop ] ;
      simp +arith +decide [ ← two_mul, List.take_append_of_le_length, List.drop_append_of_le_length, this.symm ];
      exact ⟨ List.length_pos_iff.mpr hu, hv ⟩

/-
The generic factor-free checker returns true if and only if the word is factor-free (abelian square-free).
-/
theorem decideFactorFreeGeneric_iff {α : Type*} [DecidableEq α] (w : List α) :
  decideFactorFreeGeneric w ↔ IsFactorFree w := by
    constructor <;> intro hFree;
    · -- If decideFactorFreeGeneric w is true, then for every subword s of w, s is not an abelian square.
      have h_subwords : ∀ s, s ∈ w.tails.flatMap List.inits → ¬IsAbelianSquare s := by
        -- By definition of `decideFactorFreeGeneric`, if it returns true, then for every subword s of w, s is not an abelian square.
        have h_subwords : ∀ s ∈ w.tails.flatMap List.inits, ¬decideAbelianSquareGeneric s := by
          unfold decideFactorFreeGeneric at hFree; aesop;
        exact fun s hs => fun hs' => h_subwords s hs ( decideAbelianSquareGeneric_iff s |>.2 hs' );
      exact fun s hs => h_subwords s ( mem_subwords_iff_infix w s |>.2 hs );
    · -- By definition of decideFactorFreeGeneric, we need to show that for all subwords s of w, decideAbelianSquareGeneric s is false.
      have h_subwords : ∀ s, s <:+: w → ¬decideAbelianSquareGeneric s := by
        intro s hs h; have := hFree s hs; rw [ decideAbelianSquareGeneric_iff ] at h; aesop;
      simp_all +decide [ decideFactorFreeGeneric ];
      grind

/-
The list `allWordsFin3 n` contains exactly the words of length `n` over `Fin 3`.
-/
theorem mem_allWordsFin3 (n : ℕ) (w : List (Fin 3)) :
  w ∈ allWordsFin3 n ↔ w.length = n := by
    -- We'll use induction on $n$ to prove the equivalence.
    induction' n with n ih generalizing w;
    · unfold allWordsFin3; aesop;
    · -- By definition of `allWordsFin3`, we know that `allWordsFin3 (n + 1)` is the set of all lists of length `n + 1` over `Fin 3`.
      have h_def : allWordsFin3 (n + 1) = (allWordsFin3 n).flatMap (fun w => [0, 1, 2].map (fun x => x :: w)) := by
        exact?;
      -- By definition of `allWordsFin3`, we know that `allWordsFin3 (n + 1)` is the set of all lists of length `n + 1` over `Fin 3`. Therefore, if `w` is in `allWordsFin3 (n + 1)`, then `w` must be of the form `x :: w'` where `w'` is in `allWordsFin3 n`.
      simp [h_def, ih];
      rcases w with ( _ | ⟨ x, _ | ⟨ y, w ⟩ ⟩ ) <;> simp +arith +decide;
      · grind;
      · grind

/-
If the computational check returns false, then there are no factor-free words of that length.
-/
theorem existsFactorFreeFin3_false_iff (n : ℕ) :
  existsFactorFreeFin3 n = false ↔ ∀ w : List (Fin 3), w.length = n → ¬ IsFactorFree w := by
    norm_num [ existsFactorFreeFin3 ];
    constructor;
    · intro h w hw_factor_free;
      contrapose! h;
      use w;
      rw [ mem_allWordsFin3 ];
      exact ⟨ hw_factor_free, by simpa using decideFactorFreeGeneric_iff w |>.2 h ⟩;
    · contrapose!;
      exact fun ⟨ w, hw₁, hw₂ ⟩ => ⟨ w, mem_allWordsFin3 n w |>.1 hw₁, decideFactorFreeGeneric_iff _ |>.1 ( by simpa using hw₂ ) ⟩

/-
Computationally verifying that there are no abelian square-free words of length 8 over a 3-letter alphabet.
-/
lemma check_fin3_8 : existsFactorFreeFin3 8 = false := by native_decide

/-
The four-letter alphabet is optimal: there is no infinite abelian square-free word over a three-letter alphabet.
-/
theorem optimal_4_letters : ¬ ∃ w : ℕ → Fin 3, IsFactorFreeInfinite w := by
  rintro ⟨w, hw⟩
  have h8 := hw 8
  have h_len : ((List.range 8).map w).length = 8 := by simp
  have h_contra := (existsFactorFreeFin3_false_iff 8).mp check_fin3_8 ((List.range 8).map w) h_len
  contradiction